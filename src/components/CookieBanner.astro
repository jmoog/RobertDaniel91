---
// Bandeau cookies — même principe que sur mccouverture78.fr : une carte en bas
// à gauche avec une seule mascotte, un cookie à béret et moustache.
// Accepté : il sourit grand ouvert et saute. Refusé : il fait la moue, une larme coule.
// Consentement : cookie « rd_consent » (6 mois) + Google Consent Mode v2
// (statut par défaut « refusé » posé dans BaseLayout, avant gtag config).
// Bandeau et pastille disparaissent après 800 px de défilement.
// Le lien « Gérer les cookies » du pied de page (data-ck-open) rouvre le bandeau.

const corpsCookie = `
  <circle cx="40" cy="46" r="25" fill="#e3ad62" stroke="#b9792f" stroke-width="2.5"/>
  <circle cx="66" cy="55" r="5.5" fill="#fff"/>
  <circle cx="63.5" cy="62" r="4.2" fill="#fff"/>
  <ellipse cx="23" cy="50" rx="2.6" ry="2.2" fill="#5b3a22"/>
  <ellipse cx="29" cy="64" rx="2.4" ry="2" fill="#5b3a22"/>
  <ellipse cx="45" cy="66" rx="2.2" ry="1.9" fill="#5b3a22"/>
  <ellipse cx="57" cy="45" rx="2.2" ry="2" fill="#5b3a22"/>
  <ellipse cx="53" cy="61" rx="1.8" ry="1.6" fill="#5b3a22"/>
  <g class="ck-yeux">
    <circle cx="33" cy="44" r="2.8" fill="#2f3337"/><circle cx="47" cy="44" r="2.8" fill="#2f3337"/>
    <circle cx="34" cy="43" r="1" fill="#fff"/><circle cx="48" cy="43" r="1" fill="#fff"/>
  </g>
  <ellipse cx="27.5" cy="51" rx="3.2" ry="2" fill="#f08c7c" opacity=".75"/>
  <ellipse cx="52.5" cy="51" rx="3.2" ry="2" fill="#f08c7c" opacity=".75"/>
  <path d="M40 51.5c-2.5-2.6-7.5-3.2-10.5-.2 2.2-.2 3.6.8 4.8 1.8 1.8 1.3 4 .6 5.7-1.6zm0 0c2.5-2.6 7.5-3.2 10.5-.2-2.2-.2-3.6.8-4.8 1.8-1.8 1.3-4 .6-5.7-1.6z" fill="#3b2a1e"/>
  <path class="ck-sourire" d="M35.5 57.5q4.5 3.6 9 0" fill="none" stroke="#5b3a22" stroke-width="2" stroke-linecap="round"/>
  <path class="ck-sourire-ouvert" d="M34.5 56.5q5.5 8 11 0z" fill="#5b3a22"/>
  <path class="ck-moue" d="M35.5 60.5q4.5-3.4 9 0" fill="none" stroke="#5b3a22" stroke-width="2" stroke-linecap="round"/>
  <path class="ck-larme" d="M31.5 47.5q-2.4 3.4-.8 4.8q1.6 1.1 2.6-.5q.7-1.5-1.8-4.3z" fill="#6fb7e9"/>
  <g class="ck-beret">
    <path d="M42 13.5c.2-2.6 1.4-4.4 3.4-5.4" fill="none" stroke="#00385f" stroke-width="2.6" stroke-linecap="round"/>
    <path d="M14.5 28.5c1.6-9.5 14.5-15.5 27.5-14.5 11.5.9 20 6.8 21.6 13.2.8 3.2-2.2 4.6-6.2 3.6-10-2.6-24.5-2.8-35 .4-5 1.5-8.4.4-7.9-2.7z" fill="#00497b"/>
    <circle cx="53" cy="23.5" r="4.2" fill="#e2231a"/>
  </g>`;

const mascotte = `<svg viewBox="0 0 80 80" aria-hidden="true" focusable="false">
  <ellipse cx="40" cy="75" rx="19" ry="3.2" fill="#1a1a1a" opacity=".12"/>
  <path class="ck-etincelle" d="M10 16l1.6 3.4L15 21l-3.4 1.6L10 26l-1.6-3.4L5 21l3.4-1.6z" fill="#e2231a"/>
  <path class="ck-etincelle ck-etincelle--2" d="M70 6l1.3 2.7L74 10l-2.7 1.3L70 14l-1.3-2.7L66 10l2.7-1.3z" fill="#006cb4"/>
  <path class="ck-etincelle ck-etincelle--3" d="M73 31l1.1 2.4 2.4 1.1-2.4 1.1L73 38l-1.1-2.4-2.4-1.1 2.4-1.1z" fill="#e3ad62"/>
  <g class="ck-corps">${corpsCookie}</g>
</svg>`;

const pastille = `<svg viewBox="8 6 64 66" aria-hidden="true" focusable="false">${corpsCookie}</svg>`;
---
<div class="ck" id="ck" role="dialog" aria-modal="false" aria-labelledby="ck-titre" aria-describedby="ck-texte" data-nosnippet hidden>
  <div class="ck-mascotte" set:html={mascotte} />
  <div class="ck-contenu">
    <p class="ck-titre" id="ck-titre">C'est nous, <span>les cookies&nbsp;!</span></p>
    <p class="ck-texte" id="ck-texte">
      Avec votre accord, on mesure simplement la fréquentation du site (Google Analytics) pour l'améliorer.
      Pas de pub, pas de revente.
    </p>
    <div class="ck-actions">
      <button type="button" class="ck-btn ck-btn--oui" data-ck="accept">Accepter</button>
      <button type="button" class="ck-btn ck-btn--non" data-ck="refuse">Refuser</button>
    </div>
    <p class="ck-note">
      Vous pouvez changer d'avis à tout moment via « Gérer les cookies » en bas de page.
      <a href="/mentions-legales/">En savoir plus</a>
    </p>
  </div>
</div>
<button type="button" class="ck-pastille" id="ck-pastille" aria-label="Gérer les cookies" title="Gérer les cookies" hidden set:html={pastille} />

<style is:global>
  .ck {
    display: grid; grid-template-columns: 76px minmax(0, 1fr); align-items: start; gap: 16px;
    position: fixed; left: 24px; bottom: 24px; z-index: 90;
    width: 460px; max-width: calc(100vw - 32px); box-sizing: border-box; overflow: hidden;
    padding: 24px 22px 20px; background: #fff; border-radius: 20px;
    box-shadow: 0 24px 60px rgb(26 26 26 / .24), 0 2px 6px rgb(26 26 26 / .08);
    transition: transform .45s cubic-bezier(.2, .9, .3, 1.2), opacity .3s ease;
  }
  .ck[hidden], .ck-pastille[hidden] { display: none; }
  .ck.is-entree { transform: translate3d(0, 130%, 0); opacity: 0; }
  .ck.is-sortie { transform: translate3d(0, 130%, 0); opacity: 0; }

  .ck-mascotte { width: 76px; height: 76px; transform-origin: 50% 90%; animation: ck-rebond 3.2s ease-in-out 3; }
  .ck-mascotte svg, .ck-pastille svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .ck-contenu { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .ck-titre { margin: 0; font-family: var(--font-titres); font-weight: 700; font-size: 18px; line-height: 1.3; color: var(--bleu-fonce); }
  .ck-titre span { color: var(--cuivre); }
  .ck-texte { margin: 0; color: var(--gris-700); font-size: 14px; line-height: 1.6; }
  .ck-note { margin: 0; color: var(--gris-500); font-size: 12px; line-height: 1.5; }
  .ck-note a { color: var(--bleu-fonce); text-decoration: underline; text-underline-offset: 2px; }
  .ck-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .ck-btn {
    display: inline-flex; justify-content: center; align-items: center; min-width: 118px;
    font-family: var(--font-titres); font-weight: 700; font-size: 14.5px; line-height: 1.2;
    padding: 11px 20px; border-radius: 999px; cursor: pointer;
    transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .2s ease;
  }
  .ck-btn:hover { transform: translate3d(0, -2px, 0); }
  .ck-btn--oui { color: #fff; background: var(--cuivre); border: 2px solid var(--cuivre); }
  .ck-btn--oui:hover { background: var(--cuivre-fonce); border-color: var(--cuivre-fonce); }
  .ck-btn--non { color: var(--noir); background: #fff; border: 2px solid var(--gris-200); }
  .ck-btn--non:hover { border-color: var(--noir); }
  .ck-btn:focus-visible, .ck-pastille:focus-visible { outline: 3px solid var(--bleu); outline-offset: 2px; }

  /* Expressions de la mascotte */
  .ck-mascotte .ck-yeux { transform-box: fill-box; transform-origin: center; animation: ck-cligne 4.5s infinite; }
  .ck-mascotte .ck-etincelle { transform-box: fill-box; transform-origin: center; animation: ck-scintille 2.4s ease-in-out infinite; }
  .ck-mascotte .ck-etincelle--2 { animation-delay: -.8s; }
  .ck-mascotte .ck-etincelle--3 { animation-delay: -1.6s; }
  .ck-sourire-ouvert, .ck-moue, .ck-larme { opacity: 0; }
  .ck.is-content .ck-mascotte { animation: ck-saut .7s ease-out; }
  .ck.is-content .ck-sourire { opacity: 0; }
  .ck.is-content .ck-sourire-ouvert { opacity: 1; }
  .ck.is-decu .ck-mascotte { animation: none; transform: rotate(-6deg) translateY(2px); }
  .ck.is-decu .ck-sourire { opacity: 0; }
  .ck.is-decu .ck-moue { opacity: 1; }
  .ck.is-decu .ck-larme { opacity: 1; animation: ck-larme 1s ease-in forwards; }
  .ck.is-decu .ck-etincelle { opacity: 0; }

  /* Pastille pour rouvrir le bandeau */
  .ck-pastille {
    display: flex; justify-content: center; align-items: center;
    position: fixed; left: 18px; bottom: 18px; z-index: 89;
    width: 58px; height: 58px; padding: 6px; border: 0; border-radius: 50%; background: #fff; cursor: pointer;
    box-shadow: 0 10px 26px rgb(26 26 26 / .22); transition: transform .3s ease;
  }
  .ck-pastille:hover { transform: scale(1.08) rotate(-6deg); }

  @keyframes ck-rebond { 0%, 100% { transform: translateY(0) rotate(0); } 25% { transform: translateY(-5px) rotate(-4deg); } 50% { transform: translateY(0) rotate(0); } 75% { transform: translateY(-3px) rotate(3deg); } }
  @keyframes ck-cligne { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(.1); } }
  @keyframes ck-scintille { 0%, 100% { opacity: .3; transform: scale(.7); } 50% { opacity: 1; transform: scale(1.1); } }
  @keyframes ck-saut { 0% { transform: translateY(0); } 30% { transform: translateY(-14px) rotate(-6deg); } 55% { transform: translateY(0); } 75% { transform: translateY(-6px) rotate(4deg); } 100% { transform: translateY(0); } }
  @keyframes ck-larme { from { transform: translateY(0); } to { transform: translateY(6px); } }

  /* Mobile : au-dessus de la barre « Appeler / Devis gratuit » */
  @media (max-width: 800px) {
    .ck {
      grid-template-columns: 58px minmax(0, 1fr); gap: 12px;
      left: 12px; right: 12px; width: auto; max-width: none; bottom: calc(68px + env(safe-area-inset-bottom));
      padding: 20px 16px 16px; border-radius: 18px;
    }
    .ck-mascotte { width: 58px; height: 58px; }
    .ck-titre { font-size: 16.5px; }
    .ck-texte { font-size: 13.5px; line-height: 1.55; }
    .ck-btn { min-width: 104px; font-size: 14px; padding: 10px 16px; }
    .ck-pastille { left: 12px; bottom: calc(72px + env(safe-area-inset-bottom)); width: 52px; height: 52px; }
  }
  @media (max-width: 380px) {
    .ck { grid-template-columns: 48px minmax(0, 1fr); }
    .ck-mascotte { width: 48px; height: 48px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ck, .ck *, .ck-pastille, .ck-pastille * { animation: none !important; transition: none !important; }
  }
</style>

<script>
  const NOM = 'rd_consent';
  const DUREE = 15552000; // 6 mois
  const OUVRIR = '[data-ck-open], a[href$="#cookies"]';
  const SEUIL = 800;
  const w = window as any;

  const lire = () => {
    const m = document.cookie.match(/(?:^|;\s*)rd_consent=([^;]*)/);
    if (!m) return null;
    try { return JSON.parse(decodeURIComponent(m[1])); } catch { return null; }
  };
  const ecrire = (ok: boolean) => {
    const v = encodeURIComponent(JSON.stringify({ v: 1, analytics: ok ? 1 : 0, date: new Date().toISOString() }));
    document.cookie = `${NOM}=${v};path=/;max-age=${DUREE};SameSite=Lax${location.protocol === 'https:' ? ';Secure' : ''}`;
  };
  const appliquer = (ok: boolean) => {
    if (typeof w.gtag === 'function') w.gtag('consent', 'update', { analytics_storage: ok ? 'granted' : 'denied' });
  };
  const effacerGA = () => {
    const hote = location.hostname;
    const domaines = ['', hote, '.' + hote];
    const morceaux = hote.split('.');
    if (morceaux.length > 2) domaines.push('.' + morceaux.slice(-2).join('.'));
    document.cookie.split(';').forEach((c) => {
      const n = c.split('=')[0].trim();
      if (/^(_ga|_ga_.*|_gid|_gat.*)$/.test(n)) domaines.forEach((d) => { document.cookie = `${n}=;path=/;max-age=0${d ? ';domain=' + d : ''}`; });
    });
  };

  const boite = document.getElementById('ck') as HTMLElement | null;
  const pastille = document.getElementById('ck-pastille') as HTMLElement | null;
  if (boite && pastille) {
    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let force = false, enCours = false, attente = false;
    const audela = () => (window.scrollY || document.documentElement.scrollTop || 0) >= SEUIL;

    const montrer = (parUtilisateur: boolean) => {
      boite.classList.remove('is-content', 'is-decu', 'is-sortie');
      boite.classList.add('is-entree');
      boite.hidden = false; pastille.hidden = true;
      requestAnimationFrame(() => requestAnimationFrame(() => boite.classList.remove('is-entree')));
      if (parUtilisateur) (boite.querySelector('[data-ck="accept"]') as HTMLElement | null)?.focus({ preventScroll: true });
    };
    const cacher = () => {
      boite.classList.add('is-sortie');
      setTimeout(() => { boite.hidden = true; boite.classList.remove('is-sortie'); pastille.hidden = audela(); }, reduit ? 0 : 450);
    };
    const decider = (ok: boolean) => {
      const avant = lire();
      ecrire(ok); appliquer(ok);
      if (ok) boite.classList.add('is-content');
      else {
        effacerGA(); boite.classList.add('is-decu');
        if (avant && avant.analytics) { setTimeout(() => location.reload(), reduit ? 0 : 900); return; }
      }
      setTimeout(cacher, reduit ? 0 : 900);
    };

    boite.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('[data-ck]');
      if (b) decider(b.getAttribute('data-ck') === 'accept');
    });
    pastille.addEventListener('click', () => { force = true; montrer(true); });
    document.addEventListener('click', (e) => {
      const l = (e.target as HTMLElement).closest(OUVRIR);
      if (l) { e.preventDefault(); force = true; montrer(true); }
    });

    // Bandeau et pastille disparaissent après 800 px de défilement
    window.addEventListener('scroll', () => {
      if (audela()) {
        if (!boite.hidden) {
          if (force || enCours) return;
          enCours = true; cacher();
          setTimeout(() => { enCours = false; pastille.hidden = true; }, reduit ? 10 : 500);
        } else { force = false; if (!enCours && !attente) pastille.hidden = true; }
      } else if (!enCours && !attente && boite.hidden) {
        pastille.hidden = false;
      }
    }, { passive: true });

    if (!lire()) {
      attente = true;
      setTimeout(() => { attente = false; if (audela()) pastille.hidden = true; else montrer(false); }, 600);
    } else {
      pastille.hidden = audela();
    }
  }
</script>
