---
// Bandeau CTA devis
---
<section class="cta-devis">
  <div class="conteneur cta-devis__grille">
    <img
      src="/images/chantier-robert-daniel-couverture-essonne.jpg"
      alt="Chantier de couverture Robert Daniel avec panneau de l'entreprise dans l'Essonne"
      class="cta-devis__photo"
      width="1000"
      height="750"
      loading="lazy"
      decoding="async"
    />
    <div class="cta-devis__panneau">
      <h2>Contactez votre artisan couvreur</h2>
      <p class="cta-devis__texte">
        Un projet de toiture, une fuite à réparer ou simplement une question ?
        Je vous réponds et je me déplace gratuitement à Étréchy et dans toute l'Essonne.
      </p>
      <ul>
        <li>Plus de 15 ans d'expérience.</li>
        <li>Devis gratuit sous 24h.</li>
        <li>Garantie décennale.</li>
      </ul>
      <div class="cta-devis__actions">
        <a href="tel:0683961518" class="btn btn--cuivre">
          <svg class="icone-tel" viewBox="0 0 24 24" aria-hidden="true"><g class="icone-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g><path class="icone-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path class="icone-tel__onde icone-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          06 83 96 15 18
        </a>
        <a href="/devis-gratuit/" class="btn btn--blanc">Devis gratuit <span class="btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-devis { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .cta-devis__grille {
    display: grid;
    border-radius: var(--rayon);
    overflow: hidden;
    box-shadow: var(--ombre-forte);
  }
  .cta-devis__photo {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
    object-position: center;
  }
  .cta-devis__panneau {
    background: var(--bleu);
    color: var(--blanc);
    padding: clamp(2rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    text-align: left;
    gap: 1.4rem;
  }
  .cta-devis__panneau h2 { color: var(--blanc); }
  .cta-devis__texte { max-width: 46ch; margin: 0; }
  .cta-devis__panneau ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    font-size: 1.15rem;
    text-align: left;
  }
  .cta-devis__panneau li::before {
    content: "\2022";
    color: var(--cuivre);
    font-weight: 800;
    margin-right: 0.6em;
  }
  .cta-devis__actions { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 0.9rem; }
  @media (max-width: 800px) {
    .cta-devis__actions { justify-content: center; width: 100%; }
  }
  @media (min-width: 900px) {
    .cta-devis__grille { grid-template-columns: 1fr 1fr; }
  }
</style>
