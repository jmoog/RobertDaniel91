---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilAriane from '../components/FilAriane.astro';
import villes from '../data/villes.json';
import contenu from '../data/villes-contenu.json';
import CartesRealisations from './CartesRealisations.astro';
import AvisGoogle from './AvisGoogle.astro';
import NoteGoogle from './NoteGoogle.astro';
import realisations from '../data/realisations.json';
import proches from '../data/realisations-villes.json';
import distances from '../data/villes-distance-etrechy.json';

const { slug } = Astro.props;
const d = contenu[slug];
const autresVilles = villes.filter((v) => v.slug !== slug);
const chantiers = proches[slug] || [];
const rang = villes.findIndex((v) => v.slug === slug);
// Nom de l'artisan / de l'entreprise sous le H1, en alternance d'une commune à l'autre
const nomH1 = rang % 2 === 0 ? 'Robert Daniel' : 'Robert Daniel Couverture';
// Lien vers Étréchy (bureau) seulement depuis les communes voisines, ancres variées
const ancresEtrechy = ['artisan couvreur à Étréchy', 'couvreur à Étréchy', 'couvreur zingueur à Étréchy', 'spécialiste de la toiture à Étréchy'];
const ancreEtrechy = ancresEtrechy[rang % ancresEtrechy.length];
const km = distances[slug];
const deVille = /^[AEIOUYÉÈÊÂÎÔÛaeiouyéèêâîôû]/.test(d.nom) ? `d'${d.nom}` : `de ${d.nom}`;
const nbIci = realisations.filter((r) => r.pageVille === `/${slug}/`).length;
const titreChantiers = nbIci >= chantiers.length && nbIci > 0
  ? `Mes chantiers à ${d.nom}`
  : nbIci > 0 ? `Mes chantiers à ${d.nom} et aux alentours` : `Mes chantiers près de ${d.nom}`;

const services = [
  { href: '/renovation-toiture/', label: 'Rénovation de toiture', img: '/images/services/renovation-toiture.webp', desc: 'Réfection partielle ou complète de votre toit.' },
  { href: '/reparation-toiture/', label: 'Réparation de toiture', img: '/images/services/reparation-toiture.webp', desc: 'Recherche de fuite et reprise des tuiles.' },
  { href: '/nettoyage-toiture/', label: 'Nettoyage de toiture', img: '/images/services/nettoyage-toiture.webp', desc: 'Démoussage et traitement de la couverture.' },
  { href: '/zinguerie/', label: 'Zinguerie', img: '/images/services/zinguerie.webp', desc: 'Gouttières, descentes, noues et solins.' },
  { href: '/charpente/', label: 'Charpente', img: '/images/services/charpente.webp', desc: 'Traitement, réparation et remplacement du bois.' },
  { href: '/isolation-toiture/', label: 'Isolation de toiture', img: '/images/services/isolation-toiture.webp', desc: 'Isolation des combles et de la sous-toiture.' },
  { href: '/fenetre-de-toit-velux/', label: 'Fenêtre de toit Velux', img: '/images/services/velux.webp', desc: 'Pose et remplacement de fenêtres de toit.' },
  { href: '/ramonage-cheminee/', label: 'Ramonage de cheminée', img: '/images/ramonage-cheminee-essonne.webp', desc: 'Ramonage mécanique du conduit, certificat de ramonage fourni.' },
  { href: '/inspection-toiture-drone/', label: 'Inspection par drone', img: '/images/inspection-toiture-drone-village-essonne.webp', desc: "État de votre toiture, images à l'appui." },
];

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `https://robert-daniel-couverture.fr/${slug}/#service`,
  name: `Couvreur à ${d.nom}`,
  serviceType: 'Travaux de couverture',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  areaServed: { '@type': 'City', name: d.nom, address: { '@type': 'PostalAddress', postalCode: d.cp } },
  url: `https://robert-daniel-couverture.fr/${slug}/`,
  description: d.metaDescription,
}];
---
<BaseLayout title={d.title} description={d.metaDescription} extraSchemas={extraSchemas}>
  <section class="hero">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: `Couvreur à ${d.nom}` }]} />
    </div>
    <div class="conteneur hero__grille">
      <div class="hero__texte">
        <p class="hero__badge"><span class="hero__point" aria-hidden="true"></span> {d.badge}</p>
        <h1>{d.h1}<span class="h1__nom">{nomH1}</span></h1>
        <p class="hero__accroche" set:html={d.accroche} />
        <ul>
          {d.bullets.map((b) => (
            <li><strong>{b.t}</strong> {b.r}</li>
          ))}
        </ul>
        <div class="hero__actions">
          <a href="tel:0683961518" class="btn btn--cuivre">
            <svg class="icone-tel" viewBox="0 0 24 24" aria-hidden="true"><g class="icone-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g><path class="icone-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path class="icone-tel__onde icone-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            06 83 96 15 18
          </a>
          <a href="/devis-gratuit/" class="btn btn--bleu">Devis gratuit <span class="btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
        </div>
        <NoteGoogle />
      </div>
      <div class="hero__media">
        <img class="hero__photo" src={d.heroImg.src} alt={d.heroImg.alt} width={d.heroImg.w} height={d.heroImg.h} fetchpriority="high" decoding="async" />
        <div class="carte hero__garantie">
          <p><strong>Garantie Décennale</strong><br />Pour tous travaux de couverture</p>
          <img src="/images/logo-allianz.png" alt="Garantie décennale assurée par Allianz" width="92" height="58" loading="lazy" decoding="async" />
        </div>
        {!d.adresse && km && (
          <div class="carte hero__garantie">
            <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="width:1.8rem;height:1.8rem;flex-shrink:0;color:var(--cuivre);"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z"/></svg>
            {km <= 5
              ? <p><strong>{d.nom} : à {km} km de mon bureau</strong><br />Je travaille depuis la Grande Rue, comme <a href="/couvreur-etrechy/">{ancreEtrechy}</a> et dans les villages voisins.</p>
              : <p><strong>Mon bureau : 42 Grande Rue, Étréchy</strong><br />À {km} km {deVille}.</p>}
          </div>
        )}
        {d.adresse && (
          <div class="carte hero__garantie">
            <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="width:1.8rem;height:1.8rem;flex-shrink:0;color:var(--cuivre);"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z"/></svg>
            <p><strong>Mon showroom à Étréchy</strong><br />{d.adresse}</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Avis clients -->
  <AvisGoogle titre={d.avisTitre} ids={d.avisIds} fond="gris" />

  <!-- Services -->
  <section class="section">
    <div class="conteneur">
      <h2>{d.servicesTitre}</h2>
      <p class="section__intro">{d.servicesIntro}</p>
      <div class="grille-services">
        {services.map((s) => (
          <a href={s.href} class="carte carte-service">
            <img class="carte-service__img" src={s.img} alt={`${s.label} à ${d.nom} dans l'Essonne`} width="700" height="438" loading="lazy" decoding="async" />
            <div class="carte-service__corps">
              <h3>{s.label}</h3>
              <p>{s.desc}</p>
              <span class="carte-service__lien">En savoir plus &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CartesRealisations slugs={chantiers} titre={titreChantiers} fond="gris" />

  {d.editorial && (
    <section class="section">
      <div class="conteneur ville-editorial">
        <div class="prose">
          <h2>{d.editorial.h2}</h2>
          <Fragment set:html={d.editorial.html} />
        </div>
        {d.mairie && (
          <aside class="mairie" aria-label={d.mairie.nom}>
            <p class="mairie__titre">{d.mairie.nom}</p>
            <p>{d.mairie.adresse}</p>
            <p>
              <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.36 11.36 0 003.58.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/></svg>
              {d.mairie.tel}
            </p>
            <p><a href={d.mairie.site} target="_blank" rel="noopener">Site officiel de la mairie</a></p>
          </aside>
        )}
      </div>
    </section>
  )}

  {d.showroom && (
    <section class="section section--gris">
      <div class="conteneur duo">
        <img src="/images/robert-daniel-artisan-couvreur-etrechy.webp" alt="Robert Daniel devant son bureau et showroom d'artisan couvreur, 42 Grande Rue à Étréchy" width="900" height="1200" loading="lazy" decoding="async" class="showroom__photo" />
        <div class="prose">
          <h2>Mon bureau et showroom, 42 Grande Rue</h2>
          <p>
            Au cœur d'Étréchy, mon bureau vous accueille pour parler de votre toiture, de vos gouttières
            ou de votre projet de rénovation. Vous y trouvez les réponses à vos questions et vous repartez
            avec un conseil clair, avant même le devis.
          </p>
          <p><strong>42 Grande Rue, 91580 Étréchy</strong><br />Du lundi au samedi, de 8 h à 20 h</p>
          <p><a href="https://maps.app.goo.gl/rYpVbKYbBB64Uk2y6" target="_blank" rel="noopener" class="btn btn--bleu">Voir l'itinéraire <span class="btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p>
        </div>
      </div>
    </section>
  )}

  <!-- CTA ville -->
  <section class="section section--bleu cta-final">
    <div class="conteneur" style="text-align:center;">
      <h2>{d.ctaTitre}</h2>
      <p style="max-width:62ch;margin:0.8rem auto 1.6rem;">{d.ctaTexte}</p>
      <div class="hero__actions" style="justify-content:center;">
        <a href="tel:0683961518" class="btn btn--cuivre">
          <svg class="icone-tel" viewBox="0 0 24 24" aria-hidden="true"><g class="icone-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g><path class="icone-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path class="icone-tel__onde icone-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          06 83 96 15 18
        </a>
        <a href="/devis-gratuit/" class="btn btn--bleu">Devis gratuit <span class="btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
      </div>
    </div>
  </section>

  <!-- Autres communes -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2>J'interviens aussi dans ces communes</h2>
      <ul class="nuage-villes">
        {autresVilles.map((v) => (
          <li><a href={`/${v.slug}/`}>{v.nom}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .h1__nom { display: block; margin-top: 0.15em; color: var(--cuivre); font-size: 0.82em; }
  .ville-editorial { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) { .ville-editorial { grid-template-columns: minmax(0, 1fr) 300px; gap: 4rem; } }
  .ville-editorial .prose h2 { margin-top: 0; }
  .mairie { background: var(--gris-50); border: 1px solid var(--gris-200); border-radius: var(--rayon); padding: 1.5rem 1.6rem; }
  .mairie p { margin: 0.35rem 0; color: var(--gris-700); }
  .mairie__titre { font-family: var(--font-titres); font-weight: 700; color: var(--bleu) !important; font-size: 1.1rem; }
  .showroom__photo { max-height: 560px; object-position: center 40%; }
  .section__intro { max-width: 70ch; margin: 0.4rem 0 0.5rem; color: var(--gris-700); }
</style>
