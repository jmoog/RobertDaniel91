---
// ════════════════════════════════════════════════════════════════════
// GABARIT DES PAGES COMMUNES (refonte 13 oct. 2026) — design et structure
// repris de la page /couvreur-etrechy/ : héro, présentation, prestations,
// CTA, avis, drone, ramonage, démarches en mairie, réalisations.
// Tout le contenu (balises, textes, photos, mairie) est dans
// src/data/villes-contenu.json. Aucune mention du bureau d'Étréchy ici.
// ════════════════════════════════════════════════════════════════════
import BaseLayout from '../layouts/BaseLayout.astro';
import FilAriane from './FilAriane.astro';
import CartesRealisations from './CartesRealisations.astro';
import AvisGoogle from './AvisGoogle.astro';
import NoteGoogle from './NoteGoogle.astro';
import villes from '../data/villes.json';
import contenu from '../data/villes-contenu.json';
import realisations from '../data/realisations.json';
import proches from '../data/realisations-villes.json';

const { slug } = Astro.props;
const d = (contenu as any)[slug];
const SITE = 'https://robert-daniel-couverture.fr';
const PAGE = `${SITE}/${slug}/`;

// Réalisations : chantiers de la commune d'abord, sinon les plus proches
const slugsChantiers: string[] = (proches as any)[slug] || [];
const nbIci = realisations.filter((r) => r.pageVille === `/${slug}/`).length;
const titreChantiers = nbIci >= slugsChantiers.length && nbIci > 0
  ? `Mes chantiers à ${d.nom}`
  : nbIci > 0 ? `Mes chantiers à ${d.nom} et aux alentours` : `Mes chantiers près de ${d.nom}`;

const telLien = (t: string) => `tel:${t.replace(/\s/g, '')}`;
const heroSrcset = d.hero.src800 ? `${d.hero.src800} 800w, ${d.hero.src} ${d.hero.w}w` : undefined;
const chantiers = slugsChantiers.map((s) => realisations.find((x) => x.slug === s)).filter(Boolean) as any[];

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${PAGE}#webpage`,
  url: PAGE,
  name: d.title,
  description: d.metaDescription.replace(/^✓\s*/, ''),
  inLanguage: 'fr-FR',
  dateModified: '2026-10-13',
  isPartOf: { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'Robert Daniel Couverture' },
  about: { '@id': `${PAGE}#service` },
  breadcrumb: { '@id': `${PAGE}#breadcrumb` },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${SITE}${d.hero.src}`, width: d.hero.w, height: d.hero.h },
  ...(chantiers.length ? { relatedLink: chantiers.map((c) => `${SITE}${c.url}`) } : {}),
}, {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${PAGE}#service`,
  name: `Couvreur à ${d.nom}`,
  serviceType: 'Travaux de couverture',
  url: PAGE,
  description: d.metaDescription.replace(/^✓\s*/, ''),
  provider: { '@id': `${SITE}/#localbusiness` },
  areaServed: {
    '@type': 'City', name: d.nom,
    address: { '@type': 'PostalAddress', postalCode: d.cp, addressLocality: d.nom, addressCountry: 'FR' },
    containedInPlace: { '@type': 'AdministrativeArea', name: 'Essonne' },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog', name: `Travaux de couverture à ${d.nom}`,
    itemListElement: [...d.prestations.map((p: any) => p.titre), 'Vérification de toiture par drone', 'Ramonage de cheminée', 'Charpente']
      .map((n: string) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n, areaServed: d.nom } })),
  },
}];

const fleche = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---
<BaseLayout title={d.title} description={d.metaDescription} ogImage={d.hero.src} extraSchemas={extraSchemas}>

  <!-- ══ HERO ══ -->
  <section class="dr-hero">
    <div class="conteneur et-ariane">
      <FilAriane id={`${PAGE}#breadcrumb`} items={[{ label: 'Accueil', href: '/' }, { label: `Couvreur à ${d.nom}` }]} />
    </div>
    <div class="conteneur dr-hero__grille">
      <div class="dr-hero__titrebox">
        <h1 class="dr-hero__titre" style={`--h1em:${d.h1em}`}>
          <span class="dr-ligne">{d.h1}</span>
          <span class="dr-ligne dr-hero__nom">{d.nomH1}</span>
        </h1>
      </div>

      <figure class="dr-hero__media">
        <img class="dr-media__poster" src={d.hero.src} srcset={heroSrcset} sizes="(min-width: 1024px) 50vw, 100vw" alt={d.hero.alt} width={d.hero.w} height={d.hero.h} fetchpriority="high" decoding="async" style={`object-position:${d.hero.pos}`} />
      </figure>

      <div class="dr-hero__texte">
        <p class="dr-hero__lead" set:html={d.lead} />
        <ul class="dr-coches">
          {d.coches.map((c: string) => <li>{c}</li>)}
        </ul>
        <div class="dr-actions">
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Devis gratuit
            <span class="dr-btn__fleche" aria-hidden="true" set:html={fleche} />
          </a>
          <a href="tel:0683961518" class="dr-btn dr-btn--blanc">
            <svg class="dr-tel" viewBox="0 0 24 24" aria-hidden="true">
              <g class="dr-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g>
              <path class="dr-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path class="dr-tel__onde dr-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            06 83 96 15 18
          </a>
        </div>
        <NoteGoogle variante="sombre" />
      </div>
    </div>
  </section>

  <!-- ══ PRÉSENTATION : L'ARTISAN DANS LA COMMUNE ══ -->
  <section class="dr-section">
    <div class="conteneur pv-pres">
      <div class="pv-pres__texte" data-anim="up">
        <h2 class="dr-h2 pv-fit" style={`--em:${d.em.intro}`}>{d.intro.h2}</h2>
        <ul class="et-coord">
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
            <span><strong>{d.intro.zone}</strong></span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
            <span>Du lundi au samedi, de 8 h à 20 h</span>
          </li>
        </ul>
        {d.intro.paragraphes.map((p: string) => <p set:html={p} />)}
      </div>
      <div class="pv-pres__media" data-anim="fade">
        <img src={d.intro.img.src} alt={d.intro.img.alt} width={d.intro.img.w} height={d.intro.img.h} loading="lazy" decoding="async" style={`object-position:${d.intro.img.pos}`} />
      </div>
    </div>
  </section>

  <!-- ══ PRESTATIONS ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <h2 class="dr-h2 dr-centre pv-fit" style={`--em:${d.em.prestations}`} data-anim="up">{d.prestationsH2}</h2>
      <div class="dr-cartes">
        {d.prestations.map((s: any) => (
          <article class="dr-carte" data-anim="up">
            <img src={s.img} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" style={`object-position:${s.pos}`} />
            <div class="dr-carte__corps">
              <h3>{s.titre}</h3>
              <p set:html={s.html} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ CTA (orientation alternée d'une commune à l'autre) ══ -->
  <section class="dr-section dr-section--cta">
    <div class="conteneur">
      <div class:list={['dr-cta', { 'dr-cta--inverse': d.cta.inverse }]} data-anim="up">
        <figure class="dr-cta__media">
          <img src={d.cta.img.src} alt={d.cta.img.alt} width={d.cta.img.w} height={d.cta.img.h} loading="lazy" decoding="async" />
        </figure>
        <div class="dr-cta__corps">
          <h2 style={`--em:${d.em.cta}`}>{d.cta.h2}</h2>
          <p>{d.cta.texte}</p>
          <div class="dr-actions">
            <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
              Devis gratuit
              <span class="dr-btn__fleche" aria-hidden="true" set:html={fleche} />
            </a>
            <a href="tel:0683961518" class="dr-btn dr-btn--blanc">
              <svg class="dr-tel" viewBox="0 0 24 24" aria-hidden="true">
                <g class="dr-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g>
                <path class="dr-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <path class="dr-tel__onde dr-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              06 83 96 15 18
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ AVIS ══ -->
  <AvisGoogle titre={d.avis.titre} ids={d.avis.ids} fond="blanc" />

  <!-- ══ VÉRIFICATION DE TOITURE PAR DRONE ══ -->
  <section class="dr-section dr-section--drone">
    <div class="conteneur">
      <article class="dr-drone" data-anim="up">
        <figure class="dr-drone__media">
          <img class="dr-media__poster" src={d.drone.img.src} alt={d.drone.img.alt} width={d.drone.img.w} height={d.drone.img.h} loading="lazy" decoding="async" style={`object-position:${d.drone.img.pos}`} />
        </figure>
        <div class="dr-drone__corps">
          <h2 style={`--em:${d.em.drone}`}>{d.drone.h2}</h2>
          <p>{d.drone.p1}</p>
          <p set:html={d.drone.p2} />
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            {d.drone.bouton}
            <span class="dr-btn__fleche" aria-hidden="true" set:html={fleche} />
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ RAMONAGE ══ -->
  <section class="dr-section dr-section--ramonage">
    <div class="conteneur">
      <article class="dr-ramonage" data-anim="up">
        <div class="dr-ramonage__corps">
          <h2 style={`--em:${d.em.ramonage}`}>{d.ramonage.h2}</h2>
          <p set:html={d.ramonage.p1} />
          <p>{d.ramonage.p2}</p>
        </div>
        <figure class="dr-ramonage__media">
          <img src={d.ramonage.img.src} alt={d.ramonage.img.alt} width={d.ramonage.img.w} height={d.ramonage.img.h} loading="lazy" decoding="async" style={`object-position:${d.ramonage.img.pos}`} />
        </figure>
      </article>
    </div>
  </section>

  <!-- ══ DÉMARCHES EN MAIRIE ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <h2 class="dr-h2 dr-centre pv-fit" style={`--em:${d.em.mairie}`} data-anim="up">{d.mairie.h2}</h2>
      <div class="et-urba">
        <div class="et-urba__texte" data-anim="up">
          <p>{d.mairie.intro}</p>
          <ul class="et-cas">
            {d.mairie.cas.map((c: any) => (
              <li class="et-cas__carte">
                <h3>{c.titre}</h3>
                <p>{c.texte}</p>
              </li>
            ))}
          </ul>
          <p>{d.mairie.fin}</p>
          <p>{d.mairie.aide}</p>
        </div>
        <aside class="et-mairie" data-anim="up" aria-label={d.mairie.encart.nom}>
          <p class="et-mairie__titre">{d.mairie.encart.nom}</p>
          <p class="et-mairie__ligne">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
            <span>{d.mairie.encart.adresse1}<br />{d.mairie.encart.adresse2}</span>
          </p>
          {d.mairie.encart.tel && (
            <p class="et-mairie__ligne">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.36 11.36 0 003.58.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/></svg>
              <span>Accueil : <a href={telLien(d.mairie.encart.tel)}>{d.mairie.encart.tel}</a></span>
            </p>
          )}
          {d.mairie.encart.telUrba && (
            <p class="et-mairie__ligne">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.36 11.36 0 003.58.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/></svg>
              <span>Urbanisme : <a href={telLien(d.mairie.encart.telUrba)}>{d.mairie.encart.telUrba}</a></span>
            </p>
          )}
          <a class="dr-btn dr-btn--bleu" href={d.mairie.encart.site} target="_blank" rel="noopener">
            Site de la mairie
            <span class="dr-btn__fleche dr-btn__fleche--bleue" aria-hidden="true" set:html={fleche} />
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- ══ RÉALISATIONS (fin de page) ══ -->
  <CartesRealisations slugs={slugsChantiers} titre={d.realisationsTitre || titreChantiers} titreStyle={`--em:${d.em.realisations}`} intro={d.realisationsIntro} />
</BaseLayout>

<script>
  // Animations d'apparition (désactivées si l'utilisateur réduit les animations)
  const els = document.querySelectorAll('[data-anim]');
  if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    els.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  /* ════ Styles repris de la page d'accueil (préfixe dr-) ════ */
  .dr-hero, .dr-section {
    --nuit: #062a45;
    --rouge-clair: #ff4d42;
    --ombre-carte: 0 6px 20px rgb(0 73 123 / .07);
    --ombre-carte-hover: 0 16px 34px rgb(0 73 123 / .15);
    --ligne: #e2e6ea;
  }
  [data-anim] { opacity: 0; transition: opacity .7s ease, transform .7s ease; }
  [data-anim="up"] { transform: translate3d(0, 28px, 0); }
  [data-anim].is-visible { opacity: 1; transform: none; }

  .dr-section { padding-block: 88px; }
  .dr-section--gris { background: var(--gris-50); }
  @media (max-width: 1023px) { .dr-section { padding-block: 64px; } }
  @media (max-width: 767px)  { .dr-section { padding-block: 52px; } }
  .dr-centre { text-align: center; }
  /* Titres H2 : jamais plus de deux lignes. --em = largeur du titre mesurée en Lexend 700 ;
     la taille est plafonnée à 2 × largeur disponible / largeur du texte (marge 15 % pour les retours à la ligne). */
  .dr-section > .conteneur, .pv-pres__texte, .dr-cta__corps, .dr-drone__corps, .dr-ramonage__corps { container-type: inline-size; }
  :global(.realisations-bloc > .conteneur) { container-type: inline-size; }
  :global(.realisations-bloc h2[style]) { font-size: min(clamp(1.5rem, 3vw, 2.1rem), calc(200cqi / (var(--em, 20) * 1.25))); }
  .dr-h2 {
    font-family: var(--font-titres); font-weight: 700; color: var(--bleu-fonce);
    font-size: clamp(19px, .6rem + 2.6vw, 36px); line-height: 1.2; text-wrap: balance; margin: 0;
  }
  .dr-h2.pv-fit { font-size: min(clamp(19px, .6rem + 2.6vw, 36px), calc(200cqi / (var(--em, 20) * 1.25))); }

  /* Boutons (pilule, jamais pleine largeur) */
  .dr-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .dr-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 12px;
    width: auto; max-width: max-content; min-height: 50px; padding: 14px 26px;
    border-radius: 999px; font-family: var(--font-titres); font-weight: 700; font-size: 16px;
    line-height: 1.2; text-decoration: none; white-space: nowrap;
    box-shadow: 0 4px 12px rgb(0 42 69 / .12);
    transition: background-color .25s ease, color .25s ease, transform .25s ease, box-shadow .25s ease;
  }
  .dr-btn:hover { transform: translate3d(0, -2px, 0); box-shadow: 0 10px 22px rgb(0 42 69 / .2); }
  .dr-btn--rouge { background: var(--cuivre); color: #fff; }
  .dr-btn--rouge:hover { background: var(--cuivre-fonce); color: #fff; }
  .dr-btn--bleu { background: var(--bleu); color: #fff; }
  .dr-btn--bleu:hover { background: var(--bleu-fonce); color: #fff; }
  .dr-btn--blanc { background: #fff; color: var(--bleu-fonce); }
  .dr-btn--blanc:hover { background: var(--gris-100); color: var(--bleu-fonce); }
  .dr-btn__fleche {
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
    width: 26px; height: 26px; border-radius: 50%; background: #fff; color: var(--cuivre); overflow: hidden;
  }
  .dr-btn__fleche--bleue { color: var(--bleu); }
  .dr-btn__fleche svg { width: 14px; height: 14px; transition: transform .3s ease; }
  .dr-btn:hover .dr-btn__fleche svg { transform: translate3d(3px, 0, 0); }
  @media (max-width: 767px) {
    .dr-btn { min-height: 46px; padding: 12px 18px; font-size: 15px; gap: 10px; }
  }

  /* Smartphone qui sonne */
  .dr-tel { width: 20px; height: 20px; flex-shrink: 0; overflow: visible; }
  .dr-tel__corps { transform-origin: 40% 50%; animation: dr-sonne 2.4s ease-in-out infinite; }
  .dr-tel__onde { opacity: 0; animation: dr-onde 2.4s ease-out infinite; }
  .dr-tel__onde--2 { animation-delay: .25s; }
  @keyframes dr-sonne {
    0%, 70%, 100% { transform: rotate(0); }
    75% { transform: rotate(-12deg); } 80% { transform: rotate(10deg); }
    85% { transform: rotate(-8deg); } 90% { transform: rotate(6deg); }
  }
  @keyframes dr-onde { 0%, 60% { opacity: 0; } 75% { opacity: 1; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .dr-tel__corps, .dr-tel__onde { animation: none; }
    .dr-tel__onde { opacity: 1; }
    [data-anim] { opacity: 1; transform: none; transition: none; }
  }

  /* Hero */
  .dr-hero { background: var(--nuit); padding-block: 28px 56px; overflow: hidden; }
  .et-ariane :global(.fil-ariane) { margin-bottom: 20px; color: #9fb6ca; }
  .et-ariane :global(.fil-ariane a) { color: #9fb6ca; }
  .et-ariane :global(.fil-ariane a:hover) { color: #fff; }
  .et-ariane :global(.fil-ariane [aria-current]) { color: #fff; }
  .dr-hero__grille {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: "titre media" "texte media"; align-items: center; gap: 22px 52px;
  }
  .dr-hero__titrebox { grid-area: titre; align-self: end; min-width: 0; container-type: inline-size; }
  /* Taille calculée sur la largeur réelle de la ligne la plus longue (--h1em, mesurée en Lexend 700) :
     chaque ligne tient toujours sur une seule ligne, sans débordement ni mot orphelin. */
  .dr-hero__titre {
    margin: 0; color: #fff;
    font-family: var(--font-titres); font-weight: 700;
    font-size: min(40px, calc(100cqi / var(--h1em, 14))); line-height: 1.15;
  }
  .dr-ligne { display: block; white-space: nowrap; }
  .dr-hero__nom { color: var(--rouge-clair); }
  .dr-hero__media {
    grid-area: media; margin: 0; border-radius: 16px; overflow: hidden; position: relative;
    box-shadow: 0 20px 50px rgb(0 0 0 / .3); aspect-ratio: 3 / 2;
  }
  .dr-media__poster { display: block; width: 100%; height: 100%; object-fit: cover; }
  .dr-hero__texte { grid-area: texte; align-self: start; display: flex; flex-direction: column; gap: 22px; }
