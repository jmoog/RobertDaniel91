---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import CookieBanner from '../components/CookieBanner.astro';
import villes from '../data/villes.json';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  extraSchemas?: object[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/logo-robert-daniel.png',
  extraSchemas = [],
  noindex = false,
} = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="RZ91L_09GryLedIG7CbNh3i1aDNpvRKLSQLN3C7A_44" />

    <!-- Google tag (gtag.js) + Consent Mode v2 : mesure d'audience refusée par défaut,
         accordée seulement si le visiteur a accepté (cookie rd_consent posé par le bandeau). -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', functionality_storage: 'granted', security_storage: 'granted', wait_for_update: 500 });
      gtag('set', 'ads_data_redaction', true);
      (function () {
        var m = document.cookie.match(/(?:^|;\s*)rd_consent=([^;]*)/);
        if (!m) return;
        try { var c = JSON.parse(decodeURIComponent(m[1])); if (c && c.analytics) gtag('consent', 'update', { analytics_storage: 'granted' }); } catch (e) {}
      })();
      gtag('js', new Date());
      gtag('config', 'G-V457V2WS4D');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-V457V2WS4D" is:inline></script>

    <link rel="icon" href="/favicon.ico?v=5" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=5" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=5" />

    <link rel="preload" href="/fonts/lexend-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/red-hat-display-400.woff2" as="font" type="font/woff2" crossorigin />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Robert Daniel Couverture — Artisan couvreur dans l'Essonne" />

    <!-- Donnees structurees RoofingContractor -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "RoofingContractor",
      "@id": "https://robert-daniel-couverture.fr/#localbusiness",
      "name": "Robert Daniel Couverture",
      "legalName": "SAS MR ROBERT",
      "alternateName": ["Robert Daniel", "MR ROBERT"],
      "description": "Entreprise de couverture artisanale dans l'Essonne (91) : rénovation, réparation et démoussage de toiture, zinguerie, isolation, pose de fenêtres de toit Velux, ramonage et vérification de toiture par drone. Garantie décennale.",
      "image": [
        "https://robert-daniel-couverture.fr/images/hero-renovation-toiture-etrechy.jpg",
        "https://robert-daniel-couverture.fr/images/logo-robert-daniel.png"
      ],
      "logo": { "@type": "ImageObject", "url": "https://robert-daniel-couverture.fr/images/logo-robert-daniel.png", "width": 1024, "height": 512, "caption": "Logo Robert Daniel Couverture, artisan couvreur dans l'Essonne" },
      "url": "https://robert-daniel-couverture.fr/",
      "telephone": "+33683961518",
      "email": "robert.entreprise@outlook.fr",
      "founder": { "@type": "Person", "name": "Robert Daniel", "jobTitle": "Président" },
      "priceRange": "€€",
      "currenciesAccepted": "EUR",
      "paymentAccepted": "Espèces, Chèque, Virement bancaire",
      "taxID": "FR69937889236",
      "isicV4": "4391",
      "naics": "238160",
      "address": { "@type": "PostalAddress", "streetAddress": "42 Grande Rue", "postalCode": "91580", "addressLocality": "Étréchy", "addressRegion": "Île-de-France", "addressCountry": "FR" },
      "geo": { "@type": "GeoCoordinates", "latitude": 48.4929035, "longitude": 2.1912066 },
      "hasMap": "https://maps.google.com/?cid=15045529930066125536",
      "sameAs": ["https://maps.google.com/?cid=15045529930066125536"],
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Essonne" },
        ...villes.map((v) => ({ "@type": "City", "name": v.nom, "postalCode": v.codePostal }))
      ],
      "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"], "opens": "08:00", "closes": "20:00" }
      ],
      "hasOfferCatalog": { "@type": "OfferCatalog", "name": "Services de couverture", "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Rénovation de toiture" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Remplacement de toiture" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Réparation de toiture" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Nettoyage et démoussage de toiture" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Charpente" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Isolation de toiture" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Pose de fenêtres de toit Velux" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Zinguerie et gouttières" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Inspection de toiture par drone" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ramonage de cheminée" } }
      ]},
      "knowsAbout": ["Couverture", "Zinguerie", "Charpente", "Rénovation de toiture", "Remplacement de toiture", "Réparation de toiture", "Nettoyage de toiture", "Isolation de toiture", "Pose de fenêtres de toit Velux", "Inspection de toiture par drone", "Ramonage de cheminée", "Gouttières"]
    })} />

    {extraSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingContact />
    <CookieBanner />
    <!-- Images différées : on lance le téléchargement ~1000 px avant qu'elles arrivent à l'écran
         (Safari iOS attend sinon le dernier moment, d'où un affichage tardif avec les fondus). -->
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.loading = 'eager'; io.unobserve(e.target); }
          });
        }, { rootMargin: '1000px 0px' });
        document.querySelectorAll('img[loading="lazy"]').forEach(function (img) { io.observe(img); });
      })();
    </script>
  </body>
</html>
