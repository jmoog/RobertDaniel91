---
// Page pilier « Charpente » — refonte oct. 2026 au design de la page Ramonage
// (gabarit PageService). Centrée sur l'Essonne.
import PageService from '../components/PageService.astro';

const url = 'https://robert-daniel-couverture.fr/charpente/';
const title = "Travaux de charpente dans l'Essonne (91) – Robert Daniel";
const description = "Charpente dans l'Essonne (91) : traitement contre insectes et champignons, remplacement de pièces, charpente neuve. Robert Daniel, couvreur charpentier.";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Travaux de charpente',
  serviceType: 'Traitement, réparation et création de charpente bois',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url,
  image: 'https://robert-daniel-couverture.fr/images/charpente-bois-fermes-essonne.jpg',
  description,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations de charpente',
    itemListElement: [
      'Traitement de charpente contre les insectes et les champignons',
      'Remplacement de chevrons, pannes et pièces de charpente',
      'Renforcement des assemblages',
      'Création de charpente bois neuve',
    ].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
  },
}];

const interventions = [
  { titre: 'Traitement curatif et préventif', texte: "Bûchage des parties mortes, puis traitement par pulvérisation et injection au cœur du bois contre les insectes et les champignons." },
  { titre: 'Remplacement de pièces', texte: "Chevron, panne, arbalétrier ou entrait trop atteints : je les remplace à l'identique pour garder l'aspect d'origine de la charpente." },
  { titre: 'Renforcement', texte: "Reprise des assemblages affaiblis et doublage des pièces qui fléchissent, pour redonner sa rigidité à l'ossature." },
  { titre: 'Charpente neuve', texte: "Extension, surélévation ou toiture entièrement refaite : je dimensionne et je monte une charpente bois adaptée à la couverture prévue." },
];

const etapes = [
  { titre: "L'examen de l'ossature", texte: "Depuis les combles, je contrôle les pannes, les chevrons, les fermes et les assemblages pour repérer les bois atteints." },
  { titre: 'La cause du désordre', texte: "Je cherche ce qui abîme le bois : une fuite, une ventilation insuffisante ou une attaque d'insectes ancienne." },
  { titre: 'Les travaux', texte: "Je traite le bois qui peut être conservé, je remplace les pièces trop dégradées et je renforce l'ensemble." },
  { titre: 'La toiture protégée', texte: "Une charpente saine accueille ensuite la couverture et l'<a href=\"/isolation-toiture/\">isolation des combles</a> sans reprise." },
];
---
<PageService
  title={title}
  description={description}
  extraSchemas={extraSchemas}
  ariane={[{ label: 'Accueil', href: '/' }, { label: 'Charpente' }]}
  h1="Charpente bois 91 –"
  hero={{ src: '/images/charpente-bois-fermes-essonne.webp', alt: "Fermes de charpente bois neuves levées à la grue sur une maison de l'Essonne", width: 1200, height: 900 }}
  lead="Le <strong>traitement et la rénovation de votre charpente bois dans l'Essonne</strong> par un couvreur charpentier, qui travaille aussi la couverture."
  coches={['Traitement insectes et champignons', 'Remplacement des pièces atteintes', 'Devis gratuit et sans engagement']}
  bande={['Traitement de charpente', 'Remplacement de pièces', 'Renforcement', 'Charpente neuve']}
  artisan={{
    titre: 'Un couvreur charpentier pour votre toiture',
    html: `<p>Depuis plus de 15 ans, je travaille le bois de charpente et la couverture dans l'Essonne. Confier les deux au même artisan évite les zones de doute entre deux corps de métier : je traite la cause d'une charpente humide et le bois qu'elle a abîmé.</p>
<p>Je vous montre les pièces atteintes, je vous explique ce qui peut être conservé et ce qui doit être remplacé, puis je vous remets un devis qui détaille chaque intervention.</p>`,
  }}
  avis={{ titre: 'Ce que mes clients disent de mon travail', ids: ['guytounet-breizh', 'marc-viandon', 'july'] }}
  cta={{ titre: "Faites contrôler votre charpente dans l'Essonne" }}
>

  <!-- ══ L'OSSATURE ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-duo dr-duo--seul" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/charpente-chevrons-renovation-essonne.webp" alt="Chevrons neufs posés sur une charpente en rénovation dans l'Essonne" width="1200" height="900" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h2 class="dr-h2">La charpente, l'ossature de votre toiture</h2>
          <p>La charpente porte la couverture, l'isolant et le poids de la neige. Une charpente saine garde sa forme pendant des décennies, mais le bois peut souffrir : une infiltration le fait pourrir, des insectes le creusent, un champignon le ramollit.</p>
          <p>Quand une pièce faiblit, toute la toiture s'en ressent. Les tuiles bougent, le faîtage ondule et les fuites apparaissent. Un contrôle à temps évite que le désordre ne gagne l'ensemble de l'ossature.</p>
          <p>Comme <a href="/">couvreur 91</a>, je contrôle la charpente à chaque intervention importante sur une toiture : c'est la garantie d'une couverture qui reste droite et étanche.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ TRAITEMENT (carte bleu nuit) ══ -->
  <section class="dr-section dr-section--serre">
    <div class="conteneur">
      <article class="dr-regle" data-anim="up">
        <div class="dr-regle__corps">
          <h2>Traitement de charpente : insectes et champignons</h2>
          <p>Capricornes, vrillettes, mérule ou pourriture : j'identifie d'abord ce qui attaque le bois, car le traitement n'est pas le même. Les parties mortes sont bûchées, puis le bois est traité en surface et en profondeur.</p>
          <p>Un traitement n'a de sens que si le bois reste sec. Pour une charpente humide, je commence par la <a href="/reparation-toiture/">réparation de la couverture</a> qui laisse passer l'eau, puis je traite. Appliqué dans les règles, un traitement protège le bois pendant une dizaine d'années.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Faire contrôler ma charpente
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
        <div class="dr-regle__certif">
          <h3>Les signes qui doivent alerter</h3>
          <ul class="dr-coches dr-coches--sombre">
            <li>De la sciure fine au pied des bois</li>
            <li>Des trous ou des galeries en surface</li>
            <li>Un bois sombre, ramolli ou qui sent l'humidité</li>
            <li>Un toit qui ondule ou une panne qui se courbe</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ INTERVENTIONS ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Mes interventions sur charpente</h2>
        <p>Tout le bois n'est pas à changer : je conserve ce qui est sain et je remplace ce qui ne l'est plus.</p>
      </div>
      <ul class="dr-equip">
        {interventions.map((i) => (
          <li class="dr-equip__carte" data-anim="up">
            <h3>{i.titre}</h3>
            <p>{i.texte}</p>
          </li>
        ))}
      </ul>

      <div class="dr-duo dr-duo--inverse dr-methode" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/charpente-robert-daniel-chevrons-essonne.webp" alt="Robert Daniel, couvreur charpentier, devant des chevrons neufs dans l'Essonne" width="1200" height="900" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h3 class="dr-h3">Une charpente neuve pour une toiture refaite</h3>
          <p>Lors d'une <a href="/renovation-toiture/">réfection complète de la toiture</a>, la couverture déposée laisse la charpente à nu : c'est le meilleur moment pour la contrôler, remplacer les chevrons fatigués ou la reprendre entièrement.</p>
          <p>Pour une extension ou une surélévation, je dimensionne la nouvelle charpente selon la portée et le poids de la couverture prévue, puis je la monte en m'assurant de son aplomb et de sa ventilation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ ÉTAPES ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Comment se déroule une intervention</h2>
        <p>Je traite toujours la cause avant le symptôme.</p>
      </div>
      <ol class="dr-etapes">
        {etapes.map((e) => (
          <li class="dr-etape" data-anim="up">
            <h3>{e.titre}</h3>
            <p set:html={e.texte} />
          </li>
        ))}
      </ol>
    </div>
  </section>
</PageService>
