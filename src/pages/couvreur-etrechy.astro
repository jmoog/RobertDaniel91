---
// ════════════════════════════════════════════════════════════════════
// PAGE MÈRE DU COCON « COUVREUR À ÉTRÉCHY » (refonte 13 oct. 2026,
// brief Notion « Rédaction de la page Étréchy »). Design repris de la
// nouvelle page d'accueil. Ancienne version archivée dans
// _archives/couvreur-etrechy-avant-refonte-2026-10-13.astro
// Cocon : les liens sortants restent dans le périmètre Étréchy
// (pages services avec ancres « … à Étréchy », réalisations d'Étréchy).
// ════════════════════════════════════════════════════════════════════
import BaseLayout from '../layouts/BaseLayout.astro';
import FilAriane from '../components/FilAriane.astro';
import CartesRealisations from '../components/CartesRealisations.astro';
import realisations from '../data/realisations.json';

import AvisGoogle from '../components/AvisGoogle.astro';
import NoteGoogle from '../components/NoteGoogle.astro';
const title = "Artisan couvreur à Étréchy - Devis gratuit - Robert Daniel";
const description = "✓ Tous travaux de couverture à Étréchy : remplacement de toiture ancienne, recherche de fuite, interventions en urgence. Robert Daniel, tél. 06 83 96 15 18";

const prestations = [
  {
    titre: 'Démoussage et nettoyage de toiture',
    img: '/images/etrechy/demoussage-toiture-etrechy.webp', w: 600, h: 800, pos: 'center 25%',
    alt: "Traitement d'une toiture après démoussage sur une maison d'Étréchy",
    html: `Mousses, lichens et salissures retiennent l'humidité et finissent par abîmer les tuiles. Je nettoie votre couverture sans l'endommager, je dégage les gouttières, puis j'applique un traitement qui empêche les végétaux de revenir. Un <a href="/nettoyage-toiture/">démoussage de toiture</a> régulier prolonge la durée de vie de votre toit.`,
  },
  {
    titre: 'Rénovation de toiture',
    img: '/images/realisations/renovation-toiture-etrechy/renovation-toiture-etrechy-05-800w.webp', w: 800, h: 600, pos: 'center',
    alt: "Pose de tuiles neuves lors d'une rénovation de toiture à Étréchy",
    html: `Votre toiture est ancienne et les réparations ne suffisent plus ? Je la remplace entièrement : dépose de l'ancienne couverture, contrôle de la charpente, pose de l'écran sous-toiture, des liteaux et des tuiles neuves. La <a href="/renovation-toiture/">rénovation de votre toiture</a> respecte le caractère de la maison, en tuiles plates, en tuiles mécaniques ou en ardoises.`,
  },
  {
    titre: 'Réparation de toiture',
    img: '/images/realisations/refection-faitage-etrechy/refection-faitage-etrechy-03-800w.webp', w: 600, h: 800, pos: 'center 45%',
    alt: "Faîtage en cours de réfection sur une toiture en tuiles à Étréchy",
    html: `Une tuile cassée, un faîtage descellé, un solin fissuré ou une tache au plafond ? J'interviens rapidement : je recherche l'origine de l'infiltration, puis j'effectue la <a href="/reparation-toiture/">réparation de la toiture</a> qui règle le problème durablement.`,
  },
  {
    titre: 'Pose de fenêtres de toit Velux',
    img: '/images/fenetre-de-toit-velux-pose-essonne.webp', w: 825, h: 1100, pos: 'center 40%',
    alt: "Fenêtre de toit Velux posée dans une couverture en ardoises",
    html: `Vous souhaitez aménager vos combles ? Une fenêtre de toit apporte la lumière naturelle et renouvelle l'air de la pièce. J'installe vos <a href="/fenetre-de-toit-velux/">fenêtres de toit Velux</a> avec les raccords d'étanchéité adaptés à votre couverture.`,
  },
  {
    titre: 'Pose et remplacement de gouttières',
    img: '/images/zinguerie-gouttiere-zinc-anthracite-essonne.webp', w: 1100, h: 825, pos: 'center',
    alt: "Gouttière en zinc anthracite posée en rive de toiture par Robert Daniel",
    html: `Gouttières, descentes, noues et solins conduisent l'eau de pluie loin de vos murs et de vos fondations. J'assure la pose et le remplacement de gouttières en zinc, en aluminium ou en PVC, ainsi que l'entretien de toute la <a href="/zinguerie/">zinguerie de votre maison</a>.`,
  },
  {
    titre: 'Isolation de toiture',
    img: '/images/services/isolation-toiture.webp', w: 700, h: 438, pos: 'center',
    alt: "Pose d'un isolant et d'un écran sous toiture",
    html: `Une toiture mal isolée laisse s'échapper une grande partie de la chaleur de la maison. J'installe des isolants performants et des écrans sous toiture, par sarking ou par isolation soufflée selon votre charpente. Une <a href="/isolation-toiture/">isolation de toiture</a> bien faite réduit vos dépenses de chauffage et garde la maison fraîche en été.`,
  },
];

const lienWaze = 'https://waze.com/ul?ll=48.4929035%2C2.1912066&navigate=yes';
const lienMaps = 'https://maps.google.com/?cid=15045529930066125536';

const autorisations = [
  { titre: "La pose d'une fenêtre de toit", texte: "Créer une ouverture dans la couverture modifie l'aspect de votre toiture : la pose d'un Velux demande une déclaration préalable de travaux." },
  { titre: 'La modification de la toiture', texte: "Changer la forme ou la pente du toit, créer un chien-assis ou surélever la maison : selon la surface créée, il faut une déclaration préalable ou un permis de construire." },
  { titre: 'Le changement de couleur ou de matériau', texte: "Passer de la tuile mécanique à la tuile plate, ou changer la teinte de la couverture, demande une déclaration préalable. Le PLU peut imposer certaines teintes." },
];

const SITE = 'https://robert-daniel-couverture.fr';
const PAGE = `${SITE}/couvreur-etrechy/`;
const slugsChantiers = ['renovation-toiture-etrechy', 'fenetre-de-toit-etrechy', 'refection-faitage-etrechy'];
const chantiers = slugsChantiers.map((s) => realisations.find((x) => x.slug === s)).filter(Boolean) as any[];
const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${PAGE}#webpage`,
  url: PAGE,
  name: 'Couvreur à Étréchy – Robert Daniel',
  description: description.replace(/^✓\s*/, '').replace(/\s*Robert Daniel.*$/, '').trim(),
  inLanguage: 'fr-FR',
  dateModified: '2026-10-13',
  isPartOf: { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'Robert Daniel Couverture' },
  about: { '@id': `${PAGE}#service` },
  breadcrumb: { '@id': `${PAGE}#breadcrumb` },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${SITE}/images/realisations/renovation-toiture-etrechy/renovation-toiture-etrechy-08.webp`, width: 1600, height: 1200 },
  // Pages enfants du cocon : les chantiers réalisés à Étréchy
  hasPart: chantiers.map((c) => ({ '@type': 'WebPage', '@id': `${SITE}${c.url}#webpage`, url: `${SITE}${c.url}`, name: c.h1 })),
};
const extraSchemas = [webPage, {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://robert-daniel-couverture.fr/couvreur-etrechy/#service',
  name: 'Couvreur à Étréchy',
  serviceType: 'Travaux de couverture',
  url: 'https://robert-daniel-couverture.fr/couvreur-etrechy/',
  description: "Tous travaux de couverture, zinguerie, charpente et isolation à Étréchy (91580) par Robert Daniel, artisan couvreur installé 42 Grande Rue : démoussage, rénovation et réparation de toiture, pose de Velux, gouttières, vérification par drone et ramonage.",
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  areaServed: {
    '@type': 'City', name: 'Étréchy',
    sameAs: 'https://fr.wikipedia.org/wiki/%C3%89tr%C3%A9chy_(Essonne)',
    address: { '@type': 'PostalAddress', postalCode: '91580', addressLocality: 'Étréchy', addressCountry: 'FR' },
    containedInPlace: { '@type': 'AdministrativeArea', name: 'Essonne' },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog', name: 'Travaux de couverture à Étréchy',
    itemListElement: ['Démoussage et nettoyage de toiture', 'Rénovation et remplacement de toiture', 'Réparation de toiture', 'Pose de fenêtres de toit Velux', 'Pose et remplacement de gouttières', 'Isolation de toiture', 'Vérification de toiture par drone', 'Ramonage de cheminée']
      .map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n, areaServed: 'Étréchy' } })),
  },
}];
---
<BaseLayout title={title} description={description} ogImage="/images/realisations/renovation-toiture-etrechy/renovation-toiture-etrechy-08.webp" extraSchemas={extraSchemas}>

  <!-- ══ HERO ══ -->
  <section class="dr-hero">
    <div class="conteneur et-ariane">
      <FilAriane id={`${PAGE}#breadcrumb`} items={[{ label: 'Accueil', href: '/' }, { label: 'Couvreur à Étréchy' }]} />
    </div>
    <div class="conteneur dr-hero__grille">
      <h1 class="dr-hero__titre">
        <span class="dr-ligne">Couvreur à Étréchy</span>
        <span class="dr-ligne dr-hero__nom">Robert Daniel</span>
      </h1>

      <figure class="dr-hero__media">
        <img class="dr-media__poster" src="/images/realisations/renovation-toiture-etrechy/renovation-toiture-etrechy-08.webp" srcset="/images/realisations/renovation-toiture-etrechy/renovation-toiture-etrechy-08-800w.webp 800w, /images/realisations/renovation-toiture-etrechy/renovation-toiture-etrechy-08.webp 1600w" sizes="(min-width: 1024px) 50vw, 100vw" alt="Pavillon d'Étréchy avec sa toiture refaite à neuf par Robert Daniel" width="1600" height="1200" fetchpriority="high" decoding="async" />
      </figure>

      <div class="dr-hero__texte">
        <p class="dr-hero__lead">Votre <strong>artisan couvreur à Étréchy</strong> pour tous travaux de couverture, zinguerie, charpente et isolation :</p>
        <ul class="dr-coches">
          <li>Garantie décennale</li>
          <li>Devis gratuit et sans engagement</li>
          <li>15 années d'expérience</li>
          <li>Interventions en urgence</li>
        </ul>
        <div class="dr-actions">
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Devis gratuit
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
          <a href="tel:0683961518" class="dr-btn dr-btn--blanc">
            <svg class="dr-tel" viewBox="0 0 24 24" aria-hidden="true">
              <g class="dr-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g>
              <path class="dr-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path class="dr-tel__onde dr-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            06 83 96 15 18
          </a>
        </div>
        <NoteGoogle variante="sombre" />
      </div>
    </div>
  </section>

  <!-- ══ LE BUREAU D'ÉTRÉCHY ══ -->
  <section class="dr-section">
    <div class="conteneur et-bureau">
      <div class="et-bureau__texte" data-anim="up">
        <h2 class="dr-h2">Votre artisan couvreur à Étréchy</h2>
        <ul class="et-coord">
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
            <span><strong>42 Grande Rue, 91580 Étréchy</strong></span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
            <span>Du lundi au samedi, de 8 h à 20 h</span>
          </li>
        </ul>
        <p>Grâce à mon sérieux, à mon professionnalisme et à mon savoir-faire, j'ai bâti une solide réputation de professionnel de la toiture à Étréchy.</p>
        <p>Je vous accueille dans mes locaux de la Grande Rue si vous souhaitez vous renseigner sur mes services. N'hésitez pas à me contacter si vous rencontrez un problème avec votre toiture.</p>
      </div>
      <div class="et-bureau__media" data-anim="fade">
        <img src="/images/enseigne-robert-daniel-couvreur-etrechy.webp" alt="Vitrine du bureau de Robert Daniel, artisan couvreur, 42 Grande Rue à Étréchy" width="1200" height="675" loading="lazy" decoding="async" />
        <div class="et-apps">
          <a class="et-app" href={lienWaze} target="_blank" rel="noopener" aria-label="Itinéraire vers le bureau avec Waze">
            <span class="et-app__icone et-app__icone--waze" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="#fff" d="M13.218 0C9.915 0 6.835 1.49 4.723 4.148c-1.515 1.913-2.31 4.272-2.31 6.706v1.739c0 .894-.62 1.738-1.862 1.813-.298.025-.547.224-.547.522-.05.82.82 2.31 2.012 3.502.82.844 1.788 1.515 2.832 2.036a3 3 0 0 0 2.955 3.528 2.966 2.966 0 0 0 2.931-2.385h2.509c.323 1.689 2.086 2.856 3.974 2.21 1.64-.546 2.36-2.409 1.763-3.924a12.84 12.84 0 0 0 1.838-1.465 10.73 10.73 0 0 0 3.18-7.65c0-2.882-1.118-5.589-3.155-7.625A10.899 10.899 0 0 0 13.218 0zm0 1.217c2.558 0 4.967.994 6.78 2.807a9.525 9.525 0 0 1 2.807 6.78A9.526 9.526 0 0 1 20 17.585a9.647 9.647 0 0 1-6.78 2.807h-2.46a3.008 3.008 0 0 0-2.93-2.41 3.03 3.03 0 0 0-2.534 1.367v.024a8.945 8.945 0 0 1-2.41-1.788c-.844-.844-1.316-1.614-1.515-2.11a2.858 2.858 0 0 0 1.441-.846 2.959 2.959 0 0 0 .795-2.036v-1.789c0-2.11.696-4.197 2.012-5.861 1.863-2.385 4.62-3.726 7.6-3.726zm-2.41 5.986a1.192 1.192 0 0 0-1.191 1.192 1.192 1.192 0 0 0 1.192 1.193A1.192 1.192 0 0 0 12 8.395a1.192 1.192 0 0 0-1.192-1.192zm7.204 0a1.192 1.192 0 0 0-1.192 1.192 1.192 1.192 0 0 0 1.192 1.193 1.192 1.192 0 0 0 1.192-1.193 1.192 1.192 0 0 0-1.192-1.192zm-7.377 4.769a.596.596 0 0 0-.546.845 4.813 4.813 0 0 0 4.346 2.757 4.77 4.77 0 0 0 4.347-2.757.596.596 0 0 0-.547-.845h-.025a.561.561 0 0 0-.521.348 3.59 3.59 0 0 1-3.254 2.061 3.591 3.591 0 0 1-3.254-2.061.64.64 0 0 0-.546-.348z"/></svg></span>
            Waze
          </a>
          <a class="et-app" href={lienMaps} target="_blank" rel="noopener" aria-label="Voir le bureau sur Google Maps">
            <span class="et-app__icone et-app__icone--maps" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="#4285F4" d="M19.527 4.799c1.212 2.608.937 5.678-.405 8.173-1.101 2.047-2.744 3.74-4.098 5.614-.619.858-1.244 1.75-1.669 2.727-.141.325-.263.658-.383.992-.121.333-.224.673-.34 1.008-.109.314-.236.684-.627.687h-.007c-.466-.001-.579-.53-.695-.887-.284-.874-.581-1.713-1.019-2.525-.51-.944-1.145-1.817-1.79-2.671L19.527 4.799z"/>
<path fill="#34A853" d="M8.545 7.705l-3.959 4.707c.724 1.54 1.821 2.863 2.871 4.18.247.31.494.622.737.936l4.984-5.925-.029.01c-1.741.601-3.691-.291-4.392-1.987a3.377 3.377 0 0 1-.209-.716c-.063-.437-.077-.761-.004-1.198l.001-.007z"/>
<path fill="#FBBC04" d="M5.492 3.149l-.003.004c-1.947 2.466-2.281 5.88-1.117 8.77l4.785-5.689-.058-.05-3.607-3.035z"/>
<path fill="#EA4335" d="M14.661.436l-3.838 4.563a.295.295 0 0 1 .027-.01c1.6-.551 3.403.15 4.22 1.626.176.319.323.683.377 1.045.068.446.085.773.012 1.22l-.003.016 3.836-4.561A8.382 8.382 0 0 0 14.67.439l-.009-.003z"/>
<path fill="#1A73E8" d="M9.466 5.868L14.162.285l-.047-.012A8.31 8.31 0 0 0 11.986 0a8.439 8.439 0 0 0-6.169 2.766l-.016.018 3.665 3.084z"/></svg></span>
            Google Maps
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ PRESTATIONS ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <h2 class="dr-h2 dr-centre" data-anim="up">Mes prestations de couvreur à Étréchy</h2>
      <div class="dr-cartes">
        {prestations.map((s) => (
          <article class="dr-carte" data-anim="up">
            <img src={s.img} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" style={`object-position:${s.pos}`} />
            <div class="dr-carte__corps">
              <h3>{s.titre}</h3>
              <p set:html={s.html} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ CTA (véhicules) ══ -->
  <section class="dr-section dr-section--cta">
    <div class="conteneur">
      <div class="dr-cta" data-anim="up">
        <figure class="dr-cta__media">
          <img src="/images/vehicules-robert-daniel-couverture-essonne.webp" alt="Les camions de Robert Daniel, couvreur à Étréchy" width="900" height="600" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-cta__corps">
          <h2>Faites appel à votre couvreur à Étréchy</h2>
          <p>Le devis est gratuit et sans engagement.</p>
          <div class="dr-actions">
            <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
              Devis gratuit
              <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </a>
            <a href="tel:0683961518" class="dr-btn dr-btn--blanc">
              <svg class="dr-tel" viewBox="0 0 24 24" aria-hidden="true">
                <g class="dr-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g>
                <path class="dr-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <path class="dr-tel__onde dr-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              06 83 96 15 18
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ AVIS ══ -->
  <AvisGoogle titre="Les avis de mes clients" ids={['nadege-fernandez', 'michel-s', 'zazounette', 'roselyne', 'lindsay-cochin', 'olivier-loret']} fond="blanc" />

  <!-- ══ VÉRIFICATION DE TOITURE PAR DRONE ══ -->
  <section class="dr-section dr-section--drone">
    <div class="conteneur">
      <article class="dr-drone" data-anim="up">
        <figure class="dr-drone__media">
          <img class="dr-media__poster" src="/images/robert-daniel-drone-verification-etrechy.webp" alt="Robert Daniel avec son drone d'inspection devant son bureau d'Étréchy" width="1000" height="880" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-drone__corps">
          <h2>Vérification de toiture par drone à Étréchy</h2>
          <p>Vous voulez connaître l'état de votre toiture avant l'hiver, après une tempête ou avant d'acheter une maison ? Le drone survole votre toit et filme chaque pan de la couverture : tuiles, faîtage, solins, gouttières et souche de cheminée.</p>
          <p>Vous suivez les images en direct, et vous recevez ensuite les photos en haute définition. La <a href="/inspection-toiture-drone/">vérification de toiture par drone</a> vous indique si des travaux sont nécessaires, et lesquels.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Faire vérifier ma toiture
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ RAMONAGE ══ -->
  <section class="dr-section dr-section--ramonage">
    <div class="conteneur">
      <article class="dr-ramonage" data-anim="up">
        <div class="dr-ramonage__corps">
          <h2>Ramonage de cheminée à Étréchy</h2>
          <p>Un conduit encrassé chauffe mal et augmente le risque de feu de cheminée et d'intoxication au monoxyde de carbone. Je réalise le <a href="/ramonage-cheminee/">ramonage des cheminées</a>, des poêles et des inserts, mécaniquement, au hérisson, puis je vous remets le certificat que votre assureur peut vous demander.</p>
          <p>Couvreur, je vérifie en même temps l'état de la souche et du solin, là où le conduit traverse votre toiture.</p>
        </div>
        <figure class="dr-ramonage__media">
          <img src="/images/ramonage-souche-cheminee-essonne.webp" alt="Souche de cheminée et son solin sur une toiture en tuiles" width="900" height="1200" loading="lazy" decoding="async" />
        </figure>
      </article>
    </div>
  </section>

  <!-- ══ AUTORISATIONS DE LA MAIRIE ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
