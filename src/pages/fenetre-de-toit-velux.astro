---
// Page pilier « Fenêtre de toit Velux » — refonte oct. 2026 au design de la
// page Ramonage (gabarit PageService). Centrée sur l'Essonne.
import PageService from '../components/PageService.astro';
import CartesRealisations from '../components/CartesRealisations.astro';

const url = 'https://robert-daniel-couverture.fr/fenetre-de-toit-velux/';
const title = "Fenêtre de toit Velux dans l'Essonne (91) – Robert Daniel";
const description = "Pose et remplacement de fenêtres de toit Velux dans l'Essonne (91), raccord d'étanchéité adapté à vos tuiles ou ardoises. Robert Daniel, artisan couvreur.";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Pose de fenêtre de toit Velux',
  serviceType: 'Pose et remplacement de fenêtres de toit',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url,
  image: 'https://robert-daniel-couverture.fr/images/fenetre-de-toit-velux-couvreur-essonne.jpg',
  description,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations fenêtres de toit',
    itemListElement: [
      'Pose de fenêtre de toit neuve',
      'Remplacement de fenêtre de toit',
      "Réfection du raccord d'étanchéité d'une fenêtre de toit",
    ].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
  },
}];

const prestations = [
  { titre: 'Pose neuve', texte: "Je crée l'ouverture dans la couverture, je pose le chevêtre qui renforce la <a href=\"/charpente/\">charpente</a> autour du cadre, puis j'installe la fenêtre et son raccord." },
  { titre: 'Remplacement', texte: "Je dépose l'ancien modèle et je pose la nouvelle fenêtre, souvent à la même dimension, pour limiter les reprises de couverture." },
  { titre: 'Fenêtre qui fuit', texte: "Une fuite vient presque toujours d'un raccord vieilli ou d'un joint usé : je refais le raccord plutôt que de poser un mastic qui ne tiendra pas." },
];
---
<PageService
  title={title}
  description={description}
  extraSchemas={extraSchemas}
  ariane={[{ label: 'Accueil', href: '/' }, { label: 'Fenêtre de toit Velux' }]}
  h1="Fenêtre de toit Velux 91 –"
  hero={{ src: '/images/fenetre-de-toit-velux-couvreur-essonne.webp', alt: "Robert Daniel, artisan couvreur, devant une fenêtre de toit posée dans une couverture en tuiles", width: 1100, height: 825 }}
  lead="La <strong>pose de fenêtres de toit Velux dans l'Essonne</strong>, avec un raccord étanche à votre couverture réalisé par un couvreur."
  coches={['Pose neuve et remplacement', "Raccord d'étanchéité adapté à vos tuiles", 'Devis gratuit et sans engagement']}
  bande={['Pose neuve', 'Remplacement', "Raccord d'étanchéité", 'Combles aménagés']}
  artisan={{
    titre: 'La pose par un couvreur, pas par un menuisier',
    html: `<p>Depuis plus de 15 ans, je pose des fenêtres de toit dans les toitures de l'Essonne, en tuile plate, en tuile mécanique et en ardoise. Je connais chaque raccord d'étanchéité et la façon de reprendre la couverture autour du cadre.</p>
<p>Une fenêtre de toit posée par un couvreur s'intègre à la toiture comme un élément de couverture. C'est ce qui fait la différence entre une pose qui dure et une infiltration au premier orage. Comme <a href="/">entreprise de couverture 91</a>, je garantis la toiture autour de la fenêtre.</p>`,
  }}
  avis={{ titre: 'Ils ont fait poser leurs fenêtres de toit', ids: ['levy-sabas', 'peysi-sabas', 'louise-b'] }}
  cta={{ titre: "Faites poser votre fenêtre de toit dans l'Essonne" }}
>

  <!-- ══ LUMIÈRE ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-duo dr-duo--seul" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/fenetre-de-toit-velux-pose-chevetre-essonne.webp" alt="Ouverture créée dans la couverture et chevêtre posé avant l'installation d'une fenêtre de toit" width="825" height="1100" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h2 class="dr-h2">Plus de lumière sous votre toit</h2>
          <p>Une fenêtre de toit apporte bien plus de lumière qu'une fenêtre verticale de même taille. Elle rend un grenier habitable, éclaire un couloir aveugle ou ventile une salle de bains sous la pente.</p>
          <p>Encore faut-il choisir le bon emplacement et la bonne dimension. Je vous conseille selon la pente du toit, l'orientation de la pièce et son usage, pour une fenêtre qui éclaire sans surchauffer la pièce l'été.</p>
          <p>Si vos combles ne sont pas encore aménagés, nous prévoyons ensemble l'<a href="/isolation-toiture/">isolation des combles</a>, pour que la nouvelle pièce soit aussi confortable que lumineuse.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ RACCORD (carte bleu nuit) ══ -->
  <section class="dr-section dr-section--serre">
    <div class="conteneur">
      <article class="dr-regle" data-anim="up">
        <div class="dr-regle__corps">
          <h2>Un raccord étanche, le vrai enjeu de la pose</h2>
          <p>La fenêtre elle-même est rarement en cause dans une fuite. Le point sensible, c'est la jonction entre le châssis et la couverture : c'est là que l'eau s'infiltre quand la pose est mal faite.</p>
          <p>J'utilise le raccord prévu pour votre matériau de couverture, je reprends les tuiles ou les ardoises tout autour et je raccorde l'écran sous-toiture au cadre. L'eau qui descend le toit contourne la fenêtre sans jamais trouver de passage.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Demander mon devis
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
        <div class="dr-regle__certif">
          <h3>Une pose dans les règles</h3>
          <ul class="dr-coches dr-coches--sombre">
            <li>Raccord adapté à la tuile ou à l'ardoise</li>
            <li>Couverture reprise autour du cadre</li>
            <li>Écran sous-toiture raccordé</li>
            <li>Toiture refermée le jour même</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ PRESTATIONS ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Pose, remplacement et réparation</h2>
        <p>Pour une pièce à éclairer ou une fenêtre fatiguée, je règle l'ensemble, de la charpente à la couverture.</p>
      </div>
      <ul class="dr-equip">
        {prestations.map((p) => (
          <li class="dr-equip__carte" data-anim="up">
            <h3>{p.titre}</h3>
            <p set:html={p.texte} />
          </li>
        ))}
      </ul>

      <div class="dr-duo dr-duo--inverse dr-methode" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/fenetre-de-toit-velux-ecran-essonne.webp" alt="Fenêtre de toit installée avec son raccord et l'écran sous-toiture avant la reprise des tuiles" width="825" height="1100" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h3 class="dr-h3">Comment se passe la pose</h3>
          <p>Je viens voir la pièce et la toiture, je vous conseille le modèle et l'emplacement, puis je vous remets un devis détaillé.</p>
          <p>Le jour de la pose, je protège l'intérieur, je crée l'ouverture, j'installe la fenêtre et son raccord, puis je reprends la couverture. La maison est hors d'eau le soir même. Les finitions intérieures de l'habillage sont réalisées sur demande.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ GALERIE ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Des fenêtres de toit posées dans l'Essonne</h2>
        <p>Dans des couvertures en tuiles plates comme en tuiles mécaniques.</p>
      </div>
      <ul class="dr-galerie" data-anim="up">
        <li><figure><img src="/images/fenetre-de-toit-velux-tuiles-essonne.webp" alt="Fenêtre de toit intégrée à une couverture en tuiles mécaniques" width="825" height="1100" loading="lazy" decoding="async" /><figcaption>Fenêtre intégrée à la couverture</figcaption></figure></li>
        <li><figure><img src="/images/fenetre-de-toit-velux-pose-essonne.webp" alt="Fenêtre de toit posée dans une couverture en tuiles plates" width="825" height="1100" loading="lazy" decoding="async" /><figcaption>Pose dans des tuiles plates</figcaption></figure></li>
        <li><figure><img src="/images/fenetre-de-toit-velux-essonne-2.webp" alt="Fenêtre de toit terminée avec sa couverture reprise autour du cadre" width="825" height="1100" loading="lazy" decoding="async" /><figcaption>Fenêtre de toit terminée</figcaption></figure></li>
      </ul>
    </div>
  </section>

  <!-- ══ CONSEILS ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Bon à savoir avant de vous lancer</h2>
      </div>
      <div class="dr-conseils">
        <article class="dr-conseil" data-anim="up">
          <h3>Les démarches en mairie</h3>
          <ul class="dr-puces">
            <li>La création d'une fenêtre de toit modifie l'aspect extérieur de la maison.</li>
            <li>Une déclaration préalable de travaux est en général demandée.</li>
            <li>Le service urbanisme de votre mairie vous indique les règles du plan local d'urbanisme.</li>
          </ul>
        </article>
        <article class="dr-conseil" data-anim="up">
          <h3>L'entretien de la fenêtre</h3>
          <ul class="dr-puces">
            <li>Nettoyez régulièrement la vitre et le joint d'étanchéité.</li>
            <li>Dégagez les feuilles autour du cadre pour que l'eau ne stagne pas.</li>
            <li>En cas de condensation anormale ou de manœuvre difficile, faites contrôler la fenêtre.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ══ RÉALISATION ══ -->
  <CartesRealisations
    slugs={['fenetre-de-toit-etrechy']}
    titre="Une pose de fenêtre de toit en images"
    intro="Une fenêtre de toit posée dans une couverture en tuiles plates, de l'ouverture à la finition."
    fond="blanc"
    centre
    lienTout={false}
  />
</PageService>
