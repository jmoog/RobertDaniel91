---
// ════════════════════════════════════════════════════════════════════
// PAGE D'ACCUEIL (refonte oct. 2026, brief Notion « rédaction de la nouvelle
// page Home »). Design inspiré de entrepot-du-matelas.fr, adapté à la charte
// Robert Daniel. Accueil centré sur l'Essonne uniquement (« dans l'Essonne »,
// jamais « en Essonne ») pour ne plus concurrencer /couvreur-etrechy/.
// Ancienne version archivée dans _archives/index-avant-refonte-2026-10-12.astro
// ════════════════════════════════════════════════════════════════════
import BaseLayout from '../layouts/BaseLayout.astro';
import CartesRealisations from '../components/CartesRealisations.astro';
import villes from '../data/villes.json';

import AvisGoogle from '../components/AvisGoogle.astro';
import NoteGoogle from '../components/NoteGoogle.astro';
const title = "Robert Daniel Couverture – Couvreur 91";
const description = "✓ Entreprise de couverture artisanale dans l'Essonne : Robert Daniel Couverture, 15 années d'expérience, devis gratuit, garantie décennale. 06 83 96 15 18";

const savoirFaire = [
  {
    titre: 'Tous travaux de couverture',
    img: '/images/services/renovation-toiture.webp',
    alt: "Rénovation complète d'une toiture en tuiles sur une maison de l'Essonne",
    html: `Rénovation complète de toiture, pose de toiture neuve, réfection de toiture : j'interviens sur tous les types de toitures, en tuiles, en ardoises ou en zinc. Vous souhaitez refaire votre toiture dans l'Essonne ? Je suis le spécialiste de la <a href="/renovation-toiture/">rénovation de toiture</a> dans l'Essonne.`,
  },
  {
    titre: 'Démoussage et nettoyage de toiture',
    img: '/images/services/nettoyage-toiture.webp',
    alt: "Démoussage professionnel d'une toiture en ardoise dans l'Essonne",
    html: `Votre toiture est envahie par les mousses, ou tout simplement sale ? Je suis spécialiste du démoussage professionnel : mes techniques nettoient votre toit sans jamais l'abîmer, et mes traitements font disparaître les végétaux en les empêchant de revenir. Confiez le <a href="/nettoyage-toiture/">nettoyage de toiture</a> à un artisan couvreur.`,
  },
  {
    titre: 'Réparation de toiture',
    img: '/images/services/reparation-toiture.webp',
    alt: "Réparation d'une toiture en tuiles mécaniques abîmée dans l'Essonne",
    html: `Une fuite provient de votre toiture, ou votre toit est abîmé ? J'interviens rapidement chez vous : la <a href="/reparation-toiture/#recherche-de-fuite">recherche de fuite</a> identifie l'origine des infiltrations, puis j'effectue la <a href="/reparation-toiture/">réparation de toiture</a>. Vous retrouvez une toiture en bon état, résistante face aux intempéries.`,
  },
  {
    titre: 'Pose de fenêtres de toit Velux',
    img: '/images/fenetre-de-toit-velux-essonne-2.webp',
    alt: "Fenêtre de toit Velux posée sur une toiture en tuiles plates dans l'Essonne",
    html: `Améliorez votre confort grâce à l'installation de fenêtres de toit de type Velux : elles font circuler l'air et apportent la lumière naturelle dans les combles que vous souhaitez aménager. La <a href="/fenetre-de-toit-velux/">pose de Velux</a> doit être réalisée par un professionnel pour garantir l'étanchéité de votre toiture.`,
  },
  {
    titre: 'Pose et remplacement de gouttières',
    img: '/images/zinguerie-gouttiere-descente-zinc-essonne.webp',
    alt: "Gouttière et descente d'eaux pluviales posées sur une maison de l'Essonne",
    html: `Gouttières, noues et chéneaux évacuent les eaux de pluie et protègent les façades et les fondations de votre maison. J'assure la <a href="/zinguerie/">pose et le remplacement de gouttières</a> en zinc, en aluminium ou en PVC, et je vous conseille celle qui respecte l'esthétique de votre habitation.`,
  },
  {
    titre: 'Isolation de toiture',
    img: '/images/services/isolation-toiture.webp',
    alt: "Pose d'un isolant et d'un écran sous toiture sur une maison de l'Essonne",
    html: `Votre toit joue un rôle central dans les économies d'énergie : bien isolé, il permet d'économiser jusqu'à 30 % d'énergie. J'installe des isolants performants et des écrans sous toiture, et je réalise l'<a href="/isolation-toiture/">isolation de toiture</a> par sarking ou par isolation soufflée, selon la configuration de votre toit.`,
  },
];

---
<BaseLayout title={title} description={description} ogImage="/images/hero-renovation-toiture-etrechy.jpg">

  <!-- ══ HERO ══ -->
  <section class="dr-hero">
    <div class="conteneur dr-hero__grille">
      <h1 class="dr-hero__titre">
        <span class="dr-ligne">Couvreur 91 – Essonne</span>
        <span class="dr-ligne dr-hero__nom">Robert Daniel Couverture</span>
      </h1>

      <figure class="dr-hero__media">
        <img class="dr-media__poster" src="/images/hero-renovation-toiture-etrechy.webp" alt="Rénovation d'une toiture dans l'Essonne par Robert Daniel Couverture" width="960" height="540" fetchpriority="high" decoding="async" />
        <video class="dr-media__video" muted loop playsinline preload="none" aria-hidden="true" data-src="/videos/renovation-toiture-etrechy-91-480p.mp4" data-start="load"></video>
      </figure>

      <div class="dr-hero__texte">
        <p class="dr-hero__lead">Un professionnel des <strong>travaux de couverture dans l'Essonne</strong> :</p>
        <ul class="dr-coches">
          <li>15 années d'expérience</li>
          <li>Devis gratuit et sans engagement</li>
          <li>Garantie décennale</li>
        </ul>
        <div class="dr-actions">
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Devis gratuit
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
          <a href="tel:0683961518" class="dr-btn dr-btn--blanc">
            <svg class="dr-tel" viewBox="0 0 24 24" aria-hidden="true">
              <g class="dr-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g>
              <path class="dr-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path class="dr-tel__onde dr-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            06 83 96 15 18
          </a>
        </div>
        <NoteGoogle variante="sombre" />
      </div>
    </div>
  </section>

  <!-- ══ BANDEAU MATÉRIAUX (rouge) ══ -->
  <div class="dr-bande">
    <ul class="conteneur dr-bande__liste">
      <li>Tuiles plates et mécaniques</li>
      <li>Ardoises</li>
      <li>Zinc et zinguerie</li>
      <li>Bac acier et shingle</li>
    </ul>
  </div>

  <!-- ══ SAVOIR-FAIRE ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <h2 class="dr-h2 dr-centre" data-anim="up">Mon savoir-faire de couvreur zingueur dans l'Essonne</h2>
      <div class="dr-cartes">
        {savoirFaire.map((s) => (
          <article class="dr-carte" data-anim="up">
            <img src={s.img} alt={s.alt} width="700" height="438" loading="lazy" decoding="async" />
            <div class="dr-carte__corps">
              <h3>{s.titre}</h3>
              <p set:html={s.html} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ VÉRIFICATION DE TOITURE PAR DRONE ══ -->
  <section class="dr-section dr-section--drone">
    <div class="conteneur">
      <article class="dr-drone" data-anim="up">
        <figure class="dr-drone__media">
          <img class="dr-media__poster" src="/images/inspection-toiture-drone-poster.webp" alt="Vue par drone d'une toiture dans l'Essonne pendant une vérification" width="960" height="540" loading="lazy" decoding="async" />
          <video class="dr-media__video" muted loop playsinline preload="none" aria-hidden="true" data-src="/videos/inspection-toiture-drone-etrechy-91-480p.mp4" data-start="visible"></video>
        </figure>
        <div class="dr-drone__corps">
          <h2>Vérification de toiture par drone dans l'Essonne</h2>
          <p>Vous souhaitez connaître l'état réel de votre toiture ? Rien de mieux que de la voir. Grâce au drone piloté, vous constatez en temps réel l'état de votre couverture, sans que personne ne monte sur le toit : tuiles, faîtage, solins et gouttières apparaissent à l'écran.</p>
          <p>Vous voyez ce que je vois, en photos et en vidéos haute définition. La <a href="/inspection-toiture-drone/">vérification de toiture par drone</a> vous permet de savoir précisément si des travaux sont nécessaires, et lesquels.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Faire vérifier ma toiture
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ RAMONAGE ══ -->
  <section class="dr-section dr-section--ramonage">
    <div class="conteneur">
      <article class="dr-ramonage" data-anim="up">
        <div class="dr-ramonage__corps">
          <h2>Ramonage de cheminée, poêle et insert</h2>
          <p>Un conduit encrassé chauffe mal et peut s'enflammer : la suie et le bistre qui s'y déposent augmentent le risque de feu de cheminée et d'intoxication au monoxyde de carbone. Je réalise le <a href="/ramonage-cheminee/">ramonage de cheminée</a> mécaniquement, au hérisson, puis je vous remets l'attestation que votre assureur peut demander. Couvreur, je contrôle en même temps la souche et le solin, là où le conduit traverse votre toiture.</p>
        </div>
        <figure class="dr-ramonage__media">
          <img src="/images/ramonage-cheminee-essonne.webp" alt="Ramonage mécanique d'un conduit de cheminée depuis le toit dans l'Essonne" width="800" height="837" loading="lazy" decoding="async" />
        </figure>
      </article>
    </div>
  </section>

  <!-- ══ L'ARTISAN (photos superposées, façon « Notre entreprise ») ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur dr-artisan">
      <div class="dr-artisan__media" data-anim="fade">
        <img class="dr-artisan__img" src="/images/robert-daniel-drone-verification-etrechy.webp" alt="Robert Daniel, artisan couvreur, avec son drone d'inspection de toiture dans l'Essonne" width="1000" height="880" loading="lazy" decoding="async" />
      </div>
      <div class="dr-artisan__texte" data-anim="up">
        <h2 class="dr-h2">Votre artisan couvreur dans l'Essonne – Robert Daniel</h2>
        <p>Depuis plus de 15 ans, je réalise les travaux de couverture des particuliers de l'Essonne : couverture, zinguerie, charpente et isolation. Tuiles plates, tuiles mécaniques, ardoises, zinc ou bac acier : je connais chaque matériau et la façon de le mettre en œuvre.</p>
        <p>Mon bureau est installé au 42 Grande Rue à Étréchy, et j'interviens dans toutes les communes du département.</p>
        <div class="dr-garantie">
          <img src="/images/logo-allianz.png" alt="Allianz" width="96" height="60" loading="lazy" decoding="async" />
          <p><strong>Garantie décennale</strong> sur tous mes travaux, assurée par Allianz.</p>
        </div>
        <a href="/a-propos/" class="dr-btn dr-btn--bleu">
          En savoir plus
          <span class="dr-btn__fleche dr-btn__fleche--bleue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══ RÉALISATIONS (composant existant) ══ -->
  <CartesRealisations titre="Mes derniers chantiers dans l'Essonne" slugs={['renovation-toiture-auvers-saint-georges', 'fenetre-de-toit-etrechy', 'entretien-gouttieres-janville-sur-juine']} />

  <!-- ══ AVIS ══ -->
  <AvisGoogle titre="Les avis de mes clients dans l'Essonne" ids={['morgane-duval-yoan-palumbo', 'anais-renaudin', 'caroline-david', 'michel-curan', 'mathieu-ponson', 'july']} fond="gris" />

  <!-- ══ ZONE D'INTERVENTION ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <h2 class="dr-h2 dr-centre" data-anim="up">Les communes dans lesquelles j'interviens</h2>
      <ul class="dr-villes" data-anim="up">
        {villes.map((v) => (<li><a href={`/${v.slug}/`}>{v.nom}</a></li>))}
      </ul>
    </div>
  </section>

  <!-- ══ CTA FINAL (photo du camion) ══ -->
  <section class="dr-section dr-section--cta">
    <div class="conteneur">
      <div class="dr-cta" data-anim="up">
        <figure class="dr-cta__media">
          <img src="/images/vehicules-robert-daniel-couverture-essonne.webp" alt="Les camions de Robert Daniel Couverture, artisan couvreur dans l'Essonne" width="900" height="600" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-cta__corps">
          <h2>Contactez votre couvreur dans l'Essonne</h2>
          <p>Le devis est gratuit et sans engagement.</p>
          <div class="dr-actions">
            <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
              Devis gratuit
              <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </a>
            <a href="tel:0683961518" class="dr-btn dr-btn--blanc">
              <svg class="dr-tel" viewBox="0 0 24 24" aria-hidden="true">
                <g class="dr-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g>
                <path class="dr-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <path class="dr-tel__onde dr-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              06 83 96 15 18
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Animations d'apparition (désactivées si l'utilisateur réduit les animations)
  const els = document.querySelectorAll('[data-anim]');
  if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    els.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach((el) => io.observe(el));
  }

  // Vidéos : jamais chargées avant la fin du chargement de la page (Lighthouse / LCP).
  // L'image d'affiche s'affiche tout de suite ; la vidéo la remplace en fondu une fois prête.
  // Pas de vidéo si l'utilisateur limite ses données ou réduit les animations.
  const conn = (navigator as any).connection;
  const sobre = (conn && conn.saveData) || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lancer = (v: HTMLVideoElement) => {
    if (v.src) return;
    v.addEventListener('playing', () => v.classList.add('is-playing'), { once: true });
    v.src = v.dataset.src || '';
    v.play().catch(() => {});
  };
  const demarrer = () => {
    if (sobre) return;
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-src]');
    const vio = 'IntersectionObserver' in window ? new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { lancer(e.target as HTMLVideoElement); vio.unobserve(e.target); } });
    }, { rootMargin: '200px 0px' }) : null;
    videos.forEach((v) => {
      if (v.dataset.start === 'load' || !vio) lancer(v); else vio.observe(v);
    });
  };
  const apresChargement = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(demarrer, { timeout: 2000 }) : setTimeout(demarrer, 200));
  if (document.readyState === 'complete') apresChargement(); else window.addEventListener('load', apresChargement, { once: true });
</script>

<style>
  /* ── Jetons locaux (charte Robert Daniel) ── */
  .dr-hero, .dr-section, .dr-bande {
    --nuit: #062a45;
    --rouge-clair: #ff4d42;
    --ombre-carte: 0 6px 20px rgb(0 73 123 / .07);
    --ombre-carte-hover: 0 16px 34px rgb(0 73 123 / .15);
    --ligne: #e2e6ea;
  }

  /* ── Apparitions ── */
  [data-anim] { opacity: 0; transition: opacity .7s ease, transform .7s ease; }
  [data-anim="up"] { transform: translate3d(0, 28px, 0); }
  [data-anim].is-visible { opacity: 1; transform: none; }

  /* ── Sections ── */
  .dr-section { padding-block: 88px; }
  .dr-section--gris { background: var(--gris-50); }
  @media (max-width: 1023px) { .dr-section { padding-block: 64px; } }
  @media (max-width: 767px)  { .dr-section { padding-block: 52px; } }
  .dr-centre { text-align: center; }
  .dr-h2 {
    font-family: var(--font-titres); font-weight: 700; color: var(--bleu-fonce);
    font-size: clamp(19px, .6rem + 2.6vw, 36px); line-height: 1.2; text-wrap: balance; margin: 0;
  }
  .dr-h3 {
    font-family: var(--font-titres); font-weight: 700; color: var(--bleu-fonce);
    font-size: clamp(19px, .85rem + .6vw, 23px); line-height: 1.3; margin: 0;
  }

  /* ── Boutons (pilule, jamais pleine largeur) ── */
  .dr-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .dr-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 12px;
    width: auto; max-width: max-content; min-height: 50px; padding: 14px 26px;
    border-radius: 999px; font-family: var(--font-titres); font-weight: 700; font-size: 16px;
    line-height: 1.2; text-decoration: none; white-space: nowrap;
    box-shadow: 0 4px 12px rgb(0 42 69 / .12);
    transition: background-color .25s ease, color .25s ease, transform .25s ease, box-shadow .25s ease;
  }
  .dr-btn:hover { transform: translate3d(0, -2px, 0); box-shadow: 0 10px 22px rgb(0 42 69 / .2); }
  .dr-btn--rouge { background: var(--cuivre); color: #fff; }
  .dr-btn--rouge:hover { background: var(--cuivre-fonce); color: #fff; }
  .dr-btn--bleu { background: var(--bleu); color: #fff; }
  .dr-btn--bleu:hover { background: var(--bleu-fonce); color: #fff; }
  .dr-btn--blanc { background: #fff; color: var(--bleu-fonce); }
  .dr-btn--blanc:hover { background: var(--gris-100); color: var(--bleu-fonce); }
  .dr-btn--gris { background: var(--gris-100); color: var(--bleu-fonce); box-shadow: none; }
  .dr-btn--gris:hover { background: var(--gris-200); color: var(--bleu-fonce); }
  .dr-btn__fleche {
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
    width: 26px; height: 26px; border-radius: 50%; background: #fff; color: var(--cuivre); overflow: hidden;
  }
  .dr-btn__fleche--bleue { color: var(--bleu); }
  .dr-btn__fleche svg { width: 14px; height: 14px; transition: transform .3s ease; }
  .dr-btn:hover .dr-btn__fleche svg { transform: translate3d(3px, 0, 0); }
  @media (max-width: 767px) {
    .dr-btn { min-height: 46px; padding: 12px 18px; font-size: 15px; gap: 10px; }
  }

  /* Smartphone qui sonne */
  .dr-tel { width: 20px; height: 20px; flex-shrink: 0; overflow: visible; }
  .dr-tel__corps { transform-origin: 40% 50%; animation: dr-sonne 2.4s ease-in-out infinite; }
  .dr-tel__onde { opacity: 0; animation: dr-onde 2.4s ease-out infinite; }
  .dr-tel__onde--2 { animation-delay: .25s; }
  @keyframes dr-sonne {
    0%, 70%, 100% { transform: rotate(0); }
    75% { transform: rotate(-12deg); } 80% { transform: rotate(10deg); }
    85% { transform: rotate(-8deg); } 90% { transform: rotate(6deg); }
  }
  @keyframes dr-onde { 0%, 60% { opacity: 0; } 75% { opacity: 1; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .dr-tel__corps, .dr-tel__onde { animation: none; }
    .dr-tel__onde { opacity: 1; }
    [data-anim] { opacity: 1; transform: none; transition: none; }
  }

  /* ── Hero ── */
  .dr-hero { background: var(--nuit); padding-block: 56px; overflow: hidden; }
  .dr-hero__grille {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: "titre media" "texte media"; align-items: center; gap: 22px 52px;
  }
  .dr-hero__titre {
    grid-area: titre; align-self: end; margin: 0; color: #fff;
    font-family: var(--font-titres); font-weight: 700;
    font-size: clamp(28px, 3.1vw, 40px); line-height: 1.15;
  }
  .dr-ligne { display: block; white-space: nowrap; }
  .dr-hero__nom { color: var(--rouge-clair); }
  .dr-hero__media {
    grid-area: media; margin: 0; border-radius: 16px; overflow: hidden; position: relative;
    box-shadow: 0 20px 50px rgb(0 0 0 / .3); aspect-ratio: 3 / 2;
  }
  /* Affiche + vidéo superposée (la vidéo apparaît en fondu quand elle joue) */
  .dr-media__poster, .dr-media__video { display: block; width: 100%; height: 100%; object-fit: cover; }
