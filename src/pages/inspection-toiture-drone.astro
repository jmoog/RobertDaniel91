---
// Page pilier « Inspection de toiture par drone » — refonte oct. 2026 au
// design de la page Ramonage (gabarit PageService). Centrée sur l'Essonne.
import PageService from '../components/PageService.astro';
import CartesRealisations from '../components/CartesRealisations.astro';

const url = 'https://robert-daniel-couverture.fr/inspection-toiture-drone/';
const title = "Inspection de toiture par drone (91) – Robert Daniel";
const description = "Inspection de toiture par drone dans l'Essonne (91) : images de chaque pan, avis d'un couvreur sur votre couverture, devis si besoin. Robert Daniel.";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Inspection de toiture par drone',
  serviceType: 'Diagnostic de toiture par drone',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url,
  image: 'https://robert-daniel-couverture.fr/images/inspection-drone-vue-toiture-essonne.jpg',
  description,
  subjectOf: {
    '@type': 'VideoObject',
    name: "Inspection d'une toiture par drone dans l'Essonne",
    description: "Survol d'une toiture par drone pour en contrôler l'état, par Robert Daniel, artisan couvreur dans l'Essonne.",
    thumbnailUrl: 'https://robert-daniel-couverture.fr/videos/inspection-toiture-drone-poster.jpg',
    contentUrl: 'https://robert-daniel-couverture.fr/videos/inspection-toiture-drone-etrechy-91.mp4',
    uploadDate: '2026-06-18',
  },
}];

const defauts = [
  { titre: 'Tuiles et ardoises', texte: "Tuiles cassées, fendues ou glissées, ardoises manquantes : les premiers signes d'une fuite à venir." },
  { titre: 'Faîtage et rives', texte: "Faîtières descellées, mortier fissuré, tuiles de rive arrachées par le vent sur les pignons." },
  { titre: 'Solins de cheminée', texte: "Solins fissurés ou décollés autour des souches, une cause fréquente d'infiltration le long du conduit." },
  { titre: 'Noues', texte: "Noues encrassées par les feuilles ou percées, là où l'eau de deux pans se rejoint." },
  { titre: 'Mousses et dépôts', texte: "Plaques de mousse et de lichen qui retiennent l'eau et annoncent un <a href=\"/nettoyage-toiture/\">démoussage de la toiture</a>." },
  { titre: 'Gouttières', texte: "Gouttières désaxées, pleines de débris ou percées, qui laissent l'eau ruisseler le long des murs." },
];
---
<PageService
  title={title}
  description={description}
  extraSchemas={extraSchemas}
  ariane={[{ label: 'Accueil', href: '/' }, { label: 'Inspection de toiture par drone' }]}
  h1="Inspection par drone 91 –"
  hero={{ src: '/videos/inspection-toiture-drone-poster.jpg', alt: "Survol d'une toiture en tuiles par drone dans l'Essonne", width: 1280, height: 720 }}
  heroVideo={{ src: '/videos/inspection-toiture-drone-etrechy-91.mp4', poster: '/videos/inspection-toiture-drone-poster.jpg' }}
  ogImage="/images/inspection-drone-vue-toiture-essonne.jpg"
  lead="L'<strong>inspection de votre toiture par drone dans l'Essonne</strong> : vous voyez l'état réel de votre couverture, images à l'appui."
  coches={['Images de chaque pan de la toiture', "L'avis d'un couvreur sur les défauts", 'Devis gratuit si des travaux sont utiles']}
  bande={['Tuiles et ardoises', 'Faîtage et rives', 'Solins et noues', 'Gouttières']}
  artisan={{
    titre: "L'œil d'un couvreur sur les images",
    html: `<p>Un drone ne pose pas de diagnostic : c'est le couvreur qui lit les images. Depuis plus de 15 ans, je répare et je rénove les toitures de l'Essonne, et je sais reconnaître sur une photo un faîtage qui travaille ou un solin qui va lâcher.</p>
<p>Je vous commente les images, je vous explique ce que chaque défaut implique et je distingue ce qui demande une intervention rapide de ce qui peut attendre. Vous décidez ensuite, sans pression.</p>`,
  }}
  avis={{ titre: 'Des explications claires, selon mes clients', ids: ['jef', 'michel-curan', 'caroline-david'] }}
  cta={{ titre: 'Faites inspecter votre toiture par drone' }}
>

  <!-- ══ VOIR SA TOITURE ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-duo dr-duo--seul" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/inspection-drone-vue-toiture-essonne.webp" alt="Vue aérienne par drone d'une toiture en tuiles avec ses lucarnes dans l'Essonne" width="1200" height="900" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h2 class="dr-h2">Voir votre toiture sans attendre une fuite</h2>
          <p>Depuis le sol, on ne voit qu'une partie de son toit. Le drone s'approche au plus près de la couverture et filme chaque pan, le faîtage, les noues, les rives et les solins, sans qu'il soit nécessaire de circuler sur les tuiles.</p>
          <p>Les images s'affichent en direct sur l'écran : vous constatez vous-même ce qui se passe là-haut. Les défauts qu'on ne distingue pas du jardin apparaissent nettement, et vous n'avez pas à me croire sur parole.</p>
          <p>C'est un service que je propose comme <a href="/">artisan couvreur dans l'Essonne</a>, en amont de tous mes travaux de couverture.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ CE QUE VOUS OBTENEZ (carte bleu nuit) ══ -->
  <section class="dr-section dr-section--serre">
    <div class="conteneur">
      <article class="dr-regle" data-anim="up">
        <div class="dr-regle__corps">
          <h2>Un diagnostic que vous voyez de vos yeux</h2>
          <p>Le survol dure quelques minutes. Je commente ensuite les images avec vous, je pointe les défauts et je vous explique leurs conséquences pour votre maison.</p>
          <p>Si des travaux sont utiles, le relevé sert de base au devis : je chiffre au plus juste, sans surprise une fois le chantier lancé. Pour un dossier d'assurance, les images constituent aussi une trace datée de l'état de la couverture.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Demander une inspection
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
        <div class="dr-regle__certif">
          <h3>Ce que vous obtenez</h3>
          <ul class="dr-coches dr-coches--sombre">
            <li>Des images nettes de chaque pan</li>
            <li>L'explication de chaque défaut repéré</li>
            <li>Un devis détaillé si des travaux sont utiles</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ CE QUE LE DRONE REPÈRE ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Ce que le drone permet de repérer</h2>
        <p>Des défauts invisibles depuis le sol, qui annoncent souvent une fuite.</p>
      </div>
      <ul class="dr-equip">
        {defauts.map((d) => (
          <li class="dr-equip__carte" data-anim="up">
            <h3>{d.titre}</h3>
            <p set:html={d.texte} />
          </li>
        ))}
      </ul>

      <div class="dr-duo dr-duo--inverse dr-methode" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/inspection-drone-vue-dessus-essonne.webp" alt="Toiture vue de dessus par drone pour en contrôler les pans et le faîtage" width="1200" height="900" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h3 class="dr-h3">Du diagnostic aux travaux</h3>
          <p>L'inspection débouche sur des solutions concrètes. Une tuile glissée ou un solin fissuré se règle par une <a href="/reparation-toiture/">réparation de toiture</a> ciblée, réalisée par mon équipe.</p>
          <p>Quand les images montrent une couverture usée sur l'ensemble du toit, je vous le dis franchement et nous regardons ensemble ce qu'il convient de faire, avec un devis à l'appui.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ QUAND ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Quand faire inspecter sa toiture ?</h2>
        <p>L'inspection par drone est utile à plusieurs moments de la vie d'une maison.</p>
      </div>
      <div class="dr-conseils">
        <article class="dr-conseil" data-anim="up">
          <h3>Avant un achat ou des travaux</h3>
          <ul class="dr-puces">
            <li>Avant d'acheter une maison, pour connaître l'état réel du toit.</li>
            <li>Avant une <a href="/renovation-toiture/">rénovation de la toiture</a>, pour chiffrer juste.</li>
            <li>Pour un contrôle régulier d'une couverture qui vieillit.</li>
          </ul>
        </article>
        <article class="dr-conseil" data-anim="up">
          <h3>Après un événement</h3>
          <ul class="dr-puces">
            <li>Après un coup de vent ou un orage qui a pu déplacer des tuiles.</li>
            <li>Devant une trace d'humidité dont on cherche l'origine.</li>
            <li>Quand des débris de tuiles tombent dans le jardin.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ══ RÉALISATION ══ -->
  <CartesRealisations
    slugs={['renovation-toiture-auvers-saint-georges']}
    titre="Une toiture contrôlée au drone"
    intro="Les vues aériennes ont permis de contrôler chaque pan et chaque lucarne une fois la couverture refaite."
    fond="blanc"
    centre
    lienTout={false}
  />
</PageService>
