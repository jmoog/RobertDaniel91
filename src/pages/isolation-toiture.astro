---
// Page pilier « Isolation de toiture » — refonte oct. 2026 au design de la
// page Ramonage (gabarit PageService). Centrée sur l'Essonne.
import PageService from '../components/PageService.astro';

const url = 'https://robert-daniel-couverture.fr/isolation-toiture/';
const title = "Isolation de toiture dans l'Essonne (91) – Robert Daniel";
const description = "Isolation de toiture et des combles dans l'Essonne (91) : combles perdus, combles aménagés, isolation par l'extérieur (sarking). Robert Daniel, couvreur.";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Isolation de toiture',
  serviceType: 'Isolation de toiture et des combles',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url,
  image: 'https://robert-daniel-couverture.fr/images/isolation-toiture-ecran-sous-toiture-essonne.jpg',
  description,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: "Prestations d'isolation de toiture",
    itemListElement: [
      'Isolation des combles perdus',
      'Isolation des combles aménagés',
      "Isolation de toiture par l'extérieur (sarking)",
      'Pose d\'écran sous-toiture',
    ].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
  },
}];

const etapes = [
  { titre: "L'état des lieux", texte: "Je contrôle l'isolant en place, la ventilation, la couverture et l'état de la <a href=\"/charpente/\">charpente bois</a>." },
  { titre: 'Le devis précis', texte: "Le devis indique le matériau, l'épaisseur posée et la mise en œuvre : des éléments utiles pour un dossier d'aide." },
  { titre: 'La pose', texte: "Je pose l'isolant sans tassement ni vide, en traitant chaque jonction pour éviter les pertes de chaleur." },
  { titre: 'La ventilation', texte: "Je laisse à la couverture la lame d'air dont elle a besoin : le bois respire et l'humidité ne s'installe pas." },
];
---
<PageService
  title={title}
  description={description}
  extraSchemas={extraSchemas}
  ariane={[{ label: 'Accueil', href: '/' }, { label: 'Isolation de toiture' }]}
  h1="Isolation de toiture 91 –"
  hero={{ src: '/images/isolation-toiture-ecran-sous-toiture-essonne.webp', alt: "Écran sous-toiture posé sur la charpente avant l'isolation et la couverture dans l'Essonne", width: 1200, height: 900 }}
  lead="L'<strong>isolation de votre toiture dans l'Essonne</strong>, par l'intérieur ou par l'extérieur, réalisée par un couvreur qui connaît votre toit."
  coches={['Combles perdus ou aménagés', "Isolation par l'extérieur (sarking)", 'Devis gratuit et détaillé']}
  bande={['Combles perdus', 'Combles aménagés', 'Sarking', 'Écran sous-toiture']}
  artisan={{
    titre: "Une isolation pensée avec la toiture",
    html: `<p>Depuis plus de 15 ans, j'interviens sur les toitures de l'Essonne, de la charpente à la dernière tuile. Isoler un toit, c'est d'abord connaître la couverture qui protège l'isolant : un couvreur maîtrise les raccords entre l'isolant, l'écran sous-toiture et les tuiles.</p>
<p>Je vous oriente vers la solution réellement adaptée à votre maison et à l'usage de vos combles, puis je vous remets un devis qui précise le matériau et l'épaisseur posée.</p>`,
  }}
  avis={{ titre: 'Les avis de mes clients', ids: ['anais-renaudin', 'mathieu-ponson', 'olivier-loret'] }}
  cta={{ titre: "Faites isoler votre toiture dans l'Essonne" }}
>

  <!-- ══ CHALEUR PERDUE ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-duo dr-duo--seul" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/isolation-toiture-liteaux-ecran-essonne.webp" alt="Contre-liteaux et liteaux posés sur l'écran sous-toiture lors d'une rénovation dans l'Essonne" width="1200" height="900" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h2 class="dr-h2">Une toiture mal isolée, c'est de la chaleur perdue</h2>
          <p>Le toit est la première surface par laquelle une maison perd sa chaleur. Quand l'isolant est ancien, tassé ou absent, le chauffage tourne en continu, les combles restent froids l'hiver et étouffants l'été.</p>
          <p>Une isolation bien posée inverse la tendance : la maison garde sa chaleur, les pièces sous les toits deviennent agréables à vivre et les factures de chauffage baissent dès la première saison.</p>
          <p>Avant de proposer une solution, j'examine votre couverture : l'isolation se réfléchit avec le toit qui la protège. C'est l'avantage de confier ces travaux à un <a href="/">couvreur dans le 91</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ PENDANT UNE RÉNOVATION (carte bleu nuit) ══ -->
  <section class="dr-section dr-section--serre">
    <div class="conteneur">
      <article class="dr-regle" data-anim="up">
        <div class="dr-regle__corps">
          <h2>Isoler pendant une rénovation de toiture</h2>
          <p>Le meilleur moment pour isoler par l'extérieur, c'est quand la couverture est déposée. Si vous prévoyez la <a href="/renovation-toiture/">rénovation de votre toiture</a>, je pose l'isolant sur les chevrons, sous la nouvelle couverture : c'est le sarking.</p>
          <p>Vous économisez un chantier, et la toiture ressort à la fois neuve et performante. Les raccords entre l'isolant, l'écran sous-toiture et la couverture sont réalisés par la même équipe, sans point faible.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Demander mon devis
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
        <div class="dr-regle__certif">
          <h3>Les avantages du sarking</h3>
          <ul class="dr-coches dr-coches--sombre">
            <li>Tout le volume des combles est conservé</li>
            <li>Les ponts thermiques sont supprimés</li>
            <li>Couverture et isolation posées ensemble</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ SOLUTIONS ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Isolation par l'intérieur ou par l'extérieur</h2>
        <p>Le choix dépend de l'usage de vos combles, de l'état du toit et de votre projet.</p>
      </div>
      <div class="dr-tableau-wrap" data-anim="up">
        <table class="dr-tableau">
          <thead><tr><th scope="col">Solution</th><th scope="col">Bien adaptée à</th><th scope="col">Principe</th></tr></thead>
          <tbody>
            <tr><th scope="row">Combles perdus</th><td data-label="Bien adaptée à">Greniers non habités</td><td data-label="Principe">Isolant soufflé ou déroulé sur le plancher des combles</td></tr>
            <tr><th scope="row">Combles aménagés</th><td data-label="Bien adaptée à">Pièces habitées sous la pente</td><td data-label="Principe">Isolant posé entre et sous les chevrons</td></tr>
            <tr><th scope="row">Sarking</th><td data-label="Bien adaptée à">Toiture déposée pour rénovation</td><td data-label="Principe">Isolant posé sur la charpente, sous la couverture neuve</td></tr>
          </tbody>
        </table>
      </div>

      <div class="dr-duo dr-duo--inverse dr-methode" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/renovation-toiture-liteaux-essonne.webp" alt="Liteaux et écran sous-toiture posés sur une toiture vue de dessus dans l'Essonne" width="1200" height="900" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h3 class="dr-h3">Des combles aménagés lumineux et confortables</h3>
          <p>L'isolation par l'intérieur se met en œuvre sur une toiture existante, sans toucher à la couverture. Elle convient aux combles aménagés comme aux greniers que l'on souhaite habiter.</p>
          <p>Une pièce sous les toits bien isolée gagne encore à être éclairée. La pose d'une <a href="/fenetre-de-toit-velux/">fenêtre de toit Velux</a> s'organise en même temps que l'isolation, avec une jonction étanche entre le châssis et l'isolant.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ ÉTAPES ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Comment je procède</h2>
        <p>Une isolation efficace se prépare avant de se poser.</p>
      </div>
      <ol class="dr-etapes">
        {etapes.map((e) => (
          <li class="dr-etape" data-anim="up">
            <h3>{e.titre}</h3>
            <p set:html={e.texte} />
          </li>
        ))}
      </ol>
      <div class="dr-texte dr-apres" data-anim="up">
        <p>Des aides publiques existent pour les travaux d'isolation, sous conditions de ressources et de performance. Leurs montants et leurs critères évoluent régulièrement : vérifiez votre éligibilité auprès des organismes officiels avant de lancer vos travaux.</p>
      </div>
    </div>
  </section>
</PageService>
