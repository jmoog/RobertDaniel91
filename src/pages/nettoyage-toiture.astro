---
// Page pilier « Nettoyage de toiture » — refonte oct. 2026 au design de la
// page Ramonage (gabarit PageService). Centrée sur l'Essonne.
import PageService from '../components/PageService.astro';

const url = 'https://robert-daniel-couverture.fr/nettoyage-toiture/';
const title = "Nettoyage de toiture dans l'Essonne (91) – Robert Daniel";
const description = "Nettoyage et démoussage de toiture dans l'Essonne (91) : mousses retirées, traitement anti-mousse et hydrofuge, gouttières vidées. Robert Daniel, couvreur.";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Nettoyage de toiture',
  serviceType: 'Nettoyage et démoussage de toiture',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url,
  image: 'https://robert-daniel-couverture.fr/images/nettoyage-toiture-couvreur-essonne-hd.jpg',
  description,
  subjectOf: {
    '@type': 'VideoObject',
    name: "Démoussage d'une toiture en tuiles dans l'Essonne",
    description: "Démoussage d'une toiture en tuiles par Robert Daniel, artisan couvreur dans l'Essonne.",
    thumbnailUrl: 'https://robert-daniel-couverture.fr/videos/demoussage-toiture-essonne-poster.jpg',
    contentUrl: 'https://robert-daniel-couverture.fr/videos/demoussage-toiture-essonne.mp4',
    uploadDate: '2026-06-18',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations de nettoyage de toiture',
    itemListElement: [
      'Démoussage de toiture',
      'Traitement anti-mousse',
      'Application d\'un hydrofuge',
      'Nettoyage des gouttières',
    ].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
  },
}];

const etapes = [
  { titre: 'Le repérage', texte: "Je repère le matériau, la pente et les zones les plus envahies pour adapter la méthode à votre couverture." },
  { titre: 'Le démoussage', texte: "Je retire les mousses et les lichens, puis je nettoie la couverture en dosant la pression pour ne pas fragiliser les tuiles." },
  { titre: 'Les gouttières', texte: "Je vide les gouttières et je contrôle les <a href=\"/zinguerie/descentes-eaux-pluviales/\">descentes d'eaux pluviales</a>, pour que l'eau s'évacue sans déborder." },
  { titre: 'Le traitement', texte: "J'applique le traitement anti-mousse, puis l'hydrofuge si votre couverture en a besoin, et je ramasse les débris au sol." },
];
---
<PageService
  title={title}
  description={description}
  extraSchemas={extraSchemas}
  ariane={[{ label: 'Accueil', href: '/' }, { label: 'Nettoyage de toiture' }]}
  h1="Nettoyage de toiture 91 –"
  hero={{ src: '/images/nettoyage-toiture-couvreur-essonne-hd.webp', alt: "Robert Daniel, couvreur, pendant le nettoyage d'une toiture en tuiles dans l'Essonne", width: 900, height: 1125, position: 'center 25%' }}
  lead="Le <strong>nettoyage et le démoussage de votre toiture dans l'Essonne</strong> par un couvreur, qui contrôle votre couverture dans le même passage."
  coches={['Démoussage complet de la couverture', 'Traitement anti-mousse et hydrofuge', 'Devis gratuit et sans engagement']}
  bande={['Démoussage', 'Traitement anti-mousse', 'Hydrofuge', 'Nettoyage des gouttières']}
  artisan={{
    titre: 'Le démoussage par un professionnel de la toiture',
    html: `<p>Depuis plus de 15 ans, j'entretiens les toitures de l'Essonne. Tuile plate, tuile mécanique ou ardoise : je choisis pour chaque toit la méthode et les produits qui nettoient sans abîmer.</p>
<p>Avant de commencer, je vous explique ce dont votre toit a réellement besoin. Le traitement et l'hydrofuge ne sont jamais systématiques : je vous les propose seulement quand votre couverture en tire un vrai bénéfice.</p>`,
  }}
  avis={{ titre: "Les avis de mes clients sur l'entretien de leur toit", ids: ['caro-dvx', 'didier-nara', 'megg-geuffroy'] }}
  cta={{ titre: "Faites nettoyer votre toiture dans l'Essonne" }}
>

  <!-- ══ POURQUOI NETTOYER ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-duo dr-duo--seul" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/demoussage-toiture-essonne.webp" alt="Démoussage d'une toiture en tuiles à l'échelle dans l'Essonne" width="825" height="1100" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h2 class="dr-h2">Pourquoi nettoyer et démousser sa toiture</h2>
          <p>La mousse et le lichen ne sont pas qu'une question d'aspect. En s'installant entre les tuiles, ils retiennent l'eau, gênent son écoulement et accélèrent l'usure de la couverture. Avec le gel, l'eau retenue fait éclater les tuiles poreuses.</p>
          <p>Les débris finissent aussi dans les gouttières, qui débordent et laissent l'eau ruisseler le long des murs. Un toit propre, au contraire, laisse filer la pluie et garde des tuiles saines bien plus longtemps.</p>
          <p>Faire nettoyer sa toiture par un <a href="/">artisan couvreur 91</a>, c'est un entretien simple au regard de tout ce qu'il préserve : la couverture, la charpente et l'isolation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ UN COUVREUR (carte bleu nuit) ══ -->
  <section class="dr-section dr-section--serre">
    <div class="conteneur">
      <article class="dr-regle" data-anim="up">
        <div class="dr-regle__corps">
          <h2>Un nettoyage confié à un couvreur</h2>
          <p>Intervenir sur une couverture ne s'improvise pas : une tuile cassée ou mal remise laisse passer l'eau dès la première pluie. Un couvreur connaît la résistance de chaque matériau et sait remettre chaque tuile en place.</p>
          <p>Pendant le nettoyage, je repère aussi les défauts qu'on ne voit pas du sol. Si une tuile est fêlée ou un solin fatigué, je vous le signale et je vous propose la <a href="/reparation-toiture/">réparation de la toiture</a> dans le même passage.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Demander mon devis
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
        <div class="dr-regle__certif">
          <h3>Pendant le nettoyage, je contrôle</h3>
          <ul class="dr-coches dr-coches--sombre">
            <li>Les tuiles fêlées ou déplacées</li>
            <li>Le faîtage et les rives</li>
            <li>Les solins de cheminée</li>
            <li>Les gouttières et les descentes</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ PRESTATIONS ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Démoussage, traitement et hydrofuge</h2>
        <p>Le nettoyage d'une toiture se fait en plusieurs temps, que j'adapte à l'état du toit et au matériau.</p>
      </div>
      <div class="dr-tableau-wrap" data-anim="up">
        <table class="dr-tableau">
          <thead><tr><th scope="col">Prestation</th><th scope="col">Ce que je fais</th><th scope="col">Le résultat</th></tr></thead>
          <tbody>
            <tr><th scope="row">Démoussage</th><td data-label="Ce que je fais">Retrait des mousses et lichens, brossage et nettoyage des tuiles</td><td data-label="Le résultat">Couverture dégagée, écoulement rétabli</td></tr>
            <tr><th scope="row">Gouttières</th><td data-label="Ce que je fais">Retrait des feuilles et des dépôts, contrôle des descentes</td><td data-label="Le résultat">L'eau s'évacue sans déborder</td></tr>
            <tr><th scope="row">Anti-mousse</th><td data-label="Ce que je fais">Application d'un produit qui détruit les racines</td><td data-label="Le résultat">Retour des mousses ralenti</td></tr>
            <tr><th scope="row">Hydrofuge</th><td data-label="Ce que je fais">Protection qui fait perler l'eau sur la tuile</td><td data-label="Le résultat">Tuiles moins poreuses, salissures freinées</td></tr>
          </tbody>
        </table>
      </div>
      <div class="dr-texte dr-apres" data-anim="up">
        <p>Sur une toiture neuve, j'applique l'hydrofuge dès la fin de la pose, sur des tuiles encore propres, comme lors du <a href="/realisations/toiture-hydrofuge-brieres-les-scelles/">traitement hydrofuge d'une toiture neuve à Brières-les-Scellés</a>.</p>
      </div>
    </div>
  </section>

  <!-- ══ VIDÉO ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Un démoussage de toiture en vidéo</h2>
        <p>Une toiture en tuiles en cours de démoussage dans l'Essonne.</p>
      </div>
      <div class="dr-video dr-video--portrait" data-anim="up">
        <video controls muted loop playsinline preload="none" poster="/videos/demoussage-toiture-essonne-poster.jpg" width="720" height="960">
          <source src="/videos/demoussage-toiture-essonne.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <!-- ══ ÉTAPES ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Comment je nettoie une toiture</h2>
        <p>Quatre étapes, du repérage au ramassage des débris.</p>
      </div>
      <ol class="dr-etapes">
        {etapes.map((e) => (
          <li class="dr-etape" data-anim="up">
            <h3>{e.titre}</h3>
            <p set:html={e.texte} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══ FRÉQUENCE ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">À quelle fréquence nettoyer sa toiture ?</h2>
        <p>La bonne fréquence dépend de l'environnement de votre maison et du matériau de votre couverture.</p>
      </div>
      <div class="dr-conseils">
        <article class="dr-conseil" data-anim="up">
          <h3>Le bon rythme</h3>
          <ul class="dr-puces">
            <li>Un démoussage tous les trois à cinq ans suffit en général à garder une couverture saine.</li>
            <li>Un toit entouré d'arbres se salit plus vite qu'un toit dégagé.</li>
            <li>Les gouttières se vérifient une à deux fois par an, surtout après la chute des feuilles.</li>
          </ul>
        </article>
        <article class="dr-conseil" data-anim="up">
          <h3>Les signes à surveiller</h3>
          <ul class="dr-puces">
            <li>Des plaques de mousse qui s'étendent d'une saison à l'autre.</li>
            <li>Des gouttières qui débordent par temps de pluie.</li>
            <li>Des traces noires ou des tuiles qui s'effritent : la couverture souffre et un contrôle s'impose.</li>
          </ul>
        </article>
      </div>
      <div class="dr-texte dr-apres" data-anim="up">
        <p>Quand les tuiles sont devenues poreuses sur l'ensemble du toit, un nettoyage ne suffit plus à les protéger. Je vous le dis franchement et nous regardons ensemble si une <a href="/renovation-toiture/">rénovation de toiture</a> devient préférable.</p>
      </div>
    </div>
  </section>
</PageService>
