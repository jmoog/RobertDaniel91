---
// ════════════════════════════════════════════════════════════════════
// PAGE RAMONAGE (refonte oct. 2026, brief Notion « Rédaction de la page
// Ramonage »). Design aligné sur la nouvelle page d'accueil (hero bleu nuit,
// bandeau rouge, cartes, CTA camion). Page centrée sur l'Essonne (91) :
// aucune mention d'Étréchy pour ne pas concurrencer /couvreur-etrechy/.
// Ancienne version : _archives/ramonage-cheminee-avant-refonte-2026-10-13.astro
// ════════════════════════════════════════════════════════════════════
import BaseLayout from '../layouts/BaseLayout.astro';
import FilAriane from '../components/FilAriane.astro';
import villes from '../data/villes.json';

import AvisGoogle from '../components/AvisGoogle.astro';
import NoteGoogle from '../components/NoteGoogle.astro';
const title = "Ramonage de cheminées dans l'Essonne (91) – Robert Daniel";
const description = "Confiez le ramonage de vos cheminées et conduits à un spécialiste dans l'Essonne (91) – Certificat de ramonage fourni. Robert Daniel";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://robert-daniel-couverture.fr/ramonage-cheminee/#service',
  name: 'Ramonage de cheminées',
  serviceType: 'Ramonage de cheminées, poêles, inserts et conduits',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url: 'https://robert-daniel-couverture.fr/ramonage-cheminee/',
  image: 'https://robert-daniel-couverture.fr/images/ramonage-souche-cheminee-essonne.jpg',
  description,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations de ramonage',
    itemListElement: [
      'Ramonage de conduits de cheminée (bois, gaz, fioul)',
      'Ramonage de poêles à bois et à granulés',
      "Ramonage d'inserts ouverts ou fermés",
      'Ramonage de chaudières et de chauffe-eau',
      "Entretien de VMC et tests d'étanchéité des conduits",
    ].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
  },
}];

const equipements = [
  { titre: 'Conduits de cheminée', texte: "Ramonage des conduits de fumée raccordés à un appareil au bois, au gaz ou au fioul." },
  { titre: 'Poêles à bois et à granulés', texte: "Conduit et tuyau de raccordement, pour les poêles à bûches comme pour les poêles à pellets." },
  { titre: 'Inserts ouverts ou fermés', texte: "Conduit et raccordement de votre insert ou de votre foyer, avec contrôle du tirage." },
  { titre: 'Chaudières et chauffe-eau', texte: "Ramonage du conduit qui évacue les fumées de votre chaudière ou de votre chauffe-eau." },
  { titre: 'VMC et étanchéité des conduits', texte: "Entretien des systèmes de VMC et tests d'étanchéité des conduits de fumée." },
];

const conseils = [
  {
    titre: 'Poêles à bois et inserts',
    points: [
      "Laissez une fine couche de cendre dans le cendrier : sa présence est nécessaire au bon fonctionnement du foyer.",
      "Nettoyez la vitre avec un produit spécifique, ou avec du papier journal humide passé dans la cendre.",
      "Remplacez le joint de la porte chaque année pour maintenir l'étanchéité à l'air et garantir le tirage.",
      "Complétez l'entretien par des bûches de ramonage, qui limitent l'accumulation de goudron.",
    ],
  },
  {
    titre: 'Poêles à granulés',
    points: [
      "Aspirez les poussières déposées au fond du réservoir lors du rechargement.",
      "Videz le cendrier avec précaution, pour éviter la chute de résidus dans le mécanisme.",
      "Nettoyez régulièrement la vitre et le brasier : des granulés de qualité limitent la formation de dépôts.",
      "Faites réaliser une révision annuelle pour ajuster les réglages de l'appareil.",
    ],
  },
];

---
<BaseLayout title={title} description={description} extraSchemas={extraSchemas} ogImage="/images/ramonage-souche-cheminee-essonne.jpg">

  <!-- ══ HERO ══ -->
  <section class="dr-hero">
    <div class="conteneur dr-hero__ariane">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: 'Ramonage de cheminée' }]} />
    </div>
    <div class="conteneur dr-hero__grille">
      <h1 class="dr-hero__titre">
        <span class="dr-ligne">Ramonage 91 –</span>
        <span class="dr-ligne dr-hero__nom">M. ROBERT Daniel</span>
      </h1>

      <figure class="dr-hero__media">
        <img src="/images/ramonage-souche-cheminee-essonne.webp" alt="Souche de cheminée et son solin sur une toiture en tuiles dans l'Essonne" width="900" height="1200" fetchpriority="high" decoding="async" />
      </figure>

      <div class="dr-hero__texte">
        <p class="dr-hero__lead">Le <strong>ramonage de vos conduits et cheminées dans l'Essonne</strong> par un professionnel de la toiture.</p>
        <ul class="dr-coches">
          <li>Certificat de ramonage fourni</li>
          <li>Ramonage mécanique à la brosse</li>
          <li>Devis gratuit et sans engagement</li>
        </ul>
        <div class="dr-actions">
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Devis gratuit
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
          <a href="tel:0683961518" class="dr-btn dr-btn--blanc">
            <svg class="dr-tel" viewBox="0 0 24 24" aria-hidden="true">
              <g class="dr-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g>
              <path class="dr-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path class="dr-tel__onde dr-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            06 83 96 15 18
          </a>
        </div>
        <NoteGoogle variante="sombre" />
      </div>
    </div>
  </section>

  <!-- ══ BANDEAU ÉQUIPEMENTS (rouge) ══ -->
  <div class="dr-bande">
    <ul class="conteneur dr-bande__liste">
      <li>Cheminées et conduits</li>
      <li>Poêles à bois et à granulés</li>
      <li>Inserts</li>
      <li>Chaudières et chauffe-eau</li>
    </ul>
  </div>

  <!-- ══ ENTRETIEN ET RAMONAGE ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <h2 class="dr-h2 dr-centre" data-anim="up">L'entretien et le ramonage de vos installations de chauffage</h2>
      <div class="dr-duo" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/ramonage-cheminee-essonne.webp" alt="Ramonage d'un conduit de cheminée au hérisson depuis le toit dans l'Essonne" width="800" height="837" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <p>Le ramonage régulier des conduits de fumée, des chaudières et des poêles garantit la sécurité de votre domicile. À chaque flambée, la suie et le bistre se déposent sur les parois du conduit, réduisent le passage des fumées et finissent par gêner le tirage.</p>
          <p>Une évacuation optimale des fumées prévient les risques d'intoxication au monoxyde de carbone et évite les feux de cheminée. Un conduit propre, c'est aussi un appareil qui chauffe mieux.</p>
          <p>Fort de plus de 15 années d'expérience sur les toits du département, <a href="/">couvreur 91</a>, je ramone les cheminées, les poêles et les inserts des particuliers dans toute l'Essonne (91).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ RÉGLEMENTATION ET SÉCURITÉ (carte bleu nuit) ══ -->
  <section class="dr-section dr-section--serre">
    <div class="conteneur">
      <article class="dr-regle" data-anim="up">
        <div class="dr-regle__corps">
          <h2>Ramonage : réglementation et sécurité</h2>
          <p>L'intervention d'un professionnel certifié est une obligation légale. La méthode chimique seule, avec une bûche ou un produit de ramonage, n'est pas reconnue comme suffisante : seul le ramonage mécanique du conduit est valable.</p>
          <p>À l'issue de l'opération, je vous délivre un certificat de ramonage. Il vous couvre vis-à-vis de votre assurance habitation en cas de sinistre lié à votre installation de chauffage.</p>
          <p>La période recommandée pour planifier votre ramonage se situe avant et après la saison froide : avant d'allumer le premier feu, puis à la fin de l'hiver.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Planifier mon ramonage
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
        <div class="dr-regle__certif">
          <h3>Votre certificat de ramonage</h3>
          <ul class="dr-coches dr-coches--sombre">
            <li>Remis à la fin de l'intervention</li>
            <li>Indique le conduit ramoné et son état</li>
            <li>À présenter à votre assureur en cas de sinistre</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ DÉTAIL DES INTERVENTIONS ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Le détail de mes interventions de ramonage</h2>
        <p>Mes opérations d'entretien s'appliquent à tous vos équipements de chauffage.</p>
      </div>
      <ul class="dr-equip">
        {equipements.map((e) => (
          <li class="dr-equip__carte" data-anim="up">
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </li>
        ))}
      </ul>

      <div class="dr-duo dr-duo--inverse dr-methode" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/ramonage-brosse-conduit-cheminee-essonne.webp" alt="Ramonage mécanique d'un conduit de cheminée à la brosse depuis le foyer" width="901" height="600" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h3 class="dr-h3">Un ramonage mécanique, du pied au chapeau</h3>
          <p>Je retire la suie par action mécanique, avec une brosse de ramonage adaptée à votre conduit : c'est elle qui décolle réellement les dépôts et vous garantit un conduit sain.</p>
          <p>Mes vérifications portent sur l'ensemble de l'installation, du pied de la cheminée jusqu'au chapeau. Couvreur de métier, je contrôle en même temps la souche, le <a href="/zinguerie/solins-raccords/">solin de cheminée</a> et les tuiles qui l'entourent.</p>
          <p>Selon l'état du conduit, je vous recommande des opérations complémentaires : le débistrage (ou dégoudronnage), qui retire le bistre durci sur les parois, ou la pose d'un tubage, qui rend son étanchéité à un conduit fissuré ou usé.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ CONSEILS D'ENTRETIEN ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Mes conseils pour l'entretien courant de votre appareil</h2>
        <p>Entre deux ramonages, un entretien régulier de votre part préserve les performances de votre installation.</p>
      </div>
      <div class="dr-conseils">
        {conseils.map((c) => (
          <article class="dr-conseil" data-anim="up">
            <h3>{c.titre}</h3>
            <ul class="dr-puces">
              {c.points.map((p) => (<li>{p}</li>))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ L'ARTISAN ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur dr-artisan">
      <div class="dr-artisan__media" data-anim="fade">
        <img class="dr-artisan__img" src="/images/robert-daniel-artisan-couvreur-portrait.webp" alt="Robert Daniel, artisan couvreur et ramoneur dans l'Essonne, sur une toiture en tuiles" width="600" height="600" loading="lazy" decoding="async" />
      </div>
      <div class="dr-artisan__texte" data-anim="up">
        <h2 class="dr-h2">Le ramonage par un professionnel de la toiture</h2>
        <p>Le conduit de votre cheminée traverse votre toiture : un couvreur est le mieux placé pour le ramoner. Depuis plus de 15 ans, j'interviens sur les toits de l'Essonne et je connais les souches, les solins et chaque matériau de couverture.</p>
        <p>J'accède au conduit par le toit ou par le foyer, selon la configuration de votre installation, et je vous explique ce que j'ai constaté avant de vous remettre votre certificat. Si la souche ou les tuiles autour du conduit sont abîmées, je vous propose la <a href="/reparation-toiture/">réparation de la toiture</a>.</p>
        <div class="dr-garantie">
          <img src="/images/logo-allianz.png" alt="Allianz" width="96" height="60" loading="lazy" decoding="async" />
          <p><strong>Garantie décennale</strong> sur mes travaux de couverture, assurée par Allianz.</p>
        </div>
        <a href="/a-propos/" class="dr-btn dr-btn--bleu">
          En savoir plus
          <span class="dr-btn__fleche dr-btn__fleche--bleue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══ AVIS ══ -->
  <AvisGoogle titre="Les avis de mes clients sur le ramonage" ids={['linda-houali', 'marine-pommereau', 'arnaud-fauche']} fond="blanc" />

  <!-- ══ ZONE D'INTERVENTION ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <h2 class="dr-h2 dr-centre" data-anim="up">Les communes dans lesquelles j'interviens</h2>
      <ul class="dr-villes" data-anim="up">
        {villes.map((v) => (<li><a href={`/${v.slug}/`}>{v.nom}</a></li>))}
      </ul>
    </div>
  </section>

  <!-- ══ CTA FINAL (photo du camion) ══ -->
  <section class="dr-section dr-section--cta">
    <div class="conteneur">
      <div class="dr-cta" data-anim="up">
        <figure class="dr-cta__media">
          <img src="/images/vehicules-robert-daniel-couverture-essonne.webp" alt="Les camions de Robert Daniel Couverture, artisan couvreur et ramoneur dans l'Essonne" width="900" height="600" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-cta__corps">
          <h2>Faites ramoner votre cheminée dans l'Essonne</h2>
          <p>Le devis est gratuit et sans engagement.</p>
          <div class="dr-actions">
            <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
              Devis gratuit
              <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </a>
            <a href="tel:0683961518" class="dr-btn dr-btn--blanc">
              <svg class="dr-tel" viewBox="0 0 24 24" aria-hidden="true">
                <g class="dr-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g>
                <path class="dr-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <path class="dr-tel__onde dr-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              06 83 96 15 18
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Animations d'apparition (désactivées si l'utilisateur réduit les animations)
  const els = document.querySelectorAll('[data-anim]');
  if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    els.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  /* ── Jetons locaux (mêmes valeurs que la page d'accueil) ── */
  .dr-hero, .dr-section, .dr-bande {
    --nuit: #062a45;
    --rouge-clair: #ff4d42;
    --ombre-carte: 0 6px 20px rgb(0 73 123 / .07);
    --ombre-carte-hover: 0 16px 34px rgb(0 73 123 / .15);
    --ligne: #e2e6ea;
  }

  /* ── Apparitions ── */
  [data-anim] { opacity: 0; transition: opacity .7s ease, transform .7s ease; }
  [data-anim="up"] { transform: translate3d(0, 28px, 0); }
  [data-anim].is-visible { opacity: 1; transform: none; }

  /* ── Sections ── */
  .dr-section { padding-block: 88px; }
  .dr-section--gris { background: var(--gris-50); }
  .dr-section--serre { padding-top: 0; }
  @media (max-width: 1023px) { .dr-section { padding-block: 64px; } .dr-section--serre { padding-top: 0; } }
  @media (max-width: 767px)  { .dr-section { padding-block: 52px; } .dr-section--serre { padding-top: 0; } }
  .dr-centre { text-align: center; }
  .dr-h2 {
    font-family: var(--font-titres); font-weight: 700; color: var(--bleu-fonce);
    font-size: clamp(19px, .6rem + 2.6vw, 36px); line-height: 1.2; text-wrap: balance; margin: 0;
  }
  .dr-h3 {
    font-family: var(--font-titres); font-weight: 700; color: var(--bleu-fonce);
    font-size: clamp(19px, .85rem + .6vw, 23px); line-height: 1.3; margin: 0; text-wrap: balance;
  }
  .dr-entete { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; margin-bottom: 40px; }
  .dr-entete p { margin: 0; max-width: 640px; color: var(--gris-700); font-size: 17px; line-height: 1.6; }

  /* ── Boutons (pilule, jamais pleine largeur) ── */
  .dr-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .dr-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 12px;
    width: auto; max-width: max-content; min-height: 50px; padding: 14px 26px;
    border-radius: 999px; font-family: var(--font-titres); font-weight: 700; font-size: 16px;
    line-height: 1.2; text-decoration: none; white-space: nowrap;
    box-shadow: 0 4px 12px rgb(0 42 69 / .12);
    transition: background-color .25s ease, color .25s ease, transform .25s ease, box-shadow .25s ease;
  }
  .dr-btn:hover { transform: translate3d(0, -2px, 0); box-shadow: 0 10px 22px rgb(0 42 69 / .2); }
  .dr-btn--rouge { background: var(--cuivre); color: #fff; }
  .dr-btn--rouge:hover { background: var(--cuivre-fonce); color: #fff; }
  .dr-btn--bleu { background: var(--bleu); color: #fff; }
  .dr-btn--bleu:hover { background: var(--bleu-fonce); color: #fff; }
  .dr-btn--blanc { background: #fff; color: var(--bleu-fonce); }
  .dr-btn--blanc:hover { background: var(--gris-100); color: var(--bleu-fonce); }
  .dr-btn__fleche {
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
    width: 26px; height: 26px; border-radius: 50%; background: #fff; color: var(--cuivre); overflow: hidden;
  }
  .dr-btn__fleche--bleue { color: var(--bleu); }
  .dr-btn__fleche svg { width: 14px; height: 14px; transition: transform .3s ease; }
  .dr-btn:hover .dr-btn__fleche svg { transform: translate3d(3px, 0, 0); }
  @media (max-width: 767px) {
    .dr-btn { min-height: 46px; padding: 12px 18px; font-size: 15px; gap: 10px; }
  }

  /* Smartphone qui sonne */
  .dr-tel { width: 20px; height: 20px; flex-shrink: 0; overflow: visible; }
  .dr-tel__corps { transform-origin: 40% 50%; animation: dr-sonne 2.4s ease-in-out infinite; }
  .dr-tel__onde { opacity: 0; animation: dr-onde 2.4s ease-out infinite; }
  .dr-tel__onde--2 { animation-delay: .25s; }
  @keyframes dr-sonne {
    0%, 70%, 100% { transform: rotate(0); }
    75% { transform: rotate(-12deg); } 80% { transform: rotate(10deg); }
    85% { transform: rotate(-8deg); } 90% { transform: rotate(6deg); }
  }
  @keyframes dr-onde { 0%, 60% { opacity: 0; } 75% { opacity: 1; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .dr-tel__corps, .dr-tel__onde { animation: none; }
    .dr-tel__onde { opacity: 1; }
    [data-anim] { opacity: 1; transform: none; transition: none; }
  }

  /* ── Coches (pastille rouge + coche blanche) ── */
  .dr-coches { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .dr-coches li { position: relative; padding-left: 34px; color: #fff; font-weight: 600; font-size: 17px; line-height: 1.45; }
  .dr-coches li::before {
    content: ""; position: absolute; left: 0; top: 1px; width: 22px; height: 22px; border-radius: 50%;
