---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilAriane from '../../components/FilAriane.astro';
import CartesRealisations from '../../components/CartesRealisations.astro';
import realisations from '../../data/realisations.json';

const title = "Chantiers de couverture dans l'Essonne – Robert Daniel";
const description = "✓ Rénovation de toiture, faîtage, fenêtre de toit, gouttières : les chantiers de Robert Daniel, artisan couvreur dans l'Essonne. Tél. 06 83 96 15 18";
const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Réalisations de Robert Daniel Couverture',
  url: new URL('/realisations/', Astro.site).toString(),
  hasPart: realisations.map((r) => ({ '@type': 'ImageGallery', name: r.h1, url: new URL(r.url, Astro.site).toString() })),
}];
const tel = 'M16 1H8C6.34 1 5 2.34 5 4v16c0 1.66 1.34 3 3 3h8c1.66 0 3-1.34 3-3V4c0-1.66-1.34-3-3-3zm-2 20h-4v-1h4v1zm3.25-3H6.75V4h10.5v14z';
---
<BaseLayout title={title} description={description} extraSchemas={extraSchemas}>
  <section class="hero">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: 'Réalisations' }]} />
    </div>
    <div class="conteneur">
      <div class="prose prose--large">
      <h1 class="h1-long">Mes réalisations de couvreur dans l'Essonne</h1>
      <p class="hero__accroche">
        Chaque chantier est photographié du début à la fin. Vous voyez ainsi comment je travaille sur une
        <strong>toiture dans l'Essonne</strong> : la dépose, les étapes cachées une fois le toit fermé, et le résultat.
      </p>
      <p>
        Ces chantiers ont été menés près de mon bureau d'Étréchy, à <a href="/couvreur-etrechy/">Étréchy</a>,
        à <a href="/couvreur-auvers-saint-georges/">Auvers-Saint-Georges</a> et à
        <a href="/couvreur-janville-sur-juine/">Janville-sur-Juine</a>. Ils couvrent les travaux que l'on me confie
        le plus souvent : la <a href="/renovation-toiture/">rénovation de toiture</a>, la
        <a href="/reparation-toiture/">réparation d'un faîtage ou d'une couverture abîmée</a>, la
        <a href="/fenetre-de-toit-velux/">pose de fenêtres de toit</a> et l'entretien de la
        <a href="/zinguerie/">zinguerie</a>.
      </p>
      <div class="hero__actions">
        <a href="tel:0683961518" class="btn btn--cuivre">
          <svg class="icone-tel" viewBox="0 0 24 24" aria-hidden="true"><g class="icone-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g><path class="icone-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path class="icone-tel__onde icone-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          06 83 96 15 18
        </a>
        <a href="/devis-gratuit/" class="btn btn--bleu">Devis gratuit <span class="btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
      </div>
      </div>
    </div>
  </section>

  <CartesRealisations titre="Mes derniers chantiers" lienTout={false} fond="gris" />

  <section class="section section--bleu cta-final">
    <div class="conteneur">
      <h2>Faites appel à votre couvreur dans l'Essonne</h2>
      <p>Le devis est gratuit et sans engagement.</p>
      <div class="cta-final__actions">
        <a href="tel:0683961518" class="btn btn--cuivre">
          <svg class="icone-tel" viewBox="0 0 24 24" aria-hidden="true"><g class="icone-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g><path class="icone-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path class="icone-tel__onde icone-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          06 83 96 15 18
        </a>
        <a href="/devis-gratuit/" class="btn btn--blanc">Devis gratuit <span class="btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
      </div>
    </div>
  </section>
</BaseLayout>
