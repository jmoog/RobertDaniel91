---
// Page pilier « Rénovation de toiture » — refonte oct. 2026 au design de la
// page Ramonage (gabarit PageService). Intègre le remplacement complet de
// toiture (fusion anti-cannibalisation de juin 2026). Centrée sur l'Essonne.
import PageService from '../components/PageService.astro';
import CartesRealisations from '../components/CartesRealisations.astro';

const url = 'https://robert-daniel-couverture.fr/renovation-toiture/';
const title = "Rénovation de toiture dans l'Essonne (91) – Robert Daniel";
const description = "Rénovation et remplacement de toiture dans l'Essonne (91) : dépose, écran sous-toiture, liteaux et tuiles neuves. Garantie décennale. Robert Daniel.";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Rénovation de toiture',
  serviceType: 'Rénovation et remplacement de toiture',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url,
  image: 'https://robert-daniel-couverture.fr/images/renovation-toiture-pavillon-tuiles-essonne.jpg',
  description,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations de rénovation de toiture',
    itemListElement: [
      'Réfection complète de toiture',
      'Remplacement de couverture en tuiles ou en ardoises',
      'Pose d\'écran sous-toiture et de liteaux neufs',
      'Rénovation partielle d\'un pan de toiture',
      'Reprise du faîtage, des rives et de la zinguerie',
    ].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
  },
}];

const etapes = [
  { titre: 'Le diagnostic', texte: "J'examine la couverture, la charpente et la zinguerie, au besoin par une <a href=\"/inspection-toiture-drone/\">inspection de la toiture par drone</a>." },
  { titre: 'Le devis détaillé', texte: "Je vous remets un devis poste par poste : dépose, fournitures, pose, zinguerie et évacuation des gravats." },
  { titre: 'La dépose et le support', texte: "Je dépose l'ancienne couverture, je contrôle chaque chevron et je pose l'écran sous-toiture et les liteaux neufs." },
  { titre: 'La nouvelle couverture', texte: "Je pose les tuiles ou les ardoises rang par rang, puis je refais le faîtage, les rives et les raccords." },
];
---
<PageService
  title={title}
  description={description}
  extraSchemas={extraSchemas}
  ariane={[{ label: 'Accueil', href: '/' }, { label: 'Rénovation de toiture' }]}
  h1="Rénovation de toiture 91 –"
  hero={{ src: '/images/renovation-toiture-pavillon-tuiles-essonne.webp', alt: "Pavillon dont la toiture en tuiles a été entièrement refaite dans l'Essonne", width: 1200, height: 900 }}
  lead="La <strong>rénovation de votre toiture dans l'Essonne</strong> par un artisan couvreur qui maîtrise la tuile plate, la tuile mécanique et l'ardoise."
  coches={['Réfection complète ou partielle', 'Écran sous-toiture et liteaux neufs', 'Devis gratuit et détaillé']}
  bande={['Réfection complète', 'Remplacement de toiture', 'Tuiles et ardoises', 'Écran sous-toiture']}
  artisan={{
    titre: 'Votre toiture refaite par un couvreur expérimenté',
    html: `<p>Depuis plus de 15 ans, je rénove les toitures des maisons de l'Essonne. J'ai appris le métier sur les toits, auprès de mon père, et je suis présent sur chacun de mes chantiers, avec mon équipe, du premier jour à la réception des travaux.</p>
<p>Avant de vous proposer une réfection, je vous montre l'état réel de votre couverture et je vous explique ce qui doit être repris. Vous décidez en connaissance de cause, avec un devis clair et un engagement tenu sur les délais.</p>`,
  }}
  avis={{ titre: "Ils m'ont confié la rénovation de leur toiture", ids: ['line-lameth', 'micheline-bazin', 'anne-marie-allombert'] }}
  cta={{ titre: "Faites rénover votre toiture dans l'Essonne" }}
>

  <!-- ══ QUAND RÉNOVER ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-duo dr-duo--seul" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/renovation-toiture-ecran-sous-toiture-essonne.webp" alt="Écran sous-toiture et liteaux neufs posés avant la couverture lors d'une rénovation" width="1200" height="900" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h2 class="dr-h2">Quand faut-il rénover sa toiture ?</h2>
          <p>Une toiture vieillit sans bruit. Les tuiles deviennent poreuses ou se fendent avec le gel, les ardoises se délitent, le faîtage se descelle et l'écran sous-toiture, quand il existe, perd son efficacité. Les premières traces d'humidité dans les combles arrivent souvent bien après le début de l'usure.</p>
          <p>Selon l'âge du toit et l'étendue des dégâts, deux réponses sont possibles. La rénovation partielle reprend un pan exposé, les rives ou le faîtage quand la majeure partie de la couverture reste saine. La réfection complète devient le bon choix quand les fuites se répètent malgré les réparations, ou quand la couverture a dépassé quarante à cinquante ans.</p>
          <p>Comme <a href="/">entreprise de couverture dans l'Essonne</a>, je vous dis franchement laquelle des deux convient à votre maison, sans travaux inutiles.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ REMPLACEMENT COMPLET (carte bleu nuit) ══ -->
  <section class="dr-section dr-section--serre">
    <div class="conteneur">
      <article class="dr-regle" data-anim="up">
        <div class="dr-regle__corps">
          <h2>Le remplacement complet de la toiture</h2>
          <p>Remplacer une toiture, c'est repartir d'une base saine pour plusieurs décennies. Après la dépose de l'ancienne couverture, je contrôle les chevrons et je remplace les bois atteints. Si l'ossature montre des traces d'insectes ou d'humidité, je procède au <a href="/charpente/">traitement de la charpente</a> avant de refermer le toit.</p>
          <p>Je pose ensuite un écran sous-toiture, qui protège les combles et assure la ventilation, puis des liteaux neufs et la nouvelle couverture. Le faîtage, les rives, les solins et les raccords de zinguerie sont refaits dans la foulée : une toiture étanche tient autant à ses raccords qu'à ses tuiles.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Demander mon devis
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
        <div class="dr-regle__certif">
          <h3>Ce que comprend une réfection</h3>
          <ul class="dr-coches dr-coches--sombre">
            <li>Dépose et évacuation de l'ancienne couverture</li>
            <li>Contrôle et reprise de la charpente</li>
            <li>Écran sous-toiture, liteaux et tuiles neuves</li>
            <li>Faîtage, rives et zinguerie refaits</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ ÉTAPES ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Les étapes d'une rénovation de toiture</h2>
        <p>Un chantier de rénovation suit un ordre précis, que je vous présente avant de commencer.</p>
      </div>
      <ol class="dr-etapes">
        {etapes.map((e) => (
          <li class="dr-etape" data-anim="up">
            <h3>{e.titre}</h3>
            <p set:html={e.texte} />
          </li>
        ))}
      </ol>

      <div class="dr-duo dr-duo--inverse dr-methode" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/renovation-toiture-echafaudage-essonne.webp" alt="Échafaudage monté en façade pour la rénovation d'une toiture dans l'Essonne" width="1200" height="900" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h3 class="dr-h3">Un chantier organisé et tenu propre</h3>
          <p>L'échafaudage est monté en façade, les abords et le jardin sont protégés, puis les matériaux sont livrés au pied de la maison. Chaque soir, la toiture est laissée hors d'eau.</p>
          <p>Je vous tiens informé de l'avancement à chaque étape. Le chantier se termine par le nettoyage complet des abords et l'évacuation de tous les gravats : vous retrouvez une maison propre et un toit neuf.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ MATÉRIAUX ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Les matériaux de couverture que je pose</h2>
        <p>Le choix du matériau dépend de votre maison, de l'aspect recherché, de la pente du toit et de votre budget.</p>
      </div>
      <div class="dr-tableau-wrap" data-anim="up">
        <table class="dr-tableau">
          <thead><tr><th scope="col">Matériau</th><th scope="col">Bien adapté à</th><th scope="col">À retenir</th></tr></thead>
          <tbody>
            <tr><th scope="row">Tuile plate</th><td data-label="Bien adapté à">Maisons anciennes, toitures à forte pente</td><td data-label="À retenir">Aspect fin et traditionnel, pose minutieuse</td></tr>
            <tr><th scope="row">Tuile mécanique</th><td data-label="Bien adapté à">Pavillons, grandes surfaces</td><td data-label="À retenir">Pose rapide, très bon rapport qualité-prix</td></tr>
            <tr><th scope="row">Ardoise</th><td data-label="Bien adapté à">Toitures pentues, maisons de caractère</td><td data-label="À retenir">Grande longévité, rendu élégant</td></tr>
            <tr><th scope="row">Zinc</th><td data-label="Bien adapté à">Noues, rives, lucarnes et petits pans</td><td data-label="À retenir">Étanchéité durable des points sensibles</td></tr>
          </tbody>
        </table>
      </div>
      <div class="dr-texte dr-apres" data-anim="up">
        <p>Une rénovation est aussi le bon moment pour remplacer la zinguerie fatiguée. Je façonne et je pose des <a href="/zinguerie/gouttieres-zinc/">gouttières en zinc</a> sur mesure, ainsi que les descentes, les noues et les solins qui assurent l'étanchéité de votre nouvelle couverture.</p>
      </div>
    </div>
  </section>

  <!-- ══ AMÉLIORER LA MAISON ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Profitez de la rénovation pour améliorer votre maison</h2>
        <p>Quand la couverture est ouverte, certains travaux se font plus simplement et pour moins cher.</p>
      </div>
      <div class="dr-conseils">
        <article class="dr-conseil" data-anim="up">
          <h3>Isoler par l'extérieur</h3>
          <ul class="dr-puces">
            <li>L'<a href="/isolation-toiture/">isolation de la toiture par l'extérieur</a> se pose sur les chevrons, sous la nouvelle couverture.</li>
            <li>Vous gardez tout le volume de vos combles.</li>
            <li>Les ponts thermiques sont supprimés et le confort se ressent dès le premier hiver.</li>
          </ul>
        </article>
        <article class="dr-conseil" data-anim="up">
          <h3>Ajouter une fenêtre de toit</h3>
          <ul class="dr-puces">
            <li>L'ouverture se crée sans reprise de couverture supplémentaire.</li>
            <li>Le raccord d'étanchéité s'intègre directement aux tuiles neuves.</li>
            <li>Une pièce sous les combles gagne en lumière et en aération.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ══ RÉALISATIONS ══ -->
  <CartesRealisations
    slugs={['refection-toiture-morigny-champigny', 'remplacement-toiture-ormoy-la-riviere', 'toiture-hydrofuge-brieres-les-scelles', 'renovation-toiture-auvers-saint-georges', 'renovation-toiture-etrechy']}
    titre="Mes chantiers de rénovation de toiture"
    intro="Chaque chantier est présenté en photos, de la dépose de l'ancienne couverture à la toiture terminée."
    fond="blanc"
    centre
    lienTout={false}
  />
</PageService>
