---
// Page pilier « Réparation de toiture » — refonte oct. 2026 au design de la
// page Ramonage (gabarit PageService). Centrée sur l'Essonne.
import PageService from '../components/PageService.astro';
import CartesRealisations from '../components/CartesRealisations.astro';

const url = 'https://robert-daniel-couverture.fr/reparation-toiture/';
const title = "Réparation de toiture dans l'Essonne (91) – Robert Daniel";
const description = "Fuite, tuile cassée, faîtage descellé : réparation de toiture dans l'Essonne (91) par un couvreur. Garantie décennale, devis gratuit. Robert Daniel.";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Réparation de toiture',
  serviceType: 'Réparation de toiture et recherche de fuite',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url,
  image: 'https://robert-daniel-couverture.fr/images/reparation-toiture-faitage-essonne.jpg',
  description,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations de réparation de toiture',
    itemListElement: [
      'Recherche de fuite',
      'Remplacement de tuiles et d\'ardoises',
      'Réfection de faîtage et d\'arêtiers',
      'Reprise des rives',
      'Réfection de solins et de noues',
    ].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
  },
}];

const reparations = [
  { titre: 'Tuiles et ardoises', texte: "Remplacement des tuiles fendues, poreuses ou glissées, et des ardoises cassées, avec des modèles identiques à votre couverture." },
  { titre: 'Faîtage et arêtiers', texte: "Dépose des faîtières descellées, pose d'un closoir neuf et repose du faîtage, sur la ligne la plus exposée du toit." },
  { titre: 'Rives', texte: "Reprise des tuiles de rive et de leurs fixations, souvent arrachées par le vent sur les pignons." },
  { titre: 'Solins et souches', texte: "Réfection de l'étanchéité autour des cheminées et contre les murs, là où naissent beaucoup d'infiltrations." },
  { titre: 'Noues', texte: "Nettoyage et réfection des noues, ces angles rentrants qui reçoivent l'eau de deux pans de toiture." },
  { titre: 'Écran sous-toiture', texte: "Remplacement de l'écran abîmé sur la zone de la fuite, pour retrouver une protection continue." },
];
---
<PageService
  title={title}
  description={description}
  extraSchemas={extraSchemas}
  ariane={[{ label: 'Accueil', href: '/' }, { label: 'Réparation de toiture' }]}
  h1="Réparation de toiture 91 –"
  hero={{ src: '/images/reparation-toiture-faitage-essonne.webp', alt: "Faîtage refait sur une toiture en tuiles dans l'Essonne", width: 1000, height: 750 }}
  lead="Une fuite, une tuile cassée, une tache au plafond ? La <strong>réparation de votre toiture dans l'Essonne</strong> commence par trouver l'origine du problème."
  coches={['Recherche de fuite précise', 'Intervention rapide en cas de fuite', 'Devis gratuit et sans engagement']}
  bande={['Recherche de fuite', 'Tuiles et ardoises', 'Faîtage et rives', 'Solins et noues']}
  artisan={{
    titre: 'Un couvreur expérimenté pour réparer votre toit',
    html: `<p>Depuis plus de 15 ans, je répare les toitures de l'Essonne : tuile plate, tuile mécanique, ardoise et zinc. Cette expérience me permet de reconnaître vite un faîtage fatigué, un solin mal raccordé ou une noue encrassée, et de choisir la réparation qui dure.</p>
<p>Si vous êtes victime d'une fuite, appelez-moi directement sur mon portable : j'interviens rapidement pour mettre votre toiture hors d'eau, puis je vous remets un devis pour la réparation définitive.</p>`,
  }}
  avis={{ titre: 'Les avis de mes clients après une réparation', ids: ['fanfan-crepin', 'zoro-aaron', 'emmeline-renelus'] }}
  cta={{ titre: "Faites réparer votre toiture dans l'Essonne", img: { src: '/images/vehicule-robert-daniel-reparation-toiture-essonne.webp', alt: "Véhicule de Robert Daniel Couverture devant une maison pour une réparation de toiture dans l'Essonne", width: 1000, height: 750 } }}
>

  <!-- ══ UNE FUITE ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-duo dr-duo--seul" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/reparation-toiture-couverture-abimee-essonne.webp" alt="Couverture en tuiles abîmée et envahie par la mousse avant réparation" width="1200" height="900" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h2 class="dr-h2">Une fuite ne s'arrange jamais seule</h2>
          <p>L'eau qui passe par une tuile déplacée ou un solin fissuré ne reste pas sur la couverture. Elle s'infiltre dans la charpente, mouille l'isolant et finit par marquer les plafonds. Plus on attend, plus la réparation devient lourde.</p>
          <p>Dès les premières traces d'humidité, mieux vaut faire intervenir un <a href="/">couvreur dans l'Essonne</a>. Une tuile remplacée à temps évite de refaire un plafond, de changer un isolant gorgé d'eau ou de traiter des bois qui ont commencé à pourrir.</p>
          <p>Je vous explique ce qui est urgent et ce qui peut attendre : vous gardez la main sur les travaux et sur votre budget.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ RECHERCHE DE FUITE (carte bleu nuit) ══ -->
  <section class="dr-section dr-section--serre">
    <div class="conteneur">
      <article class="dr-regle" data-anim="up">
        <div class="dr-regle__corps">
          <h2 id="recherche-de-fuite">Recherche de fuite : trouver l'origine</h2>
          <p>Le point d'entrée de l'eau est rarement à l'aplomb de la tache au plafond. L'eau suit les chevrons et l'écran sous-toiture avant de goutter plus loin. Je remonte donc le chemin de l'eau, pan par pan, pour trouver le vrai défaut.</p>
          <p>Sur une toiture fragile ou difficile d'accès, je commence par une <a href="/inspection-toiture-drone/">inspection de toiture par drone</a>. Les images montrent la zone défaillante sans abîmer la couverture, et vous voyez vous-même ce qui doit être repris.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Signaler ma fuite
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
        <div class="dr-regle__certif">
          <h3>Les origines les plus fréquentes</h3>
          <ul class="dr-coches dr-coches--sombre">
            <li>Tuile fêlée, poreuse ou glissée</li>
            <li>Faîtage ou rive descellés</li>
            <li>Solin de cheminée fissuré</li>
            <li>Noue encrassée ou percée</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ RÉPARATIONS ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Les réparations de toiture que je réalise</h2>
        <p>La plupart des fuites se règlent par une intervention ciblée, sans refaire tout le toit.</p>
      </div>
      <ul class="dr-equip">
        {reparations.map((r) => (
          <li class="dr-equip__carte" data-anim="up">
            <h3>{r.titre}</h3>
            <p>{r.texte}</p>
          </li>
        ))}
      </ul>

      <div class="dr-duo dr-duo--inverse dr-methode" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/reparation-toiture-souche-cheminee-essonne.webp" alt="Souche de cheminée reprise et solin refait sur une toiture en tuiles" width="750" height="1000" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h3 class="dr-h3">Une réparation durable, pas une rustine</h3>
          <p>Je remplace les éléments défaillants par des matériaux identiques à votre couverture, puis je contrôle les zones voisines pour éviter qu'une autre faiblesse ne se réveille à la pluie suivante.</p>
          <p>Autour d'une cheminée, je refais le <a href="/zinguerie/solins-raccords/">solin en zinc</a> plutôt qu'un simple joint de mortier, qui se fissure dès le premier hiver. Le chantier se termine par la vérification de l'écoulement de l'eau et le nettoyage des abords.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ GALERIE ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Quelques réparations récentes dans l'Essonne</h2>
        <p>Souche, faîtage, arêtier : les points sensibles d'une toiture, repris pour qu'elle reste étanche.</p>
      </div>
      <ul class="dr-galerie" data-anim="up">
        <li><figure><img src="/images/reparation-toiture-souche-cheminee-essonne.webp" alt="Souche de cheminée et solin repris sur une toiture dans l'Essonne" width="750" height="1000" loading="lazy" decoding="async" /><figcaption>Souche de cheminée et solin repris</figcaption></figure></li>
        <li><figure><img src="/images/reparation-toiture-faitage-essonne.webp" alt="Faîtage rénové sur une toiture en tuiles dans l'Essonne" width="1000" height="750" loading="lazy" decoding="async" /><figcaption>Faîtage refait sur une toiture en tuiles</figcaption></figure></li>
        <li><figure><img src="/images/reparation-toiture-aretier-essonne.webp" alt="Arêtier et tuiles faîtières remis à neuf dans l'Essonne" width="750" height="1000" loading="lazy" decoding="async" /><figcaption>Arêtier et tuiles faîtières remis à neuf</figcaption></figure></li>
      </ul>
    </div>
  </section>

  <!-- ══ RÉPARER OU RÉNOVER ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <h2 class="dr-h2 dr-centre" data-anim="up">Réparer ou rénover : un avis honnête</h2>
      <div class="dr-texte dr-apres" data-anim="up">
        <p>Une réparation a du sens tant que la couverture reste saine dans son ensemble. Quand les tuiles sont poreuses sur tout le toit, que les fuites reviennent d'une saison à l'autre ou que l'écran sous-toiture a vécu, une succession de réparations finit par coûter plus cher qu'une réfection.</p>
        <p>Dans ce cas, je vous le dis sans détour et je vous présente, devis à l'appui, ce que représenterait une <a href="/renovation-toiture/">rénovation complète de la toiture</a>. Vous comparez les deux solutions et vous choisissez en connaissance de cause.</p>
        <p>Pour ralentir l'usure d'une couverture encore saine, un démoussage tous les quelques années et des gouttières dégagées restent les meilleurs entretiens.</p>
      </div>
    </div>
  </section>

  <!-- ══ RÉALISATION ══ -->
  <CartesRealisations
    slugs={['refection-faitage-etrechy']}
    titre="Une réparation de toiture en images"
    intro="Faîtières déposées, closoir neuf et faîtage reposé : le chantier, étape par étape."
    fond="blanc"
    centre
    lienTout={false}
  />
</PageService>
