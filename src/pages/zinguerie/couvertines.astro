---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilAriane from '../../components/FilAriane.astro';
import CtaDevis from '../../components/CtaDevis.astro';
import villes from '../../data/villes.json';

const title = "Couvertines dans l'Essonne (91) - Robert Daniel Couverture";
const description = "Pose et remplacement de couvertines à Étréchy et dans l'Essonne. Protection des acroteres et murets. Devis gratuit.";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Couvertines',
  serviceType: 'Zinguerie',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url: 'https://robert-daniel-couverture.fr/zinguerie/couvertines/',
  description,
}];
---
<BaseLayout title={title} description={description} extraSchemas={extraSchemas}>
  <section class="hero">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: 'Zinguerie', href: '/zinguerie/' }, { label: 'Couvertines' }]} />
    </div>
    <div class="conteneur hero__grille">
      <div class="hero__texte">
        <h1>Couvertines dans l'Essonne</h1>
        <p class="hero__accroche">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
        <ul>
          <li><strong>Lorem ipsum</strong> dolor sit amet.</li>
          <li><strong>Consectetur</strong> adipiscing elit.</li>
          <li><strong>Garantie décennale</strong> sur tous nos travaux.</li>
        </ul>
        <div class="hero__actions">
          <a href="tel:0683961518" class="btn btn--cuivre">
            <svg class="icone-tel" viewBox="0 0 24 24" aria-hidden="true"><g class="icone-tel__corps"><path fill="currentColor" d="M14 1H6C4.9 1 4 1.9 4 3v18c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm-4 21c-.8 0-1.5-.7-1.5-1.5S9.2 19 10 19s1.5.7 1.5 1.5S10.8 22 10 22zm4-4H6V4h8v14z"/></g><path class="icone-tel__onde" d="M18.5 8.5a4 4 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path class="icone-tel__onde icone-tel__onde--2" d="M21 6a7.5 7.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            06 83 96 15 18
          </a>
          <a href="/devis-gratuit/" class="btn btn--bleu">Devis gratuit <span class="btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
        </div>
      </div>
      <div class="hero__media">
        <div class="placeholder-img hero__photo">Photo Couvertines</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="conteneur duo">
      <div class="placeholder-img">Photo Couvertines detail</div>
      <div class="prose">
        <h2>Lorem ipsum dolor sit amet</h2>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.</p>
        <p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</p>
      </div>
    </div>
  </section>

  <section class="section section--bleute">
    <div class="conteneur duo duo--inverse">
      <div class="placeholder-img">Photo Couvertines chantier</div>
      <div class="prose">
        <h2>Lorem ipsum dolor sit amet consectetur</h2>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nemo enim ipsam voluptatem quia voluptas sit aspernatur.</p>
        <ul>
          <li>Lorem ipsum dolor sit amet.</li>
          <li>Consectetur adipiscing elit.</li>
          <li>Sed do eiusmod tempor.</li>
        </ul>
        <a href="/zinguerie/" class="btn btn--bleu">Tous nos services zinguerie <span class="btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
      </div>
    </div>
  </section>

  <CtaDevis />

  <section class="section section--gris">
    <div class="conteneur">
      <h2>Couvertines — nos communes</h2>
      <ul class="nuage-villes">
        {villes.map((v) => (
          <li><a href={`/${v.slug}/`}>{v.nom}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
