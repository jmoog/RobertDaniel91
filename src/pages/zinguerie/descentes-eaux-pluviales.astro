---
// Sous-page du cocon zinguerie — rédigée oct. 2026 (gabarit PageService).
import PageService from '../../components/PageService.astro';
import ZinguerieLiees from '../../components/ZinguerieLiees.astro';

const url = 'https://robert-daniel-couverture.fr/zinguerie/descentes-eaux-pluviales/';
const title = "Descentes d'eaux pluviales Essonne (91) – Robert Daniel";
const description = "Pose et remplacement de descentes d'eaux pluviales dans l'Essonne (91) : zinc, aluminium ou PVC, coudes, dauphins et raccordement. Robert Daniel, couvreur.";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: "Descentes d'eaux pluviales",
  serviceType: "Pose et remplacement de descentes d'eaux pluviales",
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  isRelatedTo: { '@id': 'https://robert-daniel-couverture.fr/zinguerie/#service' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url,
  image: 'https://robert-daniel-couverture.fr/images/zinguerie-gouttiere-descente-zinc-essonne.jpg',
  description,
}];

const problemes = [
  { titre: 'Une descente bouchée', texte: "Feuilles, mousses et débris de tuiles bouchent le tuyau : la gouttière déborde à chaque averse. Je débouche et je pose une crapaudine qui retient les feuilles." },
  { titre: 'Un raccord qui fuit', texte: "Un coude mal emboîté ou une naissance décollée laisse l'eau couler le long du mur. Je refais le raccord pour un écoulement étanche." },
  { titre: 'Un tuyau abîmé', texte: "Un tuyau fendu, enfoncé ou dont les colliers ont lâché ne guide plus l'eau. Je remplace l'élément et je refixe la descente d'aplomb." },
];
---
<PageService
  title={title}
  description={description}
  extraSchemas={extraSchemas}
  ariane={[{ label: 'Accueil', href: '/' }, { label: 'Zinguerie', href: '/zinguerie/' }, { label: "Descentes d'eaux pluviales" }]}
  h1="Descentes pluviales 91 –"
  hero={{ src: '/images/zinguerie-gouttiere-descente-zinc-essonne.webp', alt: "Gouttière et descente d'eaux pluviales en zinc sur une façade de l'Essonne", width: 1100, height: 825 }}
  lead="La <strong>pose de descentes d'eaux pluviales dans l'Essonne</strong>, de la gouttière jusqu'au sol ou au réseau, par un couvreur zingueur."
  coches={['Zinc, aluminium ou PVC', 'Raccordement au regard ou au réseau', 'Devis gratuit et sans engagement']}
  bande={['Tuyaux de descente', 'Coudes et raccords', 'Dauphins', 'Crapaudines']}
  artisan={{
    titre: "L'eau conduite là où elle doit aller",
    html: `<p>Depuis plus de 15 ans, je pose et je répare la zinguerie des maisons de l'Essonne. Une descente bien placée, bien dimensionnée et bien fixée protège vos murs et vos fondations pendant des années.</p>
<p>Je contrôle l'ensemble du circuit de l'eau, de la gouttière au regard, et je vous explique ce qui doit être repris. Vous recevez ensuite un devis clair, élément par élément.</p>`,
  }}
  avis={{ titre: 'Les avis de mes clients', ids: ['theyoyo91000', 'franco-zagaroli', 'laurence-dujardin'] }}
  cta={{ titre: "Faites refaire vos descentes d'eaux pluviales" }}
>

  <!-- ══ RÔLE ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-duo dr-duo--seul" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/realisations/entretien-gouttieres-janville-sur-juine/entretien-gouttieres-janville-sur-juine-02.webp" alt="Contrôle des gouttières et des descentes sur une maison en meulière de l'Essonne" width="1200" height="900" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h2 class="dr-h2">Conduire l'eau du toit jusqu'au sol</h2>
          <p>La descente reçoit l'eau collectée par la gouttière et la conduit jusqu'au sol, à un regard ou au réseau d'eaux pluviales. C'est le dernier maillon de la <a href="/zinguerie/">zinguerie de la maison</a>, et souvent le plus négligé.</p>
          <p>Une descente bouchée, percée ou mal raccordée fait déborder la gouttière. L'eau ruisselle alors le long de la façade, marque l'enduit et finit par humidifier le pied des murs et les fondations.</p>
          <p>Quelques signes doivent alerter : des coulures sur la façade, une flaque permanente au pied du mur ou une gouttière qui déborde à chaque averse.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ DIMENSIONNEMENT (carte bleu nuit) ══ -->
  <section class="dr-section dr-section--serre">
    <div class="conteneur">
      <article class="dr-regle" data-anim="up">
        <div class="dr-regle__corps">
          <h2>Une descente bien dimensionnée et bien fixée</h2>
          <p>Le diamètre et le nombre de descentes dépendent de la surface de toiture à évacuer. Une descente trop petite ou trop éloignée de la gouttière ne suffit pas lors d'un orage.</p>
          <p>Je fixe la descente d'aplomb avec des colliers solides, je protège le bas du tuyau par un dauphin en fonte quand il est exposé aux chocs, et je raccorde l'ensemble au regard ou au réseau. En tête de descente, une crapaudine retient les feuilles.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Demander mon devis
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
        <div class="dr-regle__certif">
          <h3>Les éléments d'une descente</h3>
          <ul class="dr-coches dr-coches--sombre">
            <li>Naissance raccordée à la gouttière</li>
            <li>Coudes et tuyaux</li>
            <li>Colliers de fixation</li>
            <li>Dauphin et raccord au regard</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ PROBLÈMES ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Les problèmes que je règle</h2>
        <p>La plupart des désordres se réparent sans changer toute la descente.</p>
      </div>
      <ul class="dr-equip">
        {problemes.map((p) => (
          <li class="dr-equip__carte" data-anim="up">
            <h3>{p.titre}</h3>
            <p>{p.texte}</p>
          </li>
        ))}
      </ul>
      <div class="dr-texte dr-apres" data-anim="up">
        <p>Je pose des descentes en zinc, en aluminium ou en PVC, dans le même matériau que la gouttière. Pour une maison traditionnelle, l'ensemble formé par une <a href="/zinguerie/gouttieres-zinc/">gouttière en zinc</a> et sa descente soudée reste la solution la plus durable.</p>
      </div>
    </div>
  </section>

  <ZinguerieLiees slugs={['gouttieres-zinc', 'gouttieres-aluminium', 'gouttieres-pvc']} titre="Les gouttières que je pose" />
</PageService>
