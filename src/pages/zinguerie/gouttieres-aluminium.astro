---
// Sous-page du cocon zinguerie — rédigée oct. 2026 (gabarit PageService).
import PageService from '../../components/PageService.astro';
import ZinguerieLiees from '../../components/ZinguerieLiees.astro';

const url = 'https://robert-daniel-couverture.fr/zinguerie/gouttieres-aluminium/';
const title = "Gouttières en aluminium dans l'Essonne (91) – Robert Daniel";
const description = "Gouttières en aluminium dans l'Essonne (91) : profilées en une seule longueur, sans raccord, laquées dans de nombreux coloris. Robert Daniel, couvreur.";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Gouttières en aluminium',
  serviceType: 'Pose de gouttières en aluminium sans raccord',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  isRelatedTo: { '@id': 'https://robert-daniel-couverture.fr/zinguerie/#service' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url,
  image: 'https://robert-daniel-couverture.fr/images/gouttiere-aluminium-profilage-essonne.jpg',
  description,
}];

const etapes = [
  { titre: "La dépose de l'ancienne gouttière", texte: "Je dépose l'ancienne gouttière en zinc ou en PVC, je contrôle la planche de rive et je remplace les crochets si besoin." },
  { titre: 'Le profilage et la pose', texte: "La gouttière est profilée à la longueur exacte de votre façade, puis posée d'un seul tenant avec une pente régulière." },
  { titre: 'Le raccordement', texte: "Je pose les naissances, les angles et les fonds, puis je raccorde la gouttière aux descentes et je contrôle l'écoulement." },
];
---
<PageService
  title={title}
  description={description}
  extraSchemas={extraSchemas}
  ariane={[{ label: 'Accueil', href: '/' }, { label: 'Zinguerie', href: '/zinguerie/' }, { label: 'Gouttières en aluminium' }]}
  h1="Gouttières alu 91 –"
  hero={{ src: '/images/gouttiere-aluminium-profilage-essonne.webp', alt: "Gouttière en aluminium profilée en une seule longueur devant le camion de l'entreprise", width: 900, height: 1200, position: 'center 40%' }}
  lead="La <strong>pose de gouttières en aluminium dans l'Essonne</strong>, profilées en continu et sans raccord par un couvreur zingueur."
  coches={['Une seule longueur, sans raccord', 'Nombreux coloris laqués', 'Devis gratuit et sans engagement']}
  bande={['Profilage en continu', 'Coloris laqués', 'Entretien réduit', 'Remplacement de zinc ou de PVC']}
  artisan={{
    titre: 'Une pose réalisée par un couvreur zingueur',
    html: `<p>Depuis plus de 15 ans, je pose des gouttières sur les maisons de l'Essonne, en zinc, en aluminium et en PVC. Je connais les atouts de chaque matériau et je vous conseille celui qui convient à votre façade et à votre budget.</p>
<p>Une gouttière, même sans raccord, ne fonctionne bien qu'avec une pente juste et des fixations solides. C'est là que l'expérience d'un couvreur fait la différence.</p>`,
  }}
  avis={{ titre: 'Ils ont fait refaire leurs gouttières', ids: ['michelle-francois', 'sylvain-perrey', 'megg-geuffroy'] }}
  cta={{ titre: 'Faites poser vos gouttières en aluminium' }}
>

  <!-- ══ SANS RACCORD ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-duo dr-duo--seul" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/gouttiere-toiture-tuiles-essonne.webp" alt="Gouttière posée en bas de pente d'une toiture en tuiles dans l'Essonne" width="1200" height="900" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h2 class="dr-h2">Une gouttière sans raccord, profilée en continu</h2>
          <p>La gouttière en aluminium est formée à partir d'une bobine, à la longueur exacte de votre façade. Elle est posée d'un seul tenant, sans raccord entre deux éléments : moins de jonctions, c'est moins de points faibles et moins de risques de fuite.</p>
          <p>L'aluminium est léger, ne rouille pas et ne demande pas de peinture. Sa finition laquée garde ses couleurs pendant de longues années.</p>
          <p>C'est une solution que je propose parmi mes <a href="/zinguerie/">travaux de zinguerie</a>, en particulier pour les grandes longueurs et les façades contemporaines.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ COLORIS (carte bleu nuit) ══ -->
  <section class="dr-section dr-section--serre">
    <div class="conteneur">
      <article class="dr-regle" data-anim="up">
        <div class="dr-regle__corps">
          <h2>Une gouttière assortie à votre maison</h2>
          <p>L'aluminium laqué existe dans de nombreuses teintes : blanc, gris, anthracite, brun ou couleurs proches des menuiseries. La gouttière s'accorde à vos volets, à vos fenêtres ou à votre façade.</p>
          <p>Les descentes, les coudes et les accessoires sont proposés dans la même teinte, pour un ensemble harmonieux de la gouttière jusqu'au sol.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Demander mon devis
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
        <div class="dr-regle__certif">
          <h3>Les atouts de l'aluminium</h3>
          <ul class="dr-coches dr-coches--sombre">
            <li>Pas de raccord sur la longueur</li>
            <li>Ne rouille pas, ne se peint pas</li>
            <li>Coloris assortis aux menuiseries</li>
            <li>Léger et peu d'entretien</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ ÉTAPES ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Le remplacement de vos gouttières</h2>
        <p>Un chantier rapide et propre, sans toucher à votre couverture.</p>
      </div>
      <ol class="dr-etapes dr-etapes--3">
        {etapes.map((e) => (
          <li class="dr-etape" data-anim="up">
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </li>
        ))}
      </ol>
      <div class="dr-texte dr-apres" data-anim="up">
        <p>Sur une maison ancienne ou une toiture de caractère, je vous conseille plutôt des <a href="/zinguerie/gouttieres-zinc/">gouttières en zinc</a>, soudées sur mesure, qui s'accordent mieux à la tuile plate et à l'ardoise. Je vous présente les deux solutions avant de vous remettre mon devis.</p>
      </div>
    </div>
  </section>

  <ZinguerieLiees slugs={['gouttieres-pvc', 'descentes-eaux-pluviales', 'couvertines']} />
</PageService>
