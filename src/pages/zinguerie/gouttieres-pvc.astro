---
// Sous-page du cocon zinguerie — rédigée oct. 2026 (gabarit PageService).
import PageService from '../../components/PageService.astro';
import ZinguerieLiees from '../../components/ZinguerieLiees.astro';

const url = 'https://robert-daniel-couverture.fr/zinguerie/gouttieres-pvc/';
const title = "Gouttières en PVC dans l'Essonne (91) – Robert Daniel";
const description = "Pose et remplacement de gouttières en PVC dans l'Essonne (91) : une solution légère et économique pour les petites toitures et les annexes. Robert Daniel.";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Gouttières en PVC',
  serviceType: 'Pose et remplacement de gouttières en PVC',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  isRelatedTo: { '@id': 'https://robert-daniel-couverture.fr/zinguerie/#service' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url,
  image: 'https://robert-daniel-couverture.fr/images/zinguerie-toiture-tuiles-essonne.jpg',
  description,
}];
---
<PageService
  title={title}
  description={description}
  extraSchemas={extraSchemas}
  ariane={[{ label: 'Accueil', href: '/' }, { label: 'Zinguerie', href: '/zinguerie/' }, { label: 'Gouttières en PVC' }]}
  h1="Gouttières PVC 91 –"
  hero={{ src: '/images/zinguerie-toiture-tuiles-essonne.webp', alt: "Maison de l'Essonne avec sa toiture en tuiles et ses gouttières", width: 1100, height: 825 }}
  lead="La <strong>pose de gouttières en PVC dans l'Essonne</strong> : une solution légère et économique, posée dans les règles par un couvreur."
  coches={['Solution économique', 'Pose rapide et propre', 'Devis gratuit et sans engagement']}
  bande={['Petites toitures', 'Garages et abris', 'Extensions', 'Remplacement']}
  artisan={{
    titre: 'Un conseil honnête sur le bon matériau',
    html: `<p>Depuis plus de 15 ans, je pose des gouttières sur les maisons de l'Essonne. Le PVC a toute sa place sur un garage, un abri ou une petite extension, et je vous le propose quand il répond vraiment à votre besoin.</p>
<p>Quand votre maison mérite un matériau plus durable, je vous le dis aussi, et je vous présente les deux solutions avec leur prix pour que vous choisissiez en connaissance de cause.</p>`,
  }}
  avis={{ titre: 'Les avis de mes clients', ids: ['a-charpentier', 'stephane-boulay', 'catherine-francois'] }}
  cta={{ titre: "Faites poser vos gouttières en PVC dans l'Essonne" }}
>

  <!-- ══ LE PVC ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-duo dr-duo--seul" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/realisations/entretien-gouttieres-janville-sur-juine/entretien-gouttieres-janville-sur-juine-03.webp" alt="Gouttière dégagée et contrôlée en bas de pente d'une toiture" width="900" height="1200" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h2 class="dr-h2">Le PVC, une solution légère et économique</h2>
          <p>La gouttière en PVC est la plus abordable des gouttières. Légère, elle se pose rapidement et se raccorde par emboîtement et collage. Elle ne rouille pas et ne demande pas de peinture.</p>
          <p>Elle convient bien aux petites toitures : un garage, un abri de jardin, un auvent ou une extension. Sur ces ouvrages, le PVC offre un très bon rapport qualité-prix.</p>
          <p>Comme tous les ouvrages de <a href="/zinguerie/">zinguerie</a>, une gouttière en PVC doit être posée avec une pente juste et des fixations solides pour évacuer l'eau sans déborder.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ DILATATION (carte bleu nuit) ══ -->
  <section class="dr-section dr-section--serre">
    <div class="conteneur">
      <article class="dr-regle" data-anim="up">
        <div class="dr-regle__corps">
          <h2>Une pose qui tient compte de la dilatation</h2>
          <p>Le PVC se dilate fortement à la chaleur. Une gouttière collée bout à bout sans précaution se déforme au soleil, puis se fend ou se décroche. Je prévois des jonctions de dilatation et des crochets rapprochés qui laissent la gouttière travailler.</p>
          <p>Je veille aussi à la pente vers les descentes et l'étanchéité des naissances : ce sont elles qui font qu'une gouttière en PVC fonctionne bien pendant des années.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Demander mon devis
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
        <div class="dr-regle__certif">
          <h3>Pour une gouttière PVC durable</h3>
          <ul class="dr-coches dr-coches--sombre">
            <li>Jonctions de dilatation</li>
            <li>Crochets rapprochés et bien fixés</li>
            <li>Pente régulière vers les descentes</li>
            <li>Naissances étanches</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ QUEL MATÉRIAU ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">PVC, aluminium ou zinc ?</h2>
        <p>Le PVC n'est pas le bon choix pour toutes les maisons.</p>
      </div>
      <div class="dr-conseils">
        <article class="dr-conseil" data-anim="up">
          <h3>Quand choisir le PVC</h3>
          <ul class="dr-puces">
            <li>Pour un garage, un abri de jardin ou une petite extension.</li>
            <li>Pour un budget serré, sur une façade peu exposée.</li>
            <li>Pour remplacer à l'identique une gouttière en PVC existante.</li>
          </ul>
        </article>
        <article class="dr-conseil" data-anim="up">
          <h3>Quand préférer un autre matériau</h3>
          <ul class="dr-puces">
            <li>Sur une façade très exposée au soleil, où le PVC se déforme et se décolore.</li>
            <li>Sur une grande longueur, où des <a href="/zinguerie/gouttieres-aluminium/">gouttières en aluminium</a> sans raccord sont plus fiables.</li>
            <li>Sur une maison de caractère, où le zinc s'accorde mieux à la toiture.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <ZinguerieLiees slugs={['gouttieres-zinc', 'gouttieres-aluminium', 'descentes-eaux-pluviales']} />
</PageService>
