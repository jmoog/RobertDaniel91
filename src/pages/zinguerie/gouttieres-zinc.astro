---
// Sous-page du cocon zinguerie — rédigée oct. 2026 (gabarit PageService).
import PageService from '../../components/PageService.astro';
import ZinguerieLiees from '../../components/ZinguerieLiees.astro';

const url = 'https://robert-daniel-couverture.fr/zinguerie/gouttieres-zinc/';
const title = "Gouttières en zinc dans l'Essonne (91) – Robert Daniel";
const description = "Pose et remplacement de gouttières en zinc dans l'Essonne (91) : zinc naturel ou prépatiné, demi-rondes ou moulurées, soudées sur mesure. Robert Daniel.";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Gouttières en zinc',
  serviceType: 'Pose et remplacement de gouttières en zinc',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  isRelatedTo: { '@id': 'https://robert-daniel-couverture.fr/zinguerie/#service' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url,
  image: 'https://robert-daniel-couverture.fr/images/zinguerie-gouttiere-zinc-anthracite-essonne.jpg',
  description,
}];

const types = [
  { titre: 'Zinc naturel', texte: "Gris clair à la pose, il se patine avec le temps et prend la teinte mate des toitures anciennes." },
  { titre: 'Zinc prépatiné', texte: "Gris ardoise ou anthracite dès la pose, il s'accorde aux couvertures sombres et aux maisons récentes." },
  { titre: 'Gouttière demi-ronde', texte: "Le profil le plus courant, posé sur crochets en bas de pente : simple, efficace et facile à entretenir." },
  { titre: 'Gouttière moulurée', texte: "Fixée contre la façade, elle forme une corniche décorative très présente sur les maisons de caractère." },
];
---
<PageService
  title={title}
  description={description}
  extraSchemas={extraSchemas}
  ariane={[{ label: 'Accueil', href: '/' }, { label: 'Zinguerie', href: '/zinguerie/' }, { label: 'Gouttières en zinc' }]}
  h1="Gouttières zinc 91 –"
  hero={{ src: '/images/zinguerie-gouttiere-zinc-anthracite-essonne.webp', alt: "Gouttière en zinc anthracite posée sur une maison de l'Essonne", width: 1100, height: 825 }}
  lead="La <strong>pose de gouttières en zinc dans l'Essonne</strong>, façonnées et soudées sur mesure par un couvreur zingueur."
  coches={['Zinc naturel ou prépatiné', "Naissances et raccords soudés à l'étain", 'Devis gratuit et sans engagement']}
  bande={['Gouttières demi-rondes', 'Gouttières moulurées', 'Crochets et naissances', 'Remplacement']}
  artisan={{
    titre: 'Le zinc, un savoir-faire de couvreur zingueur',
    html: `<p>Depuis plus de 15 ans, je travaille le zinc sur les toitures de l'Essonne. Je découpe, je plie et je soude chaque élément pour qu'il s'adapte exactement à votre maison : angles, naissances, talons et raccords aux descentes.</p>
<p>Je vous présente les profils et les teintes possibles, puis je vous remets un devis détaillé, au mètre linéaire, avec les accessoires nécessaires.</p>`,
  }}
  avis={{ titre: 'Ils ont fait poser leurs gouttières', ids: ['eric-jabaud', 'willi-gutierrez', 'loic-bouzon'] }}
  cta={{ titre: "Faites poser vos gouttières en zinc dans l'Essonne" }}
>

  <!-- ══ LE ZINC ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-duo dr-duo--seul" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/gouttiere-zinc-essonne.webp" alt="Gouttière en zinc demi-ronde posée en bas de pente d'une toiture en tuiles" width="900" height="1200" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h2 class="dr-h2">Le zinc, la gouttière qui dure</h2>
          <p>Le zinc reste la référence pour une gouttière : il résiste au gel, aux UV et aux chocs, et garde sa forme pendant plusieurs décennies. Avec le temps, il se couvre d'une patine qui le protège lui-même de la corrosion.</p>
          <p>Façonné sur mesure, il s'adapte à toutes les toitures, des pavillons aux maisons anciennes, et s'accorde aussi bien à la tuile qu'à l'ardoise. C'est aussi un matériau recyclable, réutilisé en fin de vie.</p>
          <p>Les gouttières font partie de la <a href="/zinguerie/">zinguerie de votre toiture</a> : je les pose en neuf, en remplacement d'anciennes gouttières percées ou lors d'une réfection de couverture.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ SUR MESURE (carte bleu nuit) ══ -->
  <section class="dr-section dr-section--serre">
    <div class="conteneur">
      <article class="dr-regle" data-anim="up">
        <div class="dr-regle__corps">
          <h2>Une gouttière façonnée sur mesure</h2>
          <p>Une gouttière efficace demande une pente régulière vers les descentes, des crochets solidement fixés à intervalles réguliers et des raccords parfaitement étanches. Je soude les naissances, les angles et les talons à l'étain, sans mastic qui vieillit.</p>
          <p>Sur les grandes longueurs, je prévois des joints de dilatation : le zinc s'allonge à la chaleur, et une gouttière bloquée finit par se fendre. Ce sont ces détails qui font la différence entre une gouttière qui dure et une gouttière qui fuit au bout de quelques hivers.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Demander mon devis
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
        <div class="dr-regle__certif">
          <h3>Ce que je pose</h3>
          <ul class="dr-coches dr-coches--sombre">
            <li>Gouttières demi-rondes ou moulurées</li>
            <li>Crochets adaptés à votre toiture</li>
            <li>Naissances, angles et talons soudés</li>
            <li>Raccordement aux descentes</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ PROFILS ET TEINTES ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Profils et teintes de zinc</h2>
        <p>Je vous aide à choisir le profil et la teinte qui conviennent à votre maison.</p>
      </div>
      <ul class="dr-equip">
        {types.map((t) => (
          <li class="dr-equip__carte" data-anim="up">
            <h3>{t.titre}</h3>
            <p>{t.texte}</p>
          </li>
        ))}
      </ul>
      <div class="dr-texte dr-apres" data-anim="up">
        <p>Pour un ensemble homogène, je pose en même temps des <a href="/zinguerie/descentes-eaux-pluviales/">descentes d'eaux pluviales en zinc</a>, raccordées aux gouttières par des naissances soudées. Une gouttière en zinc demande ensuite peu d'entretien : un nettoyage une à deux fois par an suffit à la garder dégagée.</p>
      </div>
    </div>
  </section>

  <ZinguerieLiees slugs={['gouttieres-aluminium', 'gouttieres-pvc', 'descentes-eaux-pluviales']} titre="Les autres gouttières et descentes" />
</PageService>
