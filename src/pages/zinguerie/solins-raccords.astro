---
// Sous-page du cocon zinguerie — rédigée oct. 2026 (gabarit PageService).
import PageService from '../../components/PageService.astro';
import ZinguerieLiees from '../../components/ZinguerieLiees.astro';

const url = 'https://robert-daniel-couverture.fr/zinguerie/solins-raccords/';
const title = "Solins de cheminée et raccords (91) – Robert Daniel";
const description = "Réfection de solins de cheminée et de raccords de toiture contre les murs dans l'Essonne (91) : abergements en zinc, bandes à rabat. Robert Daniel.";

const extraSchemas = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Solins et raccords de toiture',
  serviceType: 'Réfection de solins de cheminée et de raccords contre les murs',
  provider: { '@id': 'https://robert-daniel-couverture.fr/#localbusiness' },
  isRelatedTo: { '@id': 'https://robert-daniel-couverture.fr/zinguerie/#service' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
  url,
  image: 'https://robert-daniel-couverture.fr/images/cheminee-solin-essonne.jpg',
  description,
}];

const ouvrages = [
  { titre: 'Solin de cheminée', texte: "Abergement en zinc tout autour de la souche, avec une bande engravée dans la maçonnerie qui recouvre le raccord." },
  { titre: 'Raccord contre un mur', texte: "Là où la toiture s'appuie sur un mur plus haut, une bande de zinc relevée et protégée par une bande à rabat assure l'étanchéité." },
  { titre: 'Souche de cheminée', texte: "Joints refaits, enduit repris et chapeau posé : une souche saine protège le conduit et le solin qui l'entoure." },
];
---
<PageService
  title={title}
  description={description}
  extraSchemas={extraSchemas}
  ariane={[{ label: 'Accueil', href: '/' }, { label: 'Zinguerie', href: '/zinguerie/' }, { label: 'Solins et raccords' }]}
  h1="Solins et raccords 91 –"
  hero={{ src: '/images/cheminee-solin-essonne.webp', alt: "Solin en zinc autour d'une souche de cheminée sur une toiture en tuiles", width: 825, height: 1100, position: 'center 40%' }}
  lead="La <strong>réfection des solins de cheminée dans l'Essonne</strong> et des raccords contre les murs, là où naissent beaucoup d'infiltrations."
  coches={['Solins en zinc façonnés', 'Raccords contre les murs', 'Devis gratuit et sans engagement']}
  bande={['Solins de cheminée', 'Abergements', 'Raccords contre mur', 'Souches']}
  artisan={{
    titre: 'Un couvreur zingueur pour vos solins',
    html: `<p>Depuis plus de 15 ans, je refais les solins des toitures de l'Essonne. Un solin réussi, c'est du zinc plié au millimètre autour de la souche et un raccord à la maçonnerie qui ne laisse aucun passage à l'eau.</p>
<p>Je vous explique d'où vient l'infiltration, ce que je propose de reprendre et pourquoi, avant de vous remettre un devis détaillé.</p>`,
  }}
  avis={{ titre: 'Les avis de mes clients', ids: ['didier-nara', 'emilie-ventura', 'delphine-lejeune'] }}
  cta={{ titre: "Faites refaire le solin de votre cheminée" }}
>

  <!-- ══ POINT SENSIBLE ══ -->
  <section class="dr-section">
    <div class="conteneur">
      <div class="dr-duo dr-duo--seul" data-anim="up">
        <figure class="dr-duo__media">
          <img src="/images/solin-souche-cheminee-essonne.webp" alt="Souche de cheminée et son raccord à la couverture en tuiles" width="900" height="1200" loading="lazy" decoding="async" />
        </figure>
        <div class="dr-duo__texte">
          <h2 class="dr-h2">Le solin, un point sensible de la toiture</h2>
          <p>Le solin assure l'étanchéité entre la couverture et tout ce qui la traverse ou la borde : une souche de cheminée, un mur mitoyen, une lucarne. Les tuiles ne peuvent pas venir au contact de la maçonnerie : c'est le solin qui fait la jonction.</p>
          <p>Quand il se fissure ou se décolle, l'eau coule le long du conduit ou du mur et réapparaît à l'intérieur, souvent loin de son point d'entrée : auréoles au plafond, papier peint qui se décolle, odeur d'humidité près de la cheminée.</p>
          <p>Les solins font partie de la <a href="/zinguerie/">zinguerie</a> que je réalise sur mesure, au même titre que les noues et les gouttières.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ ZINC PLUTÔT QUE MORTIER (carte bleu nuit) ══ -->
  <section class="dr-section dr-section--serre">
    <div class="conteneur">
      <article class="dr-regle" data-anim="up">
        <div class="dr-regle__corps">
          <h2>Un solin en zinc plutôt qu'au mortier</h2>
          <p>Beaucoup de solins anciens sont de simples bourrelets de mortier. Avec le gel et les mouvements de la toiture, ils se fissurent en quelques hivers. Je les remplace par un abergement en zinc, façonné autour de la souche et glissé sous les tuiles.</p>
          <p>En partie haute, une bande de zinc engravée dans la maçonnerie, ou une bande à rabat fixée au mur, recouvre le raccord. L'eau ruisselle sur le zinc et rejoint la couverture sans jamais atteindre la charpente.</p>
          <a href="/devis-gratuit/" class="dr-btn dr-btn--rouge">
            Demander mon devis
            <span class="dr-btn__fleche" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </div>
        <div class="dr-regle__certif">
          <h3>Les signes d'un solin fatigué</h3>
          <ul class="dr-coches dr-coches--sombre">
            <li>Mortier fissuré ou décollé</li>
            <li>Traces d'humidité le long du conduit</li>
            <li>Auréoles au plafond près de la cheminée</li>
            <li>Mousse au pied de la souche</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ OUVRAGES ══ -->
  <section class="dr-section dr-section--gris">
    <div class="conteneur">
      <div class="dr-entete" data-anim="up">
        <h2 class="dr-h2">Les solins et raccords que je réalise</h2>
        <p>Chaque raccord est façonné à la main, à la forme exacte de votre toiture.</p>
      </div>
      <ul class="dr-equip">
        {ouvrages.map((o) => (
          <li class="dr-equip__carte" data-anim="up">
            <h3>{o.titre}</h3>
            <p>{o.texte}</p>
          </li>
        ))}
      </ul>
      <div class="dr-texte dr-apres" data-anim="up">
        <p>Couvreur et ramoneur, je contrôle la souche et le solin à chaque <a href="/ramonage-cheminee/">ramonage de cheminée</a>. Vous traitez le conduit et son raccord à la toiture avec le même artisan, dans la même intervention.</p>
      </div>
    </div>
  </section>

  <ZinguerieLiees slugs={['noues-aretiers', 'couvertines', 'gouttieres-zinc']} />
</PageService>
